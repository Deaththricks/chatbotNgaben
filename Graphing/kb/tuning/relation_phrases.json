  "DISERTAI_KEMBALINYA_UNSUR_BADAN_KE": { "template": "{s} disertai kembalinya unsur badan manusia ke asalnya, yaitu {o}", "ok_prep": [] },
  "MERUPAKAN_TAHAP_MENCAPAI": { "template": "{s} merupakan salah satu tahap untuk mencapai {o}", "ok_prep": [] },
  "MENUNJUKKAN_JALAN_ATMA_KE": { "template": "{s} melambangkan penunjuk jalan bagi roh (atman) untuk kembali ke asalnya, yaitu {o}", "ok_prep": [] },

  "_comment_tirta_pangentas": "2026-10-12: 'hanya dapat dibuat oleh seorang Sulinggih' (corpus L3713) and 'tanpa Tirtha Pangentas maka Pengabenan itu dianggap belum dilaksanakan' (L3987) were text in tirta pangentas's definition only, so 'kalau di desa cuma ada pemangku dan gak ada sulinggih, ngabennya tetep bisa jalan gak?' never reached them. The templates keep 'hanya' and 'dianggap belum dilaksanakan', which a bare DIBUAT_OLEH / MENSYARATKAN would lose.",
  "HANYA_DAPAT_DIBUAT_OLEH": { "template": "{s} hanya dapat dibuat oleh {o}", "ok_prep": ["oleh"] },
  "DIANGGAP_BELUM_DILAKSANAKAN_TANPA": { "template": "{s} dianggap belum dilaksanakan tanpa {o}", "ok_prep": ["tanpa"] },

  "_comment_swadharma": "2026-10-19 (NLU sweep): corpus L650 'Melakukan Pitra Yadnya adalah swadharma alias kewajiban', L653 'swadharma atau kewajiban yang mutlak, karena sudah merupakan utang', L680 'keturunannya lah yang wajib membantu membakar (membayari hutang) stula sarira orang tuanya' were text in swadharma's and manusia's definitions only; 'apakah ngaben wajib' got 'Ya' argued from tirta pangentas.",
  "_comment_swadharma_wording": "'adalah', not 'merupakan': the templates join a term's short facts that share their first word, and 'merupakan salah satu tahap untuk mencapai moksa dan kewajiban (swadharma)' read as a stage toward duty; an 'adalah' sentence stands alone.",
  "MERUPAKAN_KEWAJIBAN": { "template": "{s} adalah kewajiban suci ({o})", "ok_prep": [] },
  "_comment_bangbang_rare": "2026-10-19: bangbang rare was DIGUNAKAN_DALAM upacara ngelungah, so 'bahan upacara ngelungah apa saja' listed the burial place as a material; the glossary calls it 'tempat pemakaman khusus untuk bayi/anak pada Upacara Ngelungah'.",
  "MENJADI_TEMPAT_PEMAKAMAN_PADA": { "template": "{s} menjadi tempat pemakaman khusus bayi pada {o}", "ok_prep": [] },

