   "source": [
    "# ==========================================\n",
    "# 13. RELATION EXTRACTION\n",
    "# ==========================================\n",
    "# get_token_by_id / find_entity_tokens / get_entity_head now\n",
    "# live earlier in the notebook (section 12.1), shared with\n",
    "# coreference resolution. Everything below reuses them as-is.\n",
    "\n",
    "# ==========================================\n",
    "# 13.1. GET ENTITIES\n",
    "# ==========================================\n",
    "\n",
    "def get_sentence_entities(\n",
    "    sentence_id,\n",
    "    df_ner\n",
    "):\n",
    "\n",
    "    entities = df_ner[\n",
    "        df_ner[\"sentence_id\"] == sentence_id\n",
    "    ]\n",
    "\n",
    "    entities = entities.to_dict(\"records\")\n",
    "\n",
    "    # ----------------------------------\n",
    "    # DEDUP: entity yang sama (text + label)\n",
    "    # yang muncul lebih dari sekali di\n",
    "    # kalimat yang sama akan menghasilkan\n",
    "    # relation yang sama persis berkali-kali,\n",
    "    # karena get_entity_head() selalu\n",
    "    # menemukan kemunculan PERTAMA saja\n",
    "    # (tidak bisa membedakan kemunculan\n",
    "    # ke-2, ke-3, dst). Jadi memproses\n",
    "    # entity yang sama lebih dari sekali\n",
    "    # tidak menambah informasi baru --\n",
    "    # cukup diproses satu kali saja.\n",
    "    # ----------------------------------\n",
    "\n",
    "    seen = set()\n",
    "    deduped = []\n",
    "\n",
    "    for entity in entities:\n",
    "\n",
    "        key = (\n",
    "            entity[\"entity\"].lower(),\n",
    "            entity[\"label\"]\n",
    "        )\n",
    "\n",
    "        if key in seen:\n",
    "            continue\n",
    "\n",
    "        seen.add(key)\n",
    "        deduped.append(entity)\n",
    "\n",
    "    return deduped\n",
    "\n",
    "# ==========================================\n",
    "# 13.3b. NEGATION CHECK (FIX #2)\n",
    "# ==========================================\n",
    "\n",
    "NEGATION_LEMMAS = {\"tidak\", \"bukan\", \"belum\", \"tanpa\", \"tak\", \"jangan\"}\n",
    "\n",
    "\n",
    "def is_negated(relation_token, tokens):\n",
    "    \"\"\"\n",
    "    Cek apakah relation_token (predikat/verb, ATAU noun apapun\n",
    "    yang di-passing di sini -- lihat FIX #8c) punya child dengan\n",
    "    deprel \"advmod\" yang lemma-nya adalah kata negasi (tidak,\n",
    "    bukan, belum, dst).\n",
    "\n",
    "    Tanpa cek ini, kalimat seperti \"tidak jauh berbeda\n",
    "    dengan X\" akan menghasilkan relation \"berbeda dengan\n",
    "    X\" -- padahal kalimatnya justru bilang TIDAK berbeda.\n",
    "    Relation-nya jadi kebalikan dari makna aslinya.\n",
    "\n",
    "    FIX #8c: callers now also call this on the SUBJECT head, not\n",
    "    just the predicate. Indonesian cleft negation (\"bukan X yang\n",
    "    V...\", \"it is not X that V's...\") attaches \"bukan\" as an\n",
    "    advmod of the SUBJECT noun X, not of the verb V -- e.g.\n",
    "    \"sebab bukan upakara yang besar dan megah yang menjamin\n",
    "    manusia ... mendapatkan sorga\" has \"bukan\" attached directly\n",
    "    to \"upakara\", several clause-levels away from the governing\n",
    "    verb the old single check inspected. That produced a\n",
    "    relation with the exact opposite meaning of the sentence\n",
    "    (\"upakara -> memiliki -> sorga\"). This function itself didn't\n",
    "    need to change -- it already just checks \"does THIS token\n",
    "    have a negated advmod child\" -- callers just needed to ask\n",
    "    the question about both tokens.\n",
    "    \"\"\"\n",
    "\n",
    "    for child in tokens:\n",
    "\n",
    "        if child[\"head\"] == relation_token[\"id\"] and child[\"deprel\"] == \"advmod\":\n",
    "\n",
    "            if child[\"lemma\"] in NEGATION_LEMMAS:\n",
    "                return True\n",
    "\n",
    "    return False\n",
    "\n",
    "\n",
    "# AUDIT S1: negation that sits on the OBJECT, not the predicate or subject.\n",
    "# \"tanpa jenazah\", \"dengan tanpa tulang\", \"bukan dari X\" -- is_negated() never\n",
    "# looks here, so these produced triples asserting the OPPOSITE of the sentence.\n",
    "# Per this section's \"zero relations rather than a wrong one\" stance, a triple\n",
    "# whose object is negated is dropped by the callers.\n",
    "OBJECT_NEGATION_LEMMAS = {\n",
    "    \"tidak\", \"tak\", \"bukan\", \"tanpa\", \"non\", \"tan\", \"nora\", \"nenten\",\n",
    "    \"belum\", \"jangan\", \"nir\",\n",
    "}\n",
    "\n",
    "\n",
    "def _object_is_negated(object_token, tokens):\n",
    "    if object_token is None:\n",
    "        return False\n",
    "    oid = object_token[\"id\"]\n",
    "    case_ids = {\n",
    "        c[\"id\"] for c in tokens\n",
    "        if c[\"head\"] == oid and c[\"deprel\"] == \"case\"\n",
    "    }\n",
    "    for child in tokens:\n",
    "        if child[\"lemma\"].lower() not in OBJECT_NEGATION_LEMMAS:\n",
    "            continue\n",
    "        if child[\"head\"] == oid and child[\"deprel\"] in (\n",
    "            \"advmod\", \"det\", \"case\", \"mark\", \"amod\", \"dep\", \"cc\", \"nmod\",\n",
    "        ):\n",
    "            return True\n",
    "        if child[\"head\"] in case_ids:\n",
    "            return True\n",
    "    return False\n",
    "\n",
    "# ==========================================\n",
    "# 13.3c. SURFACE-TEXT-AWARE RELATION LABELING\n",
    "# (2026 revision pass, per user-reviewed\n",
    "# root-cause report)\n",
    "# ==========================================\n",
    "# RELATION_TAXONOMY (13.10) buckets a verb by its LEMMA -- but\n",
    "# several lemmas here are shared by Indonesian words with\n",
    "# genuinely unrelated meanings (Stanza strips prefixes down to\n",
    "# one root, so two different words collide on one lemma), and a\n",
    "# single fixed bucket per lemma silently mislabels whichever\n",
    "# sense didn't happen to be the one the bucket was built for.\n",
    "# Same technique as FIX #8d (\"berada\" vs bare \"ada\"): check the\n",
    "# actual SURFACE TEXT -- and, where the sense depends on it, the\n",
    "# found object's case marker -- before falling back to the raw\n",
    "# lemma. The value returned here is the PRE-taxonomy label, still\n",
    "# run through RELATION_TAXONOMY.get() afterwards in 13.10 exactly\n",
    "# like any other lemma.\n",
    "\n",
    "LOCATIVE_CASE_MARKERS = {\"di\", \"pada\", \"ke\"}\n",
    "\n",
    "SEQUENCE_CASE_MARKERS = {\n",
    "    \"sebelum\": \"sebelum\",\n",
    "    \"sesudah\": \"setelah\",\n",
    "    \"setelah\": \"setelah\",\n",
    "    \"selain\": \"selain\",\n",
    "}\n",
    "\n",
    "MENINGGAL_SURFACE_FORMS = {\"meninggal\"}\n",
    "TUJU_PURPOSE_SURFACE_FORMS = {\"bertujuan\"}\n",
    "TUJU_DEDICATION_SURFACE_FORMS = {\"tertuju\", \"dituju\", \"ditujukan\", \"diperuntukkan\"}\n",
    "DIRI_COMPOSITION_SURFACE_FORMS = {\"terdiri\"}\n",
    "BUAT_COMPOSITION_SURFACE_FORMS = {\"terbuat\", \"dibuat\"}\n",
    "BUAT_COMPOSITION_CASE_MARKERS = {\"dari\"}\n",
    "GUNA_ACTIVE_SURFACE_FORMS = {\"menggunakan\", \"mempergunakan\", \"gunakan\", \"menggunakannya\"}\n",
    "GUNA_PASSIVE_SURFACE_FORMS = {\"digunakan\", \"dipergunakan\"}\n",
    "TERIMA_ACTIVE_SURFACE_FORMS = {\"menerima\"}\n",
    "IRING_PASSIVE_SURFACE_FORMS = {\"diiring\", \"diiringi\"}\n",
    "\n",
    "# ==========================================\n",
    "# 13.3d. GRAMMATICAL VOICE + MARKER-FIRST\n",
    "#        PREDICATE DERIVATION (2026 rewrite)\n",
    "# ==========================================\n",
    "# The predicate used to come almost entirely from the verb LEMMA,\n",
    "# ignoring (a) the preposition on the object and (b) grammatical\n",
    "# voice -- so ~half the triples read backwards / as nonsense, and\n",
    "# ~140 rows carried a bare uppercased root (\"HANYUT\", \"PEROLEH\").\n",
    "# New priority: object case marker -> coarse relation family;\n",
    "# verb lemma -> refine; voice -> keep the sentence's own\n",
    "# active/passive direction; floor -> the verb's own voiced surface\n",
    "# form (a real word), never a bare root.\n",
    "\n",
    "SYMBOL_NOUNS       = {\"simbol\", \"lambang\", \"perlambang\", \"pralambang\", \"prelambang\",\n",
    "                      \"tanda\", \"pertanda\", \"manifestasi\", \"perwujudan\", \"cerminan\",\n",
    "                      \"cihna\", \"representasi\", \"gambaran\"}\n",
    "ROLE_MARKERS       = {\"sebagai\", \"selaku\"}\n",
    "GOAL_MARKERS       = {\"ke\"}\n",
    "INSTRUMENT_MARKERS = {\"dengan\"}\n",
    "RECIPIENT_MARKERS  = {\"kepada\", \"bagi\"}\n",
    "PURPOSE_MARKERS    = {\"untuk\"}\n",
    "NOUN_LOC_MARKERS   = {\"di\", \"pada\", \"ring\", \"ri\"}\n",
    "BASIS_MARKERS      = {\"menurut\", \"berdasar\", \"berdasarkan\", \"sesuai\"}\n",
    "TEMPORAL_MARKERS_EXTRA = {\"menjelang\"}\n",
    "\n",
    "OFFERING_LEMMAS    = {\"hatur\", \"saji\", \"atur\", \"persila\", \"percik\", \"sirat\", \"ayab\",\n",
    "                      \"suguh\", \"aturang\", \"kajeng\", \"sembah\", \"puja\"}\n",
    "PLACEMENT_LEMMAS   = {\"letak\", \"taruh\", \"baring\", \"tempat\", \"pasang\", \"gantung\", \"tanam\",\n",
    "                      \"durus\", \"deret\", \"sila\", \"tetel\", \"tindih\", \"ketengah\", \"hadap\",\n",
    "                      \"susun\", \"atur\"}\n",
    "STATIVE_LOC_LEMMAS = {\"ada\", \"tinggal\", \"berada\", \"duduk\", \"keliling\", \"naik\", \"masuk\",\n",
    "                      \"diri\", \"munggah\", \"semayam\", \"tahta\"}\n",
    "MOTION_LEMMAS      = {\"bawa\", \"angkut\", \"usung\", \"gotong\", \"arak\", \"junjung\", \"boyong\",\n",
    "                      \"antar\", \"iring\", \"pindah\", \"bopong\", \"pikul\", \"hantar\"}\n",
    "WRAP_LEMMAS        = {\"bungkus\", \"rurub\", \"tutup\", \"kurung\", \"selimut\", \"kafan\"}\n",
    "BIND_LEMMAS        = {\"ikat\", \"belit\", \"pintal\", \"simpul\", \"tali\"}\n",
    "ROLL_LEMMAS        = {\"gulung\", \"lipat\"}\n",
    "DOUSE_LEMMAS       = {\"siram\", \"basuh\", \"mandi\", \"sembur\", \"perci\", \"guyur\"}\n",
    "CLOTHING_LEMMAS    = {\"kena\", \"kenakan\", \"pakai\", \"pakaikan\", \"busana\", \"wastra\", \"rias\"}\n",
    "TAKE_LEMMAS        = {\"ambil\", \"cabut\", \"buka\", \"kerik\", \"kupas\", \"kelupas\", \"lepas\",\n",
    "                      \"tanggal\", \"keluas\"}\n",
    "CLASSIFY_LEMMAS    = {\"klasifikasi\", \"golong\", \"kategori\", \"masuk\", \"termasuk\", \"kelompok\"}\n",
    "NAMING_LEMMAS      = {\"kenal\", \"sebut\", \"nama\", \"anggap\", \"julukan\", \"juluk\"}\n",
    "PRODUCE_LEMMAS     = {\"hasil\", \"cipta\", \"timbul\", \"lahir\", \"bangkit\", \"produksi\",\n",
    "                      \"wujudkan\", \"munculkan\"}\n",
    "REMOVE_LEMMAS      = {\"hilang\", \"hapus\", \"buang\", \"singkir\", \"lenyap\"}\n",
    "GET_LEMMAS         = {\"peroleh\", \"dapat\", \"terima\", \"raih\"}\n",
    "POSSESS_LEMMAS     = {\"milik\", \"punya\", \"nilai\", \"kandung\", \"isi\", \"muat\", \"ada\"}\n",
    "DESTROY_LEMMAS     = {\"hancur\", \"lebur\", \"bongkar\", \"musnah\", \"runtuh\", \"basmi\"}\n",
    "MOHON_LEMMAS       = {\"mohon\", \"nunas\", \"nuwur\", \"minta\", \"pinta\"}\n",
    "\n",
    "\n",
    "def _role_marker(object_token, tokens):\n",
    "    \"\"\"'sebagai' / 'selaku' governing the object -- Stanza tags it 'case'\n",
    "    sometimes and 'mark' other times.\"\"\"\n",
    "    if object_token is None:\n",
    "        return None\n",
    "    for child in tokens:\n",
    "        if child[\"head\"] == object_token[\"id\"] and child[\"deprel\"] in (\"case\", \"mark\") \\\n",
    "           and (child[\"lemma\"].lower() in ROLE_MARKERS or child[\"text\"].lower() in ROLE_MARKERS):\n",
    "            return child[\"text\"].lower()\n",
    "    return None\n",
    "\n",
    "\n",
    "_TOTALITY_QUANTIFIER_LEMMAS = {\"semua\", \"segala\", \"setiap\", \"seluruh\"}\n",
    "\n",
    "\n",
    "def _find_verb_subject(verb_token, tokens):\n",
    "    \"\"\"verb_token's own nsubj/nsubj:pass child if it has one; otherwise (a\n",
    "    subject-less advcl sharing the matrix clause's subject, e.g. \"semua\n",
    "    sekah ... termasuk sangge\" where 'termasuk' hangs as an advcl off the\n",
    "    real root verb) fall back to its head's nsubj/nsubj:pass. AUDIT S3237,\n",
    "    Iteration 3.\"\"\"\n",
    "    own = next(\n",
    "        (t for t in tokens if t[\"head\"] == verb_token[\"id\"]\n",
    "         and t[\"deprel\"] in (\"nsubj\", \"nsubj:pass\")),\n",
    "        None,\n",
    "    )\n",
    "    if own is not None:\n",
    "        return own\n",
    "    head_id = verb_token.get(\"head\")\n",
    "    if head_id in (None, 0):\n",
    "        return None\n",
    "    return next(\n",
    "        (t for t in tokens if t[\"head\"] == head_id\n",
    "         and t[\"deprel\"] in (\"nsubj\", \"nsubj:pass\")),\n",
    "        None,\n",
    "    )\n",
    "\n",
    "\n",
    "def _subject_has_totality_quantifier(verb_token, tokens):\n",
    "    \"\"\"AUDIT S3237 (Iteration 3): does verb_token's subject (or a det/\n",
    "    advmod/nummod child of it) carry a totality quantifier (semua/segala/\n",
    "    setiap/seluruh)? Distinguishes the membership sense of 'termasuk'\n",
    "    (\"semua sekah termasuk sangge\") from its plain containment sense\n",
    "    (\"lekesan termasuk tembakau\"), which the earlier unconditional swap\n",
    "    reversed.\"\"\"\n",
    "    subj = _find_verb_subject(verb_token, tokens)\n",
    "    if subj is None:\n",
    "        return False\n",
    "    if subj[\"lemma\"].lower() in _TOTALITY_QUANTIFIER_LEMMAS:\n",
    "        return True\n",
    "    return any(\n",
    "        child[\"head\"] == subj[\"id\"]\n",
    "        and child[\"deprel\"] in (\"det\", \"advmod\", \"nummod\")\n",
    "        and child[\"lemma\"].lower() in _TOTALITY_QUANTIFIER_LEMMAS\n",
    "        for child in tokens\n",
    "    )\n",
    "\n",
    "\n",
    "def verb_voice(verb_token):\n",
    "    \"\"\"'active' (meN-/ber-), 'passive' (di-/ter-), or 'bare' (root / imperative /\n",
    "    Balinese). Surface only -- the lemma has the voicing prefix stripped\n",
    "    ('menggunakan' and 'digunakan' both lemmatise to 'guna').\"\"\"\n",
    "    s = verb_token[\"text\"].lower().split(\"-\")[0]\n",
    "    if s.endswith(\"lah\"):\n",
    "        s = s[:-3]\n",
    "    if s.startswith(\"di\") and len(s) >= 5:\n",
    "        return \"passive\"\n",
    "    if s.startswith(\"ter\") and len(s) >= 6:\n",
    "        return \"passive\"\n",
    "    if s.startswith(\"ber\") and len(s) >= 5:\n",
    "        return \"active\"\n",
    "    if s[:4] in (\"meng\", \"meny\") or s[:3] in (\"mem\", \"men\") or (s.startswith(\"me\") and len(s) >= 5):\n",
    "        return \"active\"\n",
    "    return \"bare\"\n",
    "\n",
    "\n",
    "def voiced_surface_label(verb_token):\n",
    "    \"\"\"Readable fallback: the verb's own voiced surface form, UPPER. Never a\n",
    "    bare root -- if no voicing prefix survived, the verb carries no relation\n",
    "    sense on its own -> LAINNYA.\"\"\"\n",
    "    s = re.sub(r\"[^a-z]\", \"\", verb_token[\"text\"].lower().split(\"-\")[0].split(\"/\")[0])\n",
    "    if s.endswith(\"lah\"):\n",
    "        s = s[:-3]\n",
    "    if len(s) < 4 or s == verb_token[\"lemma\"].lower():\n",
    "        return \"LAINNYA\"\n",
    "    if not (s[:2] in (\"di\", \"me\") or s[:3] in (\"ber\", \"ter\")):\n",
    "        return \"LAINNYA\"\n",
    "    return s.upper()\n",
    "\n",
    "\n",
    "def _passive_action_label(lemma, obj_upos, surface=\"\", benefactive=False):\n",
    "    # AUDIT D7 (Iteration 3, Stage 6): \"dibuat\" (plain passive, \"X is made\")\n",
    "    # and \"dibuatkan\" (benefactive passive, \"X is made FOR someone\") share\n",
    "    # lemma \"buat\" and were both routed to DIHASILKAN/MENGHASILKAN, wrongly\n",
    "    # implying the deceased/recipient PRODUCES the thing made for them\n",
    "    # (S2612 \"pitra mendiang MENGHASILKAN perlambang\", S2986[1] \"dibuat...\n",
    "    # bagi-nya\"). The subject itself is already correct in both cases -- this\n",
    "    # is a label bug, not a subject/object swap bug, so it needs none of the\n",
    "    # subject_label plumbing previously deferred for the broader D7/N3 class.\n",
    "    if lemma == \"buat\":\n",
    "        return \"DIBUATKAN_UNTUK\" if (surface.endswith(\"kan\") or benefactive) else \"DIHASILKAN\"\n",
    "    if lemma == \"beri\":                        return \"DIBERI\"\n",
    "    if lemma in OFFERING_LEMMAS:               return \"DIPERSEMBAHKAN_KEPADA\"\n",
    "    if lemma in MOHON_LEMMAS:                  return \"DIMOHON\"\n",
    "    if lemma in TAKE_LEMMAS:                   return \"DIAMBIL\"\n",
    "    if lemma in WRAP_LEMMAS:                   return \"DIBUNGKUS\"\n",
    "    if lemma in BIND_LEMMAS:                   return \"DIIKAT\"\n",
    "    if lemma in ROLL_LEMMAS:                   return \"DIGULUNG\"\n",
    "    if lemma in (\"kubur\", \"tanam\"):            return \"DIKUBUR\"\n",
    "    if lemma in (\"bakar\", \"aben\"):             return \"DIBAKAR\"\n",
    "    if lemma in DOUSE_LEMMAS:                  return \"DIMANDIKAN\"\n",
    "    if lemma in (\"tabur\", \"ura\", \"sebar\"):     return \"DITABURKAN\"\n",
    "    if lemma in MOTION_LEMMAS:                 return \"DIUSUNG\"\n",
    "    if lemma in DESTROY_LEMMAS:                return \"DIBONGKAR\"\n",
    "    if lemma in CLOTHING_LEMMAS:               return \"DIPAKAIKAN\"\n",
    "    if lemma in PRODUCE_LEMMAS:                return \"DIHASILKAN\"\n",
    "    if lemma in POSSESS_LEMMAS:                return \"MEMILIKI\"\n",
    "    if lemma in GET_LEMMAS:                    return \"DIPEROLEH\"\n",
    "    return None\n",
    "\n",
    "\n",
    "def derive_raw_relation_label(relation_token, object_token, tokens, object_flags=frozenset()):\n",
    "    \"\"\"Thin wrapper (AUDIT /121, Iteration 3): a sequence/temporal case\n",
    "    marker (sebelum/sesudah/setelah/selain/menjelang) used to REPLACE the\n",
    "    whole predicate outright, discarding the verb's real action -- \"sekah\n",
    "    kangsen dibongkar SETELAH pamralina\" shipped as bare SETELAH, losing\n",
    "    \"dibongkar\" (S1747/S2028/S2166/S2642). None of these markers overlap\n",
    "    any other case-marker set checked in the core cascade below, so it's\n",
    "    safe to compute the base predicate as if the marker were absent, then\n",
    "    suffix it -- \"DIBONGKAR_SETELAH\", not bare \"SETELAH\". Sentinel labels\n",
    "    (leading underscore, e.g. \"_SWAP_JENIS_DARI\") pass through untouched.\"\"\"\n",
    "    case = get_case_marker(object_token, tokens) if object_token is not None else None\n",
    "    _seq_suffix = None\n",
    "    if case in SEQUENCE_CASE_MARKERS:\n",
    "        _seq_suffix = SEQUENCE_CASE_MARKERS[case].upper()\n",
    "    elif case in TEMPORAL_MARKERS_EXTRA:\n",
    "        _seq_suffix = \"MENJELANG\"\n",
    "    _base = _derive_raw_relation_label_core(relation_token, object_token, tokens, object_flags)\n",
    "    if _seq_suffix is None or not _base or _base.startswith(\"_\"):\n",
    "        return _base\n",
    "    if _base == \"LAINNYA\":\n",
    "        return _seq_suffix\n",
    "    return f\"{_base}_{_seq_suffix}\"\n",
    "\n",
    "\n",
    "def _derive_raw_relation_label_core(relation_token, object_token, tokens, object_flags=frozenset()):\n",
    "    \"\"\"Marker-first, voice-aware. Returns a FINAL natural UPPER_SNAKE predicate.\n",
    "    Preserves every earlier lemma-collision fix (meninggal/tinggal, tuju 3-way,\n",
    "    terdiri/berdiri, terbuat/membuat, ada locative/possessive, terima\n",
    "    active/passive, iring). Called only from the thin `derive_raw_relation_label`\n",
    "    wrapper above, which now owns the sequence/temporal-marker suffix logic\n",
    "    (AUDIT /121, Iteration 3) -- step 2 below no longer returns early on it.\"\"\"\n",
    "\n",
    "    lemma    = relation_token[\"lemma\"].lower()\n",
    "    surface  = relation_token[\"text\"].lower()\n",
    "    voice    = verb_voice(relation_token)\n",
    "    case     = get_case_marker(object_token, tokens) if object_token is not None else None\n",
    "    obj_lem  = object_token[\"lemma\"].lower() if object_token is not None else \"\"\n",
    "    obj_upos = object_token[\"upos\"] if object_token is not None else \"\"\n",
    "    role     = _role_marker(object_token, tokens)\n",
    "\n",
    "    # 1. similative retarget (FIX #25)\n",
    "    if \"similative_object\" in object_flags:\n",
    "        return \"DIPERLAKUKAN_SEPERTI\"\n",
    "\n",
    "    # 2. (sequence/temporal marker handling now lives in the wrapper above --\n",
    "    # `case` here naturally never matches any other marker set checked in\n",
    "    # steps 5-12 when it's sebelum/sesudah/setelah/selain/menjelang, so\n",
    "    # falling through is safe and reaches the same base-predicate steps\n",
    "    # 14/15/16 would otherwise have produced.)\n",
    "\n",
    "    # 3. FIX #15 -- meninggal (die); lemma is 'tinggal'\n",
    "    if surface in MENINGGAL_SURFACE_FORMS:\n",
    "        return \"MENINGGAL\"\n",
    "\n",
    "    # 3b. Stanza tags the connectors 'selaku' / 'sebagai' / 'menjelang' as VERBs\n",
    "    if lemma in (\"selaku\",) or surface in (\"selaku\", \"sebagai\"):\n",
    "        if obj_lem in SYMBOL_NOUNS:\n",
    "            return \"MELAMBANGKAN\"\n",
    "        if lemma in NAMING_LEMMAS:\n",
    "            return \"DIKENAL_SEBAGAI\"\n",
    "        return \"BERPERAN_SEBAGAI\"\n",
    "    if lemma == \"menjelang\" or surface == \"menjelang\":\n",
    "        return \"MENJELANG\"\n",
    "\n",
    "    # 4. FIX #8d\n",
    "    if surface == \"berada\":\n",
    "        return \"BERADA_DI\"\n",
    "\n",
    "    # AUDIT S2: passive containment / elevation verbs are NOT \"MENUJU\".\n",
    "    # \"dimasukkan ke (dalam) X\" ends up IN X; \"dinaikkan ke X\" ends up ON X.\n",
    "    if voice == \"passive\":\n",
    "        if lemma == \"masuk\":\n",
    "            return \"DIMASUKKAN_KE_DALAM\"\n",
    "        if lemma in (\"naik\", \"unggah\"):\n",
    "            return \"DINAIKKAN_KE\"\n",
    "\n",
    "    # AUDIT S8: holy-water-onto-a-target verbs are one relation -- the water is\n",
    "    # applied to a body / effigy / place; it is not an offering TO the corpse\n",
    "    # and it is not \"brought to\".\n",
    "    if lemma in (\"sirat\", \"percik\", \"perci\", \"sembur\", \"ciprat\"):\n",
    "        return \"DIPERCIKKAN_PADA\"\n",
    "\n",
    "    # AUDIT S15: \"berisi / diisi (dengan) X\" = contains X, never MEMILIKI.\n",
    "    # AUDIT D8 (Iteration 2): but only when X is genuinely the contents --\n",
    "    # \"di hulu hati, diisi sebuah kawangen\" (S3747/S3749/S3753) has the\n",
    "    # body part as a LOCATIVE oblique (WHERE the kawangen is placed), not\n",
    "    # what it's filled with; that shape routes to DILETAKKAN_DI instead.\n",
    "    # The kawangen's own contents (\"yang berisi 9 biji uang kepeng...\")\n",
    "    # are picked up separately as a BERISI relation via the new\n",
    "    # find_subject_clause_relations() branch below.\n",
    "    if lemma == \"isi\" or surface.startswith(\"berisi\") or surface.startswith(\"diisi\"):\n",
    "        if case in NOUN_LOC_MARKERS:\n",
    "            return \"DILETAKKAN_DI\"\n",
    "        return \"DIISI_DENGAN\" if voice == \"passive\" else \"BERISI\"\n",
    "\n",
    "    # AUDIT N6/S11 (Iteration 1, narrowed AUDIT S3237/Iteration 3): \"X\n",
    "    # termasuk Y\" means Y is a MEMBER/kind of X only when X carries an\n",
    "    # explicit totality quantifier (\"semua sekah termasuk sangge\" -> sangge\n",
    "    # is a kind of sekah) -- the opposite direction from the other\n",
    "    # CLASSIFY_LEMMAS (\"golong\"/\"kategori\"/\"kelompok\"), whose subject->object\n",
    "    # direction already reads correctly. Without a quantifier, \"termasuk\" is\n",
    "    # in its plain containment sense instead (\"lekesan termasuk tembakau\" =\n",
    "    # lekesan CONTAINS tobacco, not \"tobacco is a kind of lekesan\") -- the\n",
    "    # earlier unconditional swap reversed this (S3237). Sentinel (when it\n",
    "    # fires) tells _emit_relations_for_verb() to swap subject/object when\n",
    "    # building the relation record.\n",
    "    if lemma == \"termasuk\":\n",
    "        if _subject_has_totality_quantifier(relation_token, tokens):\n",
    "            return \"_SWAP_JENIS_DARI\"\n",
    "        return \"BERISI\"\n",
    "\n",
    "    # AUDIT D7 (Iteration 2, was N3): \"sulinggih ... DIHATURKAN santapan\n",
    "    # istimewa\" backwards implies the priest is being offered up -- the\n",
    "    # recipient (\"sulinggih...\") got promoted to subject by the -kan\n",
    "    # benefactive/applicative voice, while the bare (case-marker-free)\n",
    "    # object is the actual THEME being given. Scoped to a curated\n",
    "    # two-lemma set (hatur/suguh) whose surface always carries this\n",
    "    # sense in this corpus; sentinel mirrors _SWAP_JENIS_DARI above.\n",
    "    if (\n",
    "        voice == \"passive\"\n",
    "        and case is None\n",
    "        and lemma in (\"hatur\", \"suguh\")\n",
    "        and surface.endswith((\"kan\", \"i\"))\n",
    "    ):\n",
    "        return \"_SWAP_DIPERSEMBAHKAN_KEPADA\"\n",
    "\n",
    "    # 5. according-to / basis\n",
    "    if case in BASIS_MARKERS:\n",
    "        return \"MENURUT\" if case == \"menurut\" else \"BERDASARKAN\"\n",
    "\n",
    "    # 6. role / symbol marker -- never an action bucket\n",
    "    if case in ROLE_MARKERS or role:\n",
    "        if lemma in CLASSIFY_LEMMAS:\n",
    "            return \"BAGIAN_DARI\"\n",
    "        if lemma in NAMING_LEMMAS:\n",
    "            return \"DIKENAL_SEBAGAI\"\n",
    "        if obj_lem in SYMBOL_NOUNS:\n",
    "            return \"MELAMBANGKAN\"\n",
    "        if lemma in (\"fungsi\", \"guna\", \"pakai\"):\n",
    "            return \"BERFUNGSI_SEBAGAI\"\n",
    "        return \"BERPERAN_SEBAGAI\"\n",
    "\n",
    "    # 7. source marker 'dari'\n",
    "    if case == \"dari\":\n",
    "        if surface in BUAT_COMPOSITION_SURFACE_FORMS:       # FIX #18\n",
    "            return \"TERBUAT_DARI\"\n",
    "        if surface in DIRI_COMPOSITION_SURFACE_FORMS or lemma == \"diri\":   # FIX #17\n",
    "            return \"TERDIRI_DARI\"\n",
    "        if lemma in MOHON_LEMMAS:\n",
    "            return \"DIMOHON_DARI\"\n",
    "        if lemma in GET_LEMMAS:                             # FIX #20\n",
    "            return \"DIPEROLEH_DARI\"\n",
    "        return \"BERASAL_DARI\"\n",
    "\n",
    "    # 8. goal marker 'ke' / verb 'menuju'\n",
    "    if case in GOAL_MARKERS or surface.startswith(\"menuju\"):\n",
    "        if lemma in (\"hanyut\", \"larung\", \"anyut\", \"labuh\"):\n",
    "            return \"DIHANYUTKAN_KE\"\n",
    "        if lemma in MOTION_LEMMAS:\n",
    "            return \"DIBAWA_KE\"\n",
    "        if surface.startswith(\"menuju\") or lemma in (\"naik\", \"masuk\", \"turun\",\n",
    "                                                     \"tiba\", \"datang\", \"sampai\", \"tuju\"):\n",
    "            return \"MENUJU\"\n",
    "        return \"DIBAWA_KE\" if voice == \"passive\" else \"MENUJU\"\n",
    "\n",
    "    # 9. instrument / material marker 'dengan'\n",
    "    if case in INSTRUMENT_MARKERS:\n",
    "        if surface in BUAT_COMPOSITION_SURFACE_FORMS: return \"TERBUAT_DARI\"\n",
    "        if lemma in BIND_LEMMAS:   return \"DIIKAT_DENGAN\"\n",
    "        if lemma in WRAP_LEMMAS:   return \"DIBUNGKUS_DENGAN\"\n",
    "        if lemma in ROLL_LEMMAS:   return \"DIGULUNG_DENGAN\"\n",
    "        if lemma in DOUSE_LEMMAS:  return \"DISIRAM_DENGAN\"\n",
    "        if lemma == \"alas\":        return \"DIALASI_DENGAN\"\n",
    "        if lemma == \"ganti\":       return \"DIGANTI_DENGAN\"\n",
    "        if lemma == \"sambung\":     return \"DISAMBUNG_DENGAN\"\n",
    "        if lemma == \"akhir\":       return \"DIAKHIRI_DENGAN\"\n",
    "        if lemma in (\"iring\", \"arak\"):             return \"DISERTAI\"\n",
    "        if lemma in (\"guna\", \"pakai\"):             return \"MENGGUNAKAN\"\n",
    "        if lemma in (\"dukung\", \"landas\", \"dasar\"): return \"BERDASARKAN\"\n",
    "        vs = voiced_surface_label(relation_token)\n",
    "        return f\"{vs}_DENGAN\" if vs not in (\"LAINNYA\",) else \"DILAKUKAN_DENGAN\"\n",
    "\n",
    "    # 10. recipient marker 'kepada' / 'bagi'\n",
    "    if case in RECIPIENT_MARKERS:\n",
    "        if lemma in OFFERING_LEMMAS:\n",
    "            return \"DIPERSEMBAHKAN_KEPADA\"\n",
    "        if lemma == \"tuju\" or surface in TUJU_DEDICATION_SURFACE_FORMS:\n",
    "            return \"DITUJUKAN_UNTUK\"\n",
    "        if lemma in MOHON_LEMMAS:\n",
    "            return \"DIMOHON_DARI\"\n",
    "        return \"DITUJUKAN_UNTUK\"\n",
    "\n",
    "    # 11. purpose marker 'untuk'\n",
    "    if case in PURPOSE_MARKERS:\n",
    "        if obj_upos == \"VERB\" or surface in TUJU_PURPOSE_SURFACE_FORMS:   # FIX #16\n",
    "            return \"BERTUJUAN_UNTUK\"\n",
    "        if lemma == \"tuju\" or surface in TUJU_DEDICATION_SURFACE_FORMS:\n",
    "            return \"DITUJUKAN_UNTUK\"\n",
    "        if lemma in (\"guna\", \"pakai\", \"fungsi\"):\n",
    "            return \"DIPAKAI_UNTUK\"\n",
    "        return \"DITUJUKAN_UNTUK\"\n",
    "\n",
    "    # 12. locative noun marker 'di' / 'pada' / 'ring'\n",
    "    if case in NOUN_LOC_MARKERS:\n",
    "        if lemma in PLACEMENT_LEMMAS:\n",
    "            return \"DILETAKKAN_DI\"\n",
    "        if lemma == \"buat\":\n",
    "            return \"DIBUAT_DI\"\n",
    "        if lemma in (\"guna\", \"pakai\"):\n",
    "            return \"DIPAKAI_UNTUK\"\n",
    "        if lemma in (\"laksana\", \"langsung\", \"selenggara\", \"gelar\", \"adakan\"):\n",
    "            return \"DILAKUKAN_DI\"\n",
    "        if lemma in (\"puja\", \"astawa\", \"sembahyang\", \"sembah\"):\n",
    "            return \"DIPUJA\"\n",
    "        if lemma == \"mandi\":\n",
    "            return \"DIMANDIKAN\"\n",
    "        if lemma in (\"bakar\", \"aben\", \"basmi\"):\n",
    "            return \"DIBAKAR\"\n",
    "        if lemma in STATIVE_LOC_LEMMAS:                     # FIX #19 (ada + locative)\n",
    "            return \"BERADA_DI\"\n",
    "        if voice == \"passive\":\n",
    "            vs = voiced_surface_label(relation_token)\n",
    "            if vs != \"LAINNYA\":\n",
    "                return vs if vs.endswith(\"_DI\") else f\"{vs}_DI\"\n",
    "        return \"DILAKUKAN_DI\"\n",
    "\n",
    "    # ---- no case marker below ----\n",
    "\n",
    "    # 13. temporal adjunct object\n",
    "    if \"temporal_adjunct_object\" in object_flags:\n",
    "        return \"DILAKUKAN_SAAT\"\n",
    "\n",
    "    # 14. active voice, no marker -> subject is the agent\n",
    "    if voice == \"active\":\n",
    "        if lemma == \"guna\" or surface in GUNA_ACTIVE_SURFACE_FORMS:\n",
    "            return \"MENGGUNAKAN\"\n",
    "        if lemma in CLOTHING_LEMMAS:\n",
    "            return \"MEMAKAI\"\n",
    "        if lemma in REMOVE_LEMMAS:\n",
    "            return \"MENGHILANGKAN\"\n",
    "        if lemma in PRODUCE_LEMMAS or lemma == \"buat\":      # FIX #18 (membuat)\n",
    "            return \"MENGHASILKAN\"\n",
    "        if lemma in POSSESS_LEMMAS:                         # FIX #19 (bare ada)\n",
    "            return \"MEMILIKI\"\n",
    "        if lemma in GET_LEMMAS or surface in TERIMA_ACTIVE_SURFACE_FORMS:  # FIX #20\n",
    "            return \"MEMPEROLEH\"\n",
    "        if lemma in (\"tentu\", \"tuntun\"):\n",
    "            return \"MENENTUKAN\"\n",
    "        if lemma in NAMING_LEMMAS:\n",
    "            return \"DIKENAL_SEBAGAI\"\n",
    "        if lemma in CLASSIFY_LEMMAS and lemma != \"masuk\":\n",
    "            return \"BAGIAN_DARI\"\n",
    "        # AUDIT (Iteration 3): \"wujud\" is berwujud's lemma (\"takes the\n",
    "        # physical form of\") -- distinct from melambangkan (\"symbolizes\").\n",
    "        # These were being conflated (S1688, S2180); dropped from this set\n",
    "        # so berwujud falls through to voiced_surface_label() below, which\n",
    "        # already renders it correctly as BERWUJUD.\n",
    "        if lemma in (\"wakil\", \"lambang\", \"representasi\", \"serupa\", \"cermin\"):\n",
    "            return \"MELAMBANGKAN\"\n",
    "        if lemma == \"ikut\":\n",
    "            return \"DISERTAI\"\n",
    "        return voiced_surface_label(relation_token)\n",
    "\n",
    "    # 15. passive voice, no marker -> subject is the patient\n",
    "    if voice == \"passive\":\n",
    "        if lemma == \"tempuh\" and obj_upos in (\"NOUN\", \"PROPN\"):   # audit: \"ditempuh keluarga\"\n",
    "            return \"DILAKUKAN_OLEH\"\n",
    "        if surface in IRING_PASSIVE_SURFACE_FORMS:                # FIX #21\n",
    "            return \"DISERTAI\"\n",
    "        if lemma == \"diri\":\n",
    "            return \"TERDIRI_DARI\"\n",
    "        if lemma in NAMING_LEMMAS:\n",
    "            return \"DIKENAL_SEBAGAI\"\n",
    "        if lemma in CLASSIFY_LEMMAS and lemma != \"masuk\":\n",
    "            return \"BAGIAN_DARI\"\n",
    "        if lemma in (\"guna\", \"pakai\"):\n",
    "            return \"DIPAKAI_UNTUK\"\n",
    "        # AUDIT D7 (Iteration 3, Stage 6): \"dibuat ... BAGI-nya\" (S2986[1]) is\n",
    "        # the same benefactive-passive shape as \"dibuatKAN\" but the signal is\n",
    "        # a \"bagi\"-marked oblique CHILD of the verb, not a verb suffix.\n",
    "        _benefactive = any(\n",
    "            c[\"head\"] == relation_token[\"id\"] and c[\"deprel\"] == \"obl\"\n",
    "            and get_case_marker(c, tokens) == \"bagi\"\n",
    "            for c in tokens\n",
    "        )\n",
    "        lab = _passive_action_label(lemma, obj_upos, surface=surface, benefactive=_benefactive)\n",
    "        if lab:\n",
    "            return lab\n",
    "        return voiced_surface_label(relation_token)\n",
    "\n",
    "    # 16. bare voice (imperative / Balinese)\n",
    "    lab = _passive_action_label(lemma, obj_upos, surface=surface)\n",
    "    if lab:\n",
    "        return lab\n",
    "    if lemma in CLOTHING_LEMMAS:\n",
    "        return \"MEMAKAI\"\n",
    "\n",
    "    # 17. floor\n",
    "    return voiced_surface_label(relation_token)\n",
    "\n",
    "\n",
    "def _OLD_derive_raw_relation_label(relation_token, object_token, tokens):\n",
    "    \"\"\"\n",
    "    Report Section 2/3/7. See the constants above for the specific\n",
    "    lemma collisions this resolves:\n",
    "      - meninggal (die) vs tinggal (reside) -- HIGH PRIORITY, a\n",
    "        death silently became a location without this check\n",
    "        (Stanza lemmatizes \"meninggal\" down to \"tinggal\", the same\n",
    "        lemma the taxonomy maps to \"berada di\").\n",
    "      - ada (bare) -- locative (\"ada pada X\") vs possessive (\"ada\n",
    "        X\") sense, disambiguated by the found object's case marker.\n",
    "      - tuju -- menuju (locative) / bertujuan (purpose) / tertuju\n",
    "        or dituju (dedication) are three unrelated senses.\n",
    "      - diri -- terdiri dari (composition) vs berdiri (locative).\n",
    "      - buat -- terbuat/dibuat DARI (composed of, passive) vs\n",
    "        membuat (produces, active) are opposite directions.\n",
    "      - guna -- menggunakan/digunakan (to use) vs berguna (to\n",
    "        function as).\n",
    "      - terima -- active \"menerima\" vs the taxonomy's fixed\n",
    "        passive value \"diterima oleh\", which reverses the\n",
    "        sentence's own voice when the verb is actually active.\n",
    "      - iring -- passive \"diiring(i)\" vs the taxonomy's active-\n",
    "        sounding fixed value \"mengikuti\".\n",
    "      - a sequence/comparison case marker (sebelum/sesudah/\n",
    "        setelah/selain) on the object overrides the verb-lemma\n",
    "        label entirely -- the case marker alone already tells you\n",
    "        this is a \"happens before/after\" fact, regardless of what\n",
    "        the governing verb usually means (Section 7, S979).\n",
    "    \"\"\"\n",
    "\n",
    "    lemma = relation_token[\"lemma\"].lower()\n",
    "    surface = relation_token[\"text\"].lower()\n",
    "\n",
    "    case_marker = (\n",
    "        get_case_marker(object_token, tokens)\n",
    "        if object_token is not None\n",
    "        else None\n",
    "    )\n",
    "\n",
    "    if case_marker in SEQUENCE_CASE_MARKERS:\n",
    "        return SEQUENCE_CASE_MARKERS[case_marker]\n",
    "\n",
    "    if surface in MENINGGAL_SURFACE_FORMS:\n",
    "        return \"meninggal\"\n",
    "\n",
    "    if surface == \"berada\":\n",
    "        # FIX #8d (existing).\n",
    "        return \"berada\"\n",
    "\n",
    "    if lemma == \"ada\":\n",
    "        if case_marker in LOCATIVE_CASE_MARKERS:\n",
    "            return \"ada_lokatif\"\n",
    "        return lemma\n",
    "\n",
    "    if lemma == \"tuju\":\n",
    "        if surface in TUJU_PURPOSE_SURFACE_FORMS:\n",
    "            return \"bertujuan\"\n",
    "        if surface in TUJU_DEDICATION_SURFACE_FORMS:\n",
    "            return \"tertuju\"\n",
    "        return lemma\n",
    "\n",
    "    if lemma == \"diri\":\n",
    "        if surface in DIRI_COMPOSITION_SURFACE_FORMS:\n",
    "            return \"terdiri\"\n",
    "        return lemma\n",
    "\n",
    "    if lemma == \"buat\":\n",
    "        if (\n",
    "            surface in BUAT_COMPOSITION_SURFACE_FORMS\n",
    "            and case_marker in BUAT_COMPOSITION_CASE_MARKERS\n",
    "        ):\n",
    "            return \"dibuat_dari\"\n",
    "        return lemma\n",
    "\n",
    "    if lemma == \"guna\":\n",
    "        if surface in GUNA_USE_SURFACE_FORMS:\n",
    "            return \"digunakan\"\n",
    "        return lemma\n",
    "\n",
    "    if lemma == \"terima\":\n",
    "        if surface in TERIMA_ACTIVE_SURFACE_FORMS:\n",
    "            return \"menerima\"\n",
    "        return lemma\n",
    "\n",
    "    if lemma == \"iring\":\n",
    "        if surface in IRING_PASSIVE_SURFACE_FORMS:\n",
    "            return \"diiringi\"\n",
    "        return lemma\n",
    "\n",
    "    return lemma\n",
    "\n",
    "# ==========================================\n",
    "# 13.4. SUBJECT - VERB RELATION (FIXED)\n",
    "# ==========================================\n",
    "\n",
    "AGENT_CASE_MARKERS = {\"oleh\"}\n",
    "\n",
    "\n",
    "def get_case_marker(token, tokens):\n",
    "    \"\"\"\n",
    "    Cari kata depan (ADP) yang jadi 'case' marker dari token\n",
    "    ini, misal \"oleh\" pada \"oleh raja-raja\", atau \"dengan\"\n",
    "    pada \"dengan kemampuan\". Dipakai untuk cek apakah sebuah\n",
    "    obl sebenarnya AGENT kalimat pasif (oleh X), bukan\n",
    "    pelengkap objek biasa.\n",
    "    \"\"\"\n",
    "\n",
    "    for child in tokens:\n",
    "\n",
    "        if child[\"head\"] == token[\"id\"] and child[\"deprel\"] == \"case\":\n",
    "            return child[\"lemma\"].lower()\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "FUNCTION_WORD_HEADS = {\"itu\", \"ini\", \"yang\"}\n",
    "# AUDIT D13 (Iteration 2): \"kala\" (\"di kala X\" = \"at the time X\") is a\n",
    "# synonym of saat/waktu/ketika that was missing here -- see\n",
    "# find_coordinated_verb_relations()'s temporal-oblique guard below.\n",
    "TEMPORAL_ADJUNCT_LEMMAS = {\"saat\", \"waktu\", \"ketika\", \"kala\"}\n",
    "\n",
    "\n",
    "NON_CONTENT_DEPRELS = {\"punct\", \"advmod:emph\", \"case\", \"mark\", \"cc\", \"discourse\"}\n",
    "\n",
    "\n",
    "def _has_any_child(token, tokens):\n",
    "    return any(\n",
    "        child[\"head\"] == token[\"id\"] and child[\"deprel\"] not in NON_CONTENT_DEPRELS\n",
    "        for child in tokens\n",
    "    )\n",
    "\n",
    "\n",
    "# FIX #9a: checked by SURFACE TEXT, not lemma. The original FIX #8f\n",
    "# (see extract_definition_relations() below) tried to filter this\n",
    "# cataphoric filler by lemma (\"berikut\" -> checking for lemma\n",
    "# \"berikut\"), but Stanza actually lemmatizes \"berikut\" down to\n",
    "# \"ikut\" (stripping the \"ber-\" prefix) -- so that check could never\n",
    "# match anything, in either extractor. Worse, ALL THREE real\n",
    "# instances of this bug in the corpus (\"...menyebutkan sebagai\n",
    "# berikut:\", \"...sebagai berikut:\") turned out to reach\n",
    "# find_object_tokens()'s obl-candidate path below (ordinary verb\n",
    "# sentences), not extract_definition_relations()'s Case-A scan at\n",
    "# all -- so the original fix was patching a path this particular\n",
    "# bug never even used. Both problems are fixed here: check surface\n",
    "# text (unambiguous, unlike the shared lemma \"ikut\"), and filter it\n",
    "# in the one path that actually needs it.\n",
    "CATAPHORIC_FILLER_SURFACE_FORMS = {\"berikut\"}\n",
    "\n",
    "# FIX #9b: a small set of Indonesian nouns function as pure\n",
    "# discourse connectives when fronted with a case marker and\n",
    "# nothing but a generic modifier attached -- \"dengan kata lain\"\n",
    "# (\"in other words\"), \"dalam hal ini\" (\"in this matter\"), \"dengan\n",
    "# demikian\" (\"thus\") -- rather than as real content. Example:\n",
    "# \"dengan kata lain, sawa harus secepatnya dihancurkan...\" --\n",
    "# \"kata\" (case marker \"dengan\", amod child \"lain\") is the ONLY obl\n",
    "# child of \"dihancurkan\", so FIX #8b's postposed-vs-preposed\n",
    "# preference can't help (there's nothing postposed to prefer): it\n",
    "# falls back to the one candidate there is, which is this\n",
    "# connective, not real content. Unlike FUNCTION_WORD_HEADS (a bare\n",
    "# head with literally NO children), these idioms always carry one\n",
    "# generic modifier -- so _has_any_child() alone doesn't catch them.\n",
    "# Only treat it as a bare connective if EVERY child is one of these\n",
    "# generic fillers; a real descriptive modifier would still let the\n",
    "# candidate through as genuine content.\n",
    "DISCOURSE_CONNECTIVE_LEMMAS = {\"kata\", \"hal\", \"demikian\"}\n",
    "DISCOURSE_CONNECTIVE_MODIFIERS = {\"lain\", \"ini\", \"itu\", \"tersebut\"}\n",
    "\n",
    "\n",
    "def _is_bare_discourse_connective(candidate, tokens):\n",
    "\n",
    "    # AUDIT D10 (Iteration 2): \"sebagaimana halnya pangabenan\" (S2542) --\n",
    "    # \"hal\" governed by a similative marker is a comparison introducer no\n",
    "    # matter what content its own compound child carries.\n",
    "    if (\n",
    "        candidate[\"lemma\"].lower() == \"hal\"\n",
    "        and get_case_marker(candidate, tokens) in SIMILATIVE_CASE_MARKERS\n",
    "    ):\n",
    "        return True\n",
    "\n",
    "    if candidate[\"lemma\"].lower() not in DISCOURSE_CONNECTIVE_LEMMAS:\n",
    "        return False\n",
    "\n",
    "    children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == candidate[\"id\"]\n",
    "        and child[\"deprel\"] not in NON_CONTENT_DEPRELS\n",
    "    ]\n",
    "\n",
    "    if not children:\n",
    "        return True\n",
    "\n",
    "    return all(\n",
    "        child[\"lemma\"].lower() in DISCOURSE_CONNECTIVE_MODIFIERS\n",
    "        for child in children\n",
    "    )\n",
    "\n",
    "\n",
    "# FIX #14 (report Section 6g): Stanza mis-attaches the sentence-\n",
    "# initial parenthetical \"artinya,\" (\"that is to say,\") as an\n",
    "# oblique complement of the main verb instead of as a discourse\n",
    "# adverbial -- e.g. \"artinya, tirtha ini pantang menginap...\" ends\n",
    "# up with \"arti\" as the obl of \"pantang\". Narrow signature (first\n",
    "# token of the sentence, only child is the possessive \"nya\") so it\n",
    "# doesn't catch \"arti\" used with real content elsewhere (e.g.\n",
    "# \"memiliki arti tersendiri\", where \"arti\" is a direct obj, not an\n",
    "# obl, and isn't the sentence's first token).\n",
    "def _is_artinya_parenthetical(candidate, tokens):\n",
    "\n",
    "    if candidate[\"lemma\"].lower() != \"arti\":\n",
    "        return False\n",
    "\n",
    "    if candidate[\"id\"] != 1:\n",
    "        return False\n",
    "\n",
    "    children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == candidate[\"id\"]\n",
    "        and child[\"deprel\"] not in NON_CONTENT_DEPRELS\n",
    "    ]\n",
    "\n",
    "    return (\n",
    "        len(children) == 1\n",
    "        and children[0][\"deprel\"] == \"nmod:poss\"\n",
    "    )\n",
    "\n",
    "\n",
    "# FIX #12 (report instance sentence 1087): Stanza sometimes attaches\n",
    "# a bare spatial relator noun (\"atas\"/\"bawah\"/etc, from \"di atas X\")\n",
    "# as its own obl directly on the verb -- a SEPARATE sibling from \"X\"\n",
    "# itself (also attached directly to the verb as its own obl),\n",
    "# instead of chaining \"X\" as an nmod under the relator the way \"di\n",
    "# atas X\" normally parses. When that happens the bare relator (no\n",
    "# content of its own) sorts before the real content by token id and\n",
    "# would otherwise win -- e.g. \"dibaringkan ... di atas balai-balai\n",
    "# rumah adat\" losing its real object to the empty \"atas\" fragment.\n",
    "# Skip a spatial relator candidate that carries no content of its\n",
    "# own; the real content is the other obl sibling.\n",
    "SPATIAL_RELATOR_LEMMAS = {\n",
    "    \"atas\", \"bawah\", \"dalam\", \"luar\", \"depan\", \"belakang\",\n",
    "    \"tengah\", \"samping\",\n",
    "}\n",
    "\n",
    "\n",
    "def _is_bare_spatial_relator(candidate, tokens):\n",
    "    return (\n",
    "        candidate[\"lemma\"].lower() in SPATIAL_RELATOR_LEMMAS\n",
    "        and not _has_any_child(candidate, tokens)\n",
    "    )\n",
    "\n",
    "\n",
    "# FIX #13 (report instance sentence 1031): \"begitu rupa\" (\"in such\n",
    "# a way/manner\") is a fixed manner idiom, not a real complement --\n",
    "# e.g. \"sawa dibaringkan begitu rupa\" (\"the corpse was laid out\n",
    "# just so\"). Unlike a genuine obl it carries no case marker at all\n",
    "# (no di/ke/dengan/etc child) and its only child is the intensifier\n",
    "# \"begitu\". Narrow, lemma+structure-specific check so it doesn't\n",
    "# catch \"rupa\" used with real content elsewhere.\n",
    "def _is_manner_idiom_filler(candidate, tokens):\n",
    "\n",
    "    if candidate[\"lemma\"].lower() != \"rupa\":\n",
    "        return False\n",
    "\n",
    "    if get_case_marker(candidate, tokens) is not None:\n",
    "        return False\n",
    "\n",
    "    children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == candidate[\"id\"]\n",
    "        and child[\"deprel\"] not in NON_CONTENT_DEPRELS\n",
    "    ]\n",
    "\n",
    "    return (\n",
    "        len(children) == 1\n",
    "        and children[0][\"lemma\"].lower() == \"begitu\"\n",
    "    )\n",
    "\n",
    "\n",
    "def _strip_temporal_head(candidate, tokens):\n",
    "    \"\"\"\n",
    "    If this obl candidate is headed by a temporal noun (saat/\n",
    "    waktu/ketika) -- i.e. it expresses WHEN something happens,\n",
    "    not who/what it's really directed at -- the bare temporal\n",
    "    noun alone is empty (\"PROHIBITS saat\"). If it has its own\n",
    "    compound/nmod content (e.g. \"saat palebon\" -> \"palebon\"),\n",
    "    use just that residual as the (flagged, lower-confidence)\n",
    "    object instead of the temporal noun. If there's no residual,\n",
    "    signal that so the caller can try the next candidate.\n",
    "    \"\"\"\n",
    "\n",
    "    if candidate[\"lemma\"].lower() not in TEMPORAL_ADJUNCT_LEMMAS:\n",
    "        return candidate, False\n",
    "\n",
    "    residual_children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == candidate[\"id\"]\n",
    "        and child[\"deprel\"] in (\"compound\", \"nmod\", \"flat\", \"flat:name\", \"amod\")\n",
    "    ]\n",
    "\n",
    "    if not residual_children:\n",
    "        return None, True\n",
    "\n",
    "    return sorted(residual_children, key=lambda x: x[\"id\"])[0], True\n",
    "\n",
    "\n",
    "SIMILATIVE_CASE_MARKERS = {\"sebagaimana\", \"seperti\", \"bagai\", \"laksana\", \"bak\", \"ibarat\"}\n",
    "\n",
    "\n",
    "def _strip_similative_head(candidate, tokens):\n",
    "    \"\"\"\n",
    "    FIX #25: \"diupacarai sebagaimana layaknya sawa utuh\" -- Stanza makes\n",
    "    \"layak\" an obl of the verb (case \"sebagaimana\") and the real noun\n",
    "    (\"sawa utuh\") its compound child. \"layak(nya)\" is a simile pivot, not\n",
    "    the complement: \"X is treated AS IF it were Y\". Retarget to Y as a\n",
    "    flagged, lower-confidence object; if there is no noun child, signal\n",
    "    skip (nothing real to point at).\n",
    "    \"\"\"\n",
    "    if candidate[\"lemma\"].lower() != \"layak\":\n",
    "        return candidate, False\n",
    "    if get_case_marker(candidate, tokens) not in SIMILATIVE_CASE_MARKERS:\n",
    "        return candidate, False\n",
    "    noun_children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == candidate[\"id\"]\n",
    "        and child[\"deprel\"] in (\"compound\", \"nmod\", \"flat\", \"flat:name\")\n",
    "    ]\n",
    "    if not noun_children:\n",
    "        return None, True\n",
    "    return sorted(noun_children, key=lambda x: x[\"id\"])[0], True\n",
    "\n",
    "\n",
    "# FIX #11 (report Section 6f): a \"pada saat X\" obl sometimes\n",
    "# introduces a full subordinate clause elsewhere in the sentence\n",
    "# (an advcl child of the SAME governing verb) rather than being a\n",
    "# plain noun phrase -- e.g. \"sesajen dihaturkan pada saat abu\n",
    "# jenazah dihanyutkan ke samudera\" (\"the offering is presented AT\n",
    "# THE TIME [when] the ashes are floated to the sea\"): \"dihanyutkan\"\n",
    "# is an advcl child of the root \"dihaturkan\", the SAME verb the\n",
    "# temporal obl \"saat\" attaches to. Salvaging \"abu jenazah\" (saat's\n",
    "# residual compound children) as if it were dihaturkan's own object\n",
    "# misleadingly reads as \"the offering is presented TO the ash-\n",
    "# corpse\". When the governing verb has its own advcl child like\n",
    "# this, the temporal obl is clause-framing, not a plain NP -- don't\n",
    "# salvage a fragment from it at all (consistent with this project's\n",
    "# existing \"zero relations rather than a wrong one\" stance, FIX\n",
    "# #9c).\n",
    "def _temporal_residual_is_clause_framing(relation_token, tokens):\n",
    "    return any(\n",
    "        child[\"head\"] == relation_token[\"id\"] and child[\"deprel\"] == \"advcl\"\n",
    "        for child in tokens\n",
    "    )\n",
    "\n",
    "\n",
    "def find_object_tokens(relation_token, tokens):\n",
    "    \"\"\"\n",
    "    Cari SEMUA object dari sebuah verb/predikat -- returns a LIST\n",
    "    of (token, flags) tuples (zero, one, or more candidates), not a\n",
    "    single winner. See FIX #10 below for why more than one can come\n",
    "    back.\n",
    "\n",
    "    Prioritas 1: deprel == \"obj\" langsung dari relation_token\n",
    "    (paling akurat, langsung dari parser).\n",
    "\n",
    "    Prioritas 2: child LANGSUNG dari relation_token yang deprel-nya\n",
    "    \"obl\" (pelengkap lain yang bukan direct object, misal\n",
    "    \"diletakkan di atas X\" atau \"diklasifikasikan sebagai X\").\n",
    "\n",
    "    FIX #2: hanya child yang HEAD-nya benar-benar relation_token\n",
    "    yang dipertimbangkan -- tidak bisa nyasar ke klausa lain lewat\n",
    "    \"dan\"/\"lalu\".\n",
    "\n",
    "    FIX #3: obl candidate dengan case marker \"oleh\" (agent kalimat\n",
    "    pasif) di-skip -- itu PELAKU, bukan objek.\n",
    "\n",
    "    FIX #4: bare function-word candidate (\"itu\"/\"ini\"/\"yang\" tanpa\n",
    "    child) di-skip, coba candidate berikutnya.\n",
    "\n",
    "    FIX #5 / #8a: obl yang kepala-nya ATAU case marker-nya sendiri\n",
    "    temporal (saat/waktu/ketika) bukan pelengkap sebenarnya --\n",
    "    lihat _strip_temporal_head() dan #8a di bawah.\n",
    "\n",
    "    FIX #8b: di antara candidate yang lolos filter, yang POSTPOSED\n",
    "    (setelah verb) diutamakan atas yang PREPOSED (sebelum verb,\n",
    "    biasanya topic/adjunct yang di-fronting, bukan pelengkap\n",
    "    sebenarnya).\n",
    "\n",
    "    FIX #9c: kalau ada obl postposed yang ADA secara mentah tapi\n",
    "    semuanya ke-filter habis sebagai non-content (bukan karena\n",
    "    memang tidak ada sama sekali), jangan fallback ke preposed --\n",
    "    return kosong, bukan decoy.\n",
    "\n",
    "    FIX #9a/#9b/#12/#13/#14: filter tambahan untuk cataphoric filler\n",
    "    (\"berikut\"), discourse connective (\"dengan kata lain\"), bare\n",
    "    spatial relator (\"atas\" kosong), manner idiom (\"begitu rupa\"),\n",
    "    dan parenthetical \"artinya,\".\n",
    "\n",
    "    FIX #10 (NEW, report Section 4a -- \"extract each sentence to\n",
    "    its fullest\"): previously this returned a single \"best\" object,\n",
    "    discarding every OTHER obl candidate on the same verb -- but\n",
    "    several sentences attach MULTIPLE independent complements\n",
    "    directly to the same verb (a location AND a manner AND a\n",
    "    purpose are all simultaneously true, not three guesses for one\n",
    "    slot -- e.g. \"dimandikan dengan air biasa di atas dusa di natar\n",
    "    rumah\" has three separate true facts). A verb's own direct\n",
    "    object (deprel \"obj\") and EVERY postposed obl candidate that\n",
    "    survives the filters below are now all returned, each becoming\n",
    "    its own relation in the caller. A PREPOSED (fronted) obl is\n",
    "    still only used as a single last-resort fallback when nothing\n",
    "    postposed survives at all -- fronted material in Indonesian is\n",
    "    usually topic/adjunct framing (FIX #8b's original finding), not\n",
    "    an independent fact on par with a postposed complement, so\n",
    "    multiple preposed candidates don't multiply into multiple\n",
    "    relations the way postposed ones do.\n",
    "    \"\"\"\n",
    "\n",
    "    results = []\n",
    "\n",
    "    # Prioritas 1: direct object. Returned as its own candidate\n",
    "    # (not an early return) so obl complements below can ALSO come\n",
    "    # through instead of being discarded outright.\n",
    "    direct_objects = [\n",
    "        token for token in tokens\n",
    "        if token[\"head\"] == relation_token[\"id\"]\n",
    "        and token[\"deprel\"] == \"obj\"\n",
    "    ]\n",
    "\n",
    "    if direct_objects:\n",
    "        direct_objects = sorted(direct_objects, key=lambda x: x[\"id\"])\n",
    "        results.append((direct_objects[0], set()))\n",
    "\n",
    "    # Prioritas 2: obl candidates.\n",
    "    obl_candidates = [\n",
    "        token for token in tokens\n",
    "        if token[\"head\"] == relation_token[\"id\"]\n",
    "        and token[\"deprel\"] == \"obl\"\n",
    "    ]\n",
    "\n",
    "    obl_candidates = sorted(\n",
    "        obl_candidates, key=lambda x: x[\"id\"]\n",
    "    )\n",
    "\n",
    "    raw_postposed_existed = any(\n",
    "        c[\"id\"] > relation_token[\"id\"] for c in obl_candidates\n",
    "    )\n",
    "\n",
    "    resolved_candidates = []\n",
    "\n",
    "    for candidate in obl_candidates:\n",
    "\n",
    "        case_marker = get_case_marker(candidate, tokens)\n",
    "\n",
    "        if case_marker in AGENT_CASE_MARKERS:\n",
    "            continue\n",
    "\n",
    "        if case_marker in TEMPORAL_ADJUNCT_LEMMAS:\n",
    "            # FIX #8a: case marker-nya sendiri temporal.\n",
    "            continue\n",
    "\n",
    "        if (\n",
    "            candidate[\"lemma\"].lower() in FUNCTION_WORD_HEADS\n",
    "            and not _has_any_child(candidate, tokens)\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "        if candidate[\"text\"].lower() in CATAPHORIC_FILLER_SURFACE_FORMS:\n",
    "            continue\n",
    "\n",
    "        if _is_bare_discourse_connective(candidate, tokens):\n",
    "            continue\n",
    "\n",
    "        if _is_artinya_parenthetical(candidate, tokens):\n",
    "            continue\n",
    "\n",
    "        if _is_bare_spatial_relator(candidate, tokens):\n",
    "            continue\n",
    "\n",
    "        if _is_manner_idiom_filler(candidate, tokens):\n",
    "            continue\n",
    "\n",
    "        candidate_flags = set()\n",
    "\n",
    "        # FIX #25: retarget a 'sebagaimana layaknya X' simile to X.\n",
    "        resolved, was_similative = _strip_similative_head(candidate, tokens)\n",
    "        if was_similative:\n",
    "            if resolved is None:\n",
    "                continue\n",
    "            candidate = resolved\n",
    "            candidate_flags.add(\"similative_object\")\n",
    "\n",
    "        resolved, was_temporal = _strip_temporal_head(candidate, tokens)\n",
    "\n",
    "        if was_temporal:\n",
    "            if resolved is None:\n",
    "                continue\n",
    "            if _temporal_residual_is_clause_framing(relation_token, tokens):\n",
    "                # FIX #11: the temporal obl is clause-framing, not a\n",
    "                # plain NP -- don't salvage a fragment from it.\n",
    "                continue\n",
    "            candidate_flags.add(\"temporal_adjunct_object\")\n",
    "\n",
    "        resolved_candidates.append((resolved, candidate_flags))\n",
    "\n",
    "    postposed = [\n",
    "        pair for pair in resolved_candidates\n",
    "        if pair[0][\"id\"] > relation_token[\"id\"]\n",
    "    ]\n",
    "\n",
    "    if postposed:\n",
    "        # FIX #10: return EVERY surviving postposed candidate, not\n",
    "        # just the first.\n",
    "        results.extend(postposed)\n",
    "        return results\n",
    "\n",
    "    if raw_postposed_existed:\n",
    "        # FIX #9c: a postposed slot existed but nothing survived\n",
    "        # filtering -- positively confirmed empty, don't fall back\n",
    "        # to a fronted decoy.\n",
    "        return results\n",
    "\n",
    "    if resolved_candidates:\n",
    "        # No postposed candidate ever existed at all -- fall back\n",
    "        # to the single best preposed one (FIX #8b's original\n",
    "        # single-winner behavior, unchanged for this branch).\n",
    "        results.append(resolved_candidates[0])\n",
    "\n",
    "    return results\n",
    "\n",
    "\n",
    "# FIX #23 (report Section 4b -- \"extract each sentence to its\n",
    "# fullest\"): a chain of coordinated/subordinated actions on the\n",
    "# same subject -- \"sawa dibungkus dengan kain putih DAN DIIKAT\n",
    "# dengan benang leleson, DIBELIT sebelas kali...\" -- only the FIRST\n",
    "# verb governing the subject was ever used as relation_token before;\n",
    "# these sibling verbs (joined via conj \"dan\", or advcl) share the\n",
    "# same logical subject and were never visited. Walked here and\n",
    "# treated as additional relation_tokens against the SAME subject.\n",
    "# Skip a sibling that introduces its OWN explicit subject (nsubj/\n",
    "# nsubj:pass child) -- that's a separate clause, not a shared-\n",
    "# subject coordination.\n",
    "# FIX #24: an advcl joined by a temporal/conditional subordinator\n",
    "# (\"setelah tiba di setra, sawa diletakkan...\", \"bila telah berada...,\n",
    "# pernah dilewati bulan purnama...\") is a WHEN / AFTER / IF frame with its\n",
    "# own (usually implicit) subject -- NOT a shared-subject serial action.\n",
    "# Borrowing the main clause's subject for it invents false relations (the\n",
    "# fronted clause's own fact restated against the wrong subject: bogus\n",
    "# sawa --tiba--> setra). Sequential connectors (lalu / kemudian /\n",
    "# selanjutnya / dan) are deliberately NOT here -- those DO chain real\n",
    "# serial actions (FIX #23). Consistent with the project's \"zero relations\n",
    "# rather than a wrong one\" stance.\n",
    "SUBORDINATE_ADVCL_MARKS = {\n",
    "    \"setelah\", \"sesudah\", \"seusai\", \"usai\", \"sebelum\",\n",
    "    \"ketika\", \"saat\", \"sewaktu\", \"tatkala\", \"kala\",\n",
    "    \"bila\", \"jika\", \"kalau\", \"apabila\", \"asalkan\", \"begitu\", \"selesai\",\n",
    "    \"menjelang\", \"hingga\",\n",
    "}\n",
    "\n",
    "\n",
    "def _advcl_has_subordinate_mark(verb_token, tokens, _depth=0):\n",
    "    for child in tokens:\n",
    "        if child[\"head\"] != verb_token[\"id\"]:\n",
    "            continue\n",
    "        if child[\"deprel\"] == \"mark\" and child[\"lemma\"].lower() in SUBORDINATE_ADVCL_MARKS:\n",
    "            return True\n",
    "        # the subordinator sometimes sits on a nested advcl the parser hung\n",
    "        # off this verb (S1123: \"pernah dilewati...\" heads \"bila telah\n",
    "        # berada...\").\n",
    "        if (\n",
    "            child[\"deprel\"] == \"advcl\"\n",
    "            and _depth < 3\n",
    "            and _advcl_has_subordinate_mark(child, tokens, _depth + 1)\n",
    "        ):\n",
    "            return True\n",
    "    return False\n",
    "\n",
    "\n",
    "def _obl_has_temporal_lemma(head_token, tokens):\n",
    "    \"\"\"\n",
    "    True when head_token has an obl child that is itself a temporal-frame\n",
    "    noun (\"saat\"/\"waktu\"/\"ketika\"/\"kala\") with its own case marker -- i.e.\n",
    "    a genuine \"pada saat X\" / \"di kala X\" temporal framing exists on this\n",
    "    verb.\n",
    "    \"\"\"\n",
    "    return any(\n",
    "        child[\"head\"] == head_token[\"id\"]\n",
    "        and child[\"deprel\"] == \"obl\"\n",
    "        and child[\"lemma\"].lower() in TEMPORAL_ADJUNCT_LEMMAS\n",
    "        and get_case_marker(child, tokens) is not None\n",
    "        for child in tokens\n",
    "    )\n",
    "\n",
    "\n",
    "def find_coordinated_verb_relations(relation_token, tokens):\n",
    "\n",
    "    siblings = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == relation_token[\"id\"]\n",
    "        and child[\"deprel\"] in (\"conj\", \"advcl\")\n",
    "        and child[\"upos\"] == \"VERB\"\n",
    "    ]\n",
    "\n",
    "    result = []\n",
    "\n",
    "    # AUDIT D13 (Iteration 2): \"sesajen DIHATURKAN pada saat abu jenazah\n",
    "    # DIHANYUTKAN ke samudera\" (S1187) / \"di kala jenazah DIANGKUT ke\n",
    "    # setra ..., lancingan kajang DIJUNJUNG ...\" (S1603) -- the temporal\n",
    "    # clause's own verb (\"dihanyutkan\"/\"diangkut\") gets attached as an\n",
    "    # advcl SIBLING of the main verb, with its real subject mis-attached\n",
    "    # to the temporal noun (\"saat abu jenazah\" / \"kala jenazah\") instead\n",
    "    # of to the verb itself -- so has_own_subject below reads False even\n",
    "    # though it isn't really a subject-less coordinate action. Two\n",
    "    # shapes seen: the temporal oblique sits on the OUTER relation_token\n",
    "    # (S1187) or on the candidate sibling itself (S1603) -- check both.\n",
    "    outer_has_temporal_frame = _obl_has_temporal_lemma(relation_token, tokens)\n",
    "\n",
    "    for sibling in sorted(siblings, key=lambda x: x[\"id\"]):\n",
    "\n",
    "        if sibling[\"deprel\"] == \"advcl\" and _advcl_has_subordinate_mark(sibling, tokens):\n",
    "            continue\n",
    "\n",
    "        if sibling[\"deprel\"] == \"advcl\" and (\n",
    "            outer_has_temporal_frame or _obl_has_temporal_lemma(sibling, tokens)\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "        # AUDIT /121 (Iteration 3, S2028/S2166): a sibling advcl whose own\n",
    "        # VERB LEMMA is itself a sequence/temporal marker word (\"menjelang\n",
    "        # dan sampai dengan hari pabersihan, naga banda diletakkan...\") is\n",
    "        # BY DEFINITION clause-framing, never a genuine parallel action --\n",
    "        # emitting it as its own coordinate relation ships the bare marker\n",
    "        # (\"MENJELANG\") as if it were a real predicate. Same family as the\n",
    "        # temporal-obl exclusion just above; this catches the shape where\n",
    "        # the marker word IS the verb rather than heading an obl child.\n",
    "        if sibling[\"deprel\"] == \"advcl\" and (\n",
    "            sibling[\"lemma\"].lower() in SEQUENCE_CASE_MARKERS\n",
    "            or sibling[\"lemma\"].lower() in TEMPORAL_MARKERS_EXTRA\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "        has_own_subject = any(\n",
    "            grandchild[\"head\"] == sibling[\"id\"]\n",
    "            and grandchild[\"deprel\"] in (\"nsubj\", \"nsubj:pass\")\n",
    "            for grandchild in tokens\n",
    "        )\n",
    "\n",
    "        if has_own_subject:\n",
    "            continue\n",
    "\n",
    "        if is_negated(sibling, tokens):\n",
    "            continue\n",
    "\n",
    "        result.append(sibling)\n",
    "\n",
    "    return result\n",
    "\n",
    "# ==========================================\n",
    "# 13.4b. SUBJECT - VERB RELATION (RECONSTRUCTED)\n",
    "# ==========================================\n",
    "# This is the extractor that got lost when find_object_token()\n",
    "# was replaced. It mirrors extract_definition_relations() and\n",
    "# reuses the SAME fixed helpers, so the #1/#2/#3 fixes apply here.\n",
    "\n",
    "def _emit_relations_for_verb(\n",
    "    verb_token,\n",
    "    subject_phrase,\n",
    "    subject_label,\n",
    "    tokens,\n",
    "    sentence_id,\n",
    "):\n",
    "    \"\"\"\n",
    "    Shared by the primary relation_token AND every coordinated\n",
    "    sibling verb found by find_coordinated_verb_relations() (FIX\n",
    "    #23) -- finds every object candidate for verb_token (FIX #10)\n",
    "    and emits one relation per candidate (plus its conjuncts).\n",
    "    \"\"\"\n",
    "\n",
    "    emitted = []\n",
    "\n",
    "    if is_negated(verb_token, tokens):\n",
    "        return emitted\n",
    "\n",
    "    object_candidates = find_object_tokens(verb_token, tokens)\n",
    "\n",
    "    # FIX #4d (report Section 4d, sentence 345): a coordinate list\n",
    "    # is sometimes attached to the VERB itself (conj), not to the\n",
    "    # resolved object token -- get_conjuncts(object_token, ...)\n",
    "    # alone can't see those. Only NOUN/PROPN conjuncts are pulled\n",
    "    # in here; VERB conjuncts are handled separately by\n",
    "    # find_coordinated_verb_relations (FIX #23).\n",
    "    verb_noun_conjuncts = [\n",
    "        c for c in get_conjuncts(verb_token, tokens)\n",
    "        if c[\"upos\"] in (\"NOUN\", \"PROPN\")\n",
    "    ]\n",
    "\n",
    "    for extra in verb_noun_conjuncts:\n",
    "        object_candidates.append((extra, set()))\n",
    "\n",
    "    for object_token, object_flags in object_candidates:\n",
    "\n",
    "        raw_label = derive_raw_relation_label(verb_token, object_token, tokens, object_flags)\n",
    "\n",
    "        # AUDIT N6/S11 (Iteration 1): see the sentinel comment in\n",
    "        # derive_raw_relation_label().\n",
    "        _swap_termasuk = (raw_label == \"_SWAP_JENIS_DARI\")\n",
    "        if _swap_termasuk:\n",
    "            raw_label = \"JENIS_DARI\"\n",
    "\n",
    "        # AUDIT D7 (Iteration 2): see the sentinel comment in\n",
    "        # derive_raw_relation_label().\n",
    "        _swap_offer = (raw_label == \"_SWAP_DIPERSEMBAHKAN_KEPADA\")\n",
    "        if _swap_offer:\n",
    "            raw_label = \"DIPERSEMBAHKAN_KEPADA\"\n",
    "\n",
    "        all_object_tokens = (\n",
    "            [object_token]\n",
    "            + get_conjuncts(object_token, tokens)\n",
    "        )\n",
    "\n",
    "        # AUDIT D4 (Iteration 2): a compound-child conjunct (\"sasih\n",
    "        # kasa dan kapitu\") isn't a token to resolve_object() the\n",
    "        # normal way -- it's already a fully-rendered substitute\n",
    "        # phrase for the SAME object_token. Emit those directly,\n",
    "        # alongside (not instead of) the normal per-token loop below.\n",
    "        # (raw_label here is already fully resolved -- any N6/D7 swap\n",
    "        # sentinel was converted to its real label above; this block\n",
    "        # only handles the D4 shape, unrelated to those swaps.)\n",
    "        for extra_phrase in _compound_child_conjunct_phrases(object_token, tokens):\n",
    "            if subject_phrase.lower().strip() == extra_phrase.lower().strip():\n",
    "                continue\n",
    "            d4_subject, d4_object = (\n",
    "                (extra_phrase, subject_phrase) if _swap_termasuk\n",
    "                else (subject_phrase, extra_phrase)\n",
    "            )\n",
    "            emitted.append({\n",
    "                \"sentence_id\": sentence_id,\n",
    "                \"subject\": d4_subject,\n",
    "                \"subject_label\": subject_label if not _swap_termasuk else None,\n",
    "                \"relation\": raw_label,\n",
    "                \"object\": d4_object,\n",
    "                \"object_label\": None,\n",
    "                \"object_is_clausal\": False,\n",
    "                \"source\": \"dependency_rule\",\n",
    "            })\n",
    "\n",
    "        # AUDIT D4 (Iteration 3): the OTHER narrow shape -- see\n",
    "        # _nmod_cc_conjunct_phrases()'s own docstring. Same emission\n",
    "        # pattern as the compound-chain block just above.\n",
    "        for extra_phrase in _nmod_cc_conjunct_phrases(object_token, tokens):\n",
    "            if subject_phrase.lower().strip() == extra_phrase.lower().strip():\n",
    "                continue\n",
    "            d4_subject, d4_object = (\n",
    "                (extra_phrase, subject_phrase) if _swap_termasuk\n",
    "                else (subject_phrase, extra_phrase)\n",
    "            )\n",
    "            emitted.append({\n",
    "                \"sentence_id\": sentence_id,\n",
    "                \"subject\": d4_subject,\n",
    "                \"subject_label\": subject_label if not _swap_termasuk else None,\n",
    "                \"relation\": raw_label,\n",
    "                \"object\": d4_object,\n",
    "                \"object_label\": None,\n",
    "                \"object_is_clausal\": False,\n",
    "                \"source\": \"dependency_rule\",\n",
    "            })\n",
    "\n",
    "        for obj_tok in all_object_tokens:\n",
    "\n",
    "            obj_tok = resolve_conjunct_head(obj_tok, tokens)\n",
    "\n",
    "            if _object_is_negated(obj_tok, tokens):   # AUDIT S1\n",
    "                continue\n",
    "\n",
    "            object_phrase, object_has_clause, sub_relations = resolve_object(\n",
    "                obj_tok, tokens, subject_phrase\n",
    "            )\n",
    "\n",
    "            # AUDIT N1e (Iteration 1)/D2 (Iteration 2): a defining purpose/\n",
    "            # consequence clause sometimes hangs off the GOVERNING VERB as a\n",
    "            # sibling of the object rather than off the object noun itself\n",
    "            # (\"tirtha ... selaku sarana UNTUK menetapkan...\" S1206;\n",
    "            # \"berfungsi sebagai symbol ..., SEHINGGA roh ... mengalami\n",
    "            # kegoncangan\" S4074). Gate on the object's OWN head lemma\n",
    "            # (obj_tok, not the fully-decomposed object_phrase string,\n",
    "            # which may already carry unrelated appended text) and don't\n",
    "            # require object_has_clause to still be False -- the object\n",
    "            # side and the verb side can each carry independent real\n",
    "            # content for the same generic-noun object.\n",
    "            if (\n",
    "                not sub_relations\n",
    "                and (\n",
    "                    obj_tok[\"lemma\"].lower() in GENERIC_CATEGORY_NOUNS\n",
    "                    or obj_tok[\"text\"].lower() in GENERIC_CATEGORY_NOUNS\n",
    "                )\n",
    "            ):\n",
    "                verb_purpose = [\n",
    "                    c for c in _purpose_oblique_children(verb_token, tokens)\n",
    "                    + [t for t in tokens\n",
    "                       if t[\"head\"] == verb_token[\"id\"] and t[\"deprel\"] == \"xcomp\"]\n",
    "                    if c[\"id\"] != obj_tok[\"id\"]\n",
    "                ]\n",
    "                if verb_purpose:\n",
    "                    extra = \" \".join(\n",
    "                        render_subtree_text(c, tokens)\n",
    "                        for c in sorted(verb_purpose, key=lambda x: x[\"id\"])\n",
    "                    )\n",
    "                    if extra.strip() and extra.strip().lower() not in object_phrase.lower():\n",
    "                        object_phrase = f\"{object_phrase} {extra}\"\n",
    "                        object_has_clause = True\n",
    "\n",
    "            if object_phrase.strip().lower() in LIGHT_ANCHOR_HEADS and sub_relations:\n",
    "                for sub_relation in sub_relations:\n",
    "                    sub_relation[\"sentence_id\"] = sentence_id\n",
    "                    emitted.append(sub_relation)\n",
    "                continue\n",
    "\n",
    "            if subject_phrase.lower().strip() == object_phrase.lower().strip():\n",
    "                continue\n",
    "\n",
    "            # AUDIT N6/S11 (Iteration 1): swap subject/object roles for the\n",
    "            # \"X termasuk Y\" case flagged above, and AUDIT D7 (Iteration 2)\n",
    "            # for the benefactive-passive swap.\n",
    "            final_subject, final_subject_label, final_object = (\n",
    "                (object_phrase, None, subject_phrase)\n",
    "                if (_swap_termasuk or _swap_offer)\n",
    "                else (subject_phrase, subject_label, object_phrase)\n",
    "            )\n",
    "\n",
    "            relation_record = {\n",
    "                \"sentence_id\": sentence_id,\n",
    "                \"subject\": final_subject,\n",
    "                \"subject_label\": final_subject_label,\n",
    "                \"relation\": raw_label,\n",
    "                \"object\": final_object,\n",
    "                \"object_label\": None,\n",
    "                # FIX #26: acl/acl:relcl/appos-expanded object -> a description,\n",
    "                # not an entity name. classify_object_kind() -> LITERAL.\n",
    "                \"object_is_clausal\": object_has_clause,\n",
    "                \"source\": \"dependency_rule\",\n",
    "            }\n",
    "\n",
    "            emitted.append(relation_record)\n",
    "\n",
    "            for sub_relation in sub_relations:\n",
    "                sub_relation[\"sentence_id\"] = sentence_id\n",
    "                emitted.append(sub_relation)\n",
    "\n",
    "    return emitted\n",
    "\n",
    "\n",
    "def extract_subject_verb_relations(dependency_results, df_ner):\n",
    "\n",
    "    relations = []\n",
    "\n",
    "    for result in dependency_results:\n",
    "\n",
    "        sentence_id = result[\"sentence_id\"]\n",
    "        tokens = result[\"tokens\"]\n",
    "\n",
    "        entities = get_sentence_entities(sentence_id, df_ner)\n",
    "\n",
    "        for entity in entities:\n",
    "\n",
    "            subject_head = get_entity_head(entity[\"entity\"], tokens)\n",
    "\n",
    "            if subject_head is None:\n",
    "                continue\n",
    "\n",
    "            # Entity harus jadi subject: aktif (nsubj) ATAU\n",
    "            # pasif (nsubj:pass). nsubj:pass sengaja diterima\n",
    "            # supaya kalimat pasif berpelengkap lokatif/oblik\n",
    "            # (mis. \"abu diletakkan di X\") tetap kebaca; agent\n",
    "            # pasif \"oleh X\" nanti di-skip oleh find_object_tokens.\n",
    "            if subject_head[\"deprel\"] not in (\"nsubj\", \"nsubj:pass\"):\n",
    "                continue\n",
    "\n",
    "            # FIX #7: expand subject along the dependency tree\n",
    "            # (nested compounds like \"sasih paruwak tahuk\") instead\n",
    "            # of trusting the raw NER-matched entity text.\n",
    "            # AUDIT D3 (Iteration 2): also join any coordinate (conj)\n",
    "            # subject members into the phrase -- see expand_subject_phrase().\n",
    "            subject_phrase = expand_subject_phrase(subject_head, tokens)\n",
    "\n",
    "            # Predikat = head dari subject.\n",
    "            relation_token = get_token_by_id(tokens, subject_head[\"head\"])\n",
    "\n",
    "            if relation_token is None:\n",
    "                continue\n",
    "\n",
    "            # Hanya verba. Predikat kopula-nomina (\"X adalah Y\")\n",
    "            # ditangani extract_definition_relations -- supaya\n",
    "            # fakta yang sama tidak tersimpan dua kali.\n",
    "            if relation_token[\"upos\"] != \"VERB\" or is_definition_predicate(relation_token):\n",
    "                continue\n",
    "\n",
    "            # FIX #8c: cek negasi di predikat MAUPUN subject\n",
    "            # (cleft negation \"bukan X yang V...\").\n",
    "            if is_negated(relation_token, tokens) or is_negated(subject_head, tokens):\n",
    "                continue\n",
    "\n",
    "            relations.extend(\n",
    "                _emit_relations_for_verb(\n",
    "                    relation_token,\n",
    "                    subject_phrase,\n",
    "                    entity[\"label\"],\n",
    "                    tokens,\n",
    "                    sentence_id,\n",
    "                )\n",
    "            )\n",
    "\n",
    "            # FIX #23: coordinated/chained sibling verbs sharing\n",
    "            # this same subject (S962: dibungkus DAN diikat,\n",
    "            # dibelit...) -- walked and extracted the same way.\n",
    "            for sibling_verb in find_coordinated_verb_relations(relation_token, tokens):\n",
    "                relations.extend(\n",
    "                    _emit_relations_for_verb(\n",
    "                        sibling_verb,\n",
    "                        subject_phrase,\n",
    "                        entity[\"label\"],\n",
    "                        tokens,\n",
    "                        sentence_id,\n",
    "                    )\n",
    "                )\n",
    "\n",
    "            # FIX #22 (report Section 4c, subject side): a\n",
    "            # classifying/defining clause attached to the SUBJECT\n",
    "            # itself (not the main predicate) -- \"atiwa-tiwa YANG\n",
    "            # TERGOLONG DALAM ngaben svasta\", \"sekar ura YANG\n",
    "            # TERDIRI DARI beras kuning...\", \"mapegat (BERARTI\n",
    "            # 'memutuskan')\" -- becomes its own separate relation\n",
    "            # sharing this subject.\n",
    "            for extra_relation in find_subject_clause_relations(\n",
    "                subject_phrase, entity[\"label\"], subject_head, tokens\n",
    "            ):\n",
    "                extra_relation[\"sentence_id\"] = sentence_id\n",
    "                relations.append(extra_relation)\n",
    "\n",
    "    return relations\n",
    "# ==========================================\n",
    "# 13.5. PHRASE EXPANSION (FIXED)\n",
    "# ==========================================\n",
    "\n",
    "def collect_phrase_tokens(token, tokens, visited=None):\n",
    "    \"\"\"\n",
    "    Recursively collect a token PLUS all of its modifier\n",
    "    descendants -- not just its direct children.\n",
    "\n",
    "    FIX #1: Before, if \"yadnya\" was a compound of \"pitra\"\n",
    "    (not of the phrase's outer head, e.g. \"bagian\"), it was\n",
    "    silently dropped, because the old code only ever looked\n",
    "    at direct children of the outer head. This walks down\n",
    "    as many levels as needed, so nested compounds like\n",
    "    \"bagian\" -> \"pitra\" -> \"yadnya\" all get captured,\n",
    "    instead of stopping after one hop.\n",
    "\n",
    "    The distance check still applies at EACH level, relative\n",
    "    to that level's own parent -- so \"belulang\" (distance 1\n",
    "    from its real parent \"tulang\") still gets included, even\n",
    "    though it's far from the phrase's outer head \"bungkusan\".\n",
    "    \"\"\"\n",
    "\n",
    "    if visited is None:\n",
    "        visited = set()\n",
    "\n",
    "    if token[\"id\"] in visited:\n",
    "        return []\n",
    "\n",
    "    visited.add(token[\"id\"])\n",
    "    collected = [token]\n",
    "\n",
    "    for child in tokens:\n",
    "\n",
    "        if child[\"head\"] != token[\"id\"]:\n",
    "            continue\n",
    "\n",
    "        if child[\"deprel\"] not in [\n",
    "            \"amod\",\n",
    "            \"compound\",\n",
    "            \"flat\",\n",
    "            \"flat:name\",\n",
    "            \"fixed\",\n",
    "            \"nmod\",\n",
    "            \"nummod\"\n",
    "        ]:\n",
    "            continue\n",
    "\n",
    "        # AUDIT D9 (Iteration 2): a \"semasa/di masa X\" temporal-era nmod\n",
    "        # is clause-level time-framing, not part of the entity's own\n",
    "        # identity -- was getting silently glued into the subject/object\n",
    "        # NP (\"mendiang hidup\" / \"mendiang masa hidup\", S1738/S1823).\n",
    "        if child[\"deprel\"] == \"nmod\" and (\n",
    "            get_case_marker(child, tokens) == \"semasa\"\n",
    "            or child[\"lemma\"].lower() == \"masa\"\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "        distance = abs(child[\"id\"] - token[\"id\"])\n",
    "\n",
    "        if distance > 2:\n",
    "            continue\n",
    "\n",
    "        collected.extend(\n",
    "            collect_phrase_tokens(child, tokens, visited)\n",
    "        )\n",
    "\n",
    "    return collected\n",
    "\n",
    "\n",
    "def expand_phrase(token, tokens):\n",
    "\n",
    "    phrase_tokens = collect_phrase_tokens(token, tokens)\n",
    "\n",
    "    # Dedupe (shouldn't be necessary given `visited`, but safe)\n",
    "    # and put back in reading order.\n",
    "    seen_ids = set()\n",
    "    unique_tokens = []\n",
    "\n",
    "    for t in phrase_tokens:\n",
    "        if t[\"id\"] not in seen_ids:\n",
    "            seen_ids.add(t[\"id\"])\n",
    "            unique_tokens.append(t)\n",
    "\n",
    "    unique_tokens = sorted(\n",
    "        unique_tokens,\n",
    "        key=lambda x: x[\"id\"]\n",
    "    )\n",
    "\n",
    "    phrase = \" \".join(\n",
    "        t[\"text\"] for t in unique_tokens\n",
    "    )\n",
    "\n",
    "    return phrase\n",
    "\n",
    "\n",
    "def _strip_stray_ring_head(phrase):\n",
    "    \"\"\"\n",
    "    FIX #8e: \"ring\" is the Balinese preposition \"di/pada\" (\"at/\n",
    "    in\") -- see the RELATION_TAXONOMY comment on \"ring\" as a\n",
    "    verb lemma below. Stanza is inconsistent about how it tags\n",
    "    \"ring\" inside a quoted Balinese phrase: sometimes as the VERB\n",
    "    itself (in which case it's the relation label, and never\n",
    "    ends up inside an object phrase at all -- e.g. \"sorohan\n",
    "    banten ring ajeng sulinggih\"), but sometimes as a NOUN that\n",
    "    becomes the HEAD of the object's own phrase (e.g. \"banten\n",
    "    munggah ring surya\" -> object rendered as \"ring surya\"\n",
    "    instead of just \"surya\"), because the Indonesian-trained\n",
    "    parser has no Balinese support and mistags it either way at\n",
    "    random. When \"ring\" heads the rendered object phrase, strip\n",
    "    it so the object doesn't carry a stray preposition as if it\n",
    "    were part of the entity name.\n",
    "    \"\"\"\n",
    "\n",
    "    if phrase.lower().startswith(\"ring \"):\n",
    "        return phrase[len(\"ring \"):].strip()\n",
    "\n",
    "    return phrase\n",
    "\n",
    "\n",
    "def get_conjuncts(token, tokens, _visited=None):\n",
    "    \"\"\"\n",
    "    Cari token lain yang di-koordinasikan\n",
    "    dengan token ini lewat kata sambung\n",
    "    \"dan\"/\"atau\" (deprel == \"conj\").\n",
    "\n",
    "    Contoh: \"kasa, karo, dan katiga\" ->\n",
    "    \"karo\" dan \"katiga\" adalah conj dari\n",
    "    \"kasa\".\n",
    "\n",
    "    AUDIT N10 (Iteration 1): a 3+-item coordinate list sometimes chains\n",
    "    conj B->A, C->B rather than every member attaching directly to A -- the\n",
    "    original single-hop version silently dropped every member past the\n",
    "    second (\"sasih kasa, karo, dan katiga\" kept only \"karo\"). Walked\n",
    "    transitively now, with a visited-set guard against any parse cycle.\n",
    "\n",
    "    Dipakai supaya kalimat definisi dengan\n",
    "    daftar (list) tidak kehilangan item\n",
    "    ke-2, ke-3, dst -- hanya mengambil\n",
    "    item pertama saja.\n",
    "    \"\"\"\n",
    "\n",
    "    if _visited is None:\n",
    "        _visited = {token[\"id\"]}\n",
    "\n",
    "    direct = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == token[\"id\"]\n",
    "        and child[\"deprel\"] == \"conj\"\n",
    "        and child[\"id\"] not in _visited\n",
    "    ]\n",
    "\n",
    "    all_conjuncts = []\n",
    "    for child in direct:\n",
    "        _visited.add(child[\"id\"])\n",
    "        all_conjuncts.append(child)\n",
    "        all_conjuncts.extend(get_conjuncts(child, tokens, _visited))\n",
    "\n",
    "    seen_ids = set()\n",
    "    unique = []\n",
    "    for c in all_conjuncts:\n",
    "        if c[\"id\"] not in seen_ids:\n",
    "            seen_ids.add(c[\"id\"])\n",
    "            unique.append(c)\n",
    "\n",
    "    return sorted(unique, key=lambda x: x[\"id\"])\n",
    "\n",
    "# ==========================================\n",
    "# ==========================================\n",
    "# 13.5b. SALVAGE HELPERS (bad-object guards,\n",
    "#        used by extract_definition_relations\n",
    "#        and extract_subject_verb_relations)\n",
    "# ==========================================\n",
    "\n",
    "def find_direct_child(head_token, tokens, deprel):\n",
    "    \"\"\"\n",
    "    First direct child of head_token with the given deprel, or\n",
    "    None. Used to check whether a predicate governs its\n",
    "    complement through a specific grammatical relation (obj/\n",
    "    xcomp/ccomp) instead of scanning the sentence positionally.\n",
    "    \"\"\"\n",
    "\n",
    "    for child in tokens:\n",
    "\n",
    "        if child[\"head\"] == head_token[\"id\"] and child[\"deprel\"] == deprel:\n",
    "            return child\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def find_verbal_complement_child(head_token, tokens, deprel):\n",
    "    \"\"\"\n",
    "    Like find_direct_child(), but when there are multiple\n",
    "    children with this deprel (e.g. two xcomp siblings -- one an\n",
    "    adverb like \"secara harfiah\", one the real verbal complement\n",
    "    like \"melambaikan tangan\"), prefer the one that's actually a\n",
    "    VERB. That's the one carrying the real clausal content; the\n",
    "    first-by-token-id one isn't necessarily it.\n",
    "    \"\"\"\n",
    "\n",
    "    candidates = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == head_token[\"id\"] and child[\"deprel\"] == deprel\n",
    "    ]\n",
    "\n",
    "    if not candidates:\n",
    "        return None\n",
    "\n",
    "    verb_candidates = [c for c in candidates if c[\"upos\"] == \"VERB\"]\n",
    "\n",
    "    if verb_candidates:\n",
    "        return sorted(verb_candidates, key=lambda x: x[\"id\"])[0]\n",
    "\n",
    "    return sorted(candidates, key=lambda x: x[\"id\"])[0]\n",
    "\n",
    "\n",
    "def collect_full_subtree(token, tokens, visited=None):\n",
    "    \"\"\"\n",
    "    Collect a token plus ALL of its descendants, any deprel --\n",
    "    unlike collect_phrase_tokens() (which only pulls in NP\n",
    "    modifiers), this is for rendering a full embedded CLAUSE as\n",
    "    text (e.g. the xcomp/ccomp complement of \"berarti\").\n",
    "    \"\"\"\n",
    "\n",
    "    if visited is None:\n",
    "        visited = set()\n",
    "\n",
    "    if token[\"id\"] in visited:\n",
    "        return []\n",
    "\n",
    "    visited.add(token[\"id\"])\n",
    "    collected = [token]\n",
    "\n",
    "    for child in tokens:\n",
    "\n",
    "        if child[\"head\"] != token[\"id\"]:\n",
    "            continue\n",
    "\n",
    "        collected.extend(\n",
    "            collect_full_subtree(child, tokens, visited)\n",
    "        )\n",
    "\n",
    "    return collected\n",
    "\n",
    "\n",
    "def render_subtree_text(token, tokens):\n",
    "    \"\"\"Render collect_full_subtree()'s result as reading-order text.\"\"\"\n",
    "\n",
    "    subtree = collect_full_subtree(token, tokens)\n",
    "\n",
    "    seen_ids = set()\n",
    "    unique_tokens = []\n",
    "\n",
    "    for t in subtree:\n",
    "        if t[\"id\"] not in seen_ids:\n",
    "            seen_ids.add(t[\"id\"])\n",
    "            unique_tokens.append(t)\n",
    "\n",
    "    unique_tokens = sorted(unique_tokens, key=lambda x: x[\"id\"])\n",
    "\n",
    "    return \" \".join(t[\"text\"] for t in unique_tokens)\n",
    "\n",
    "\n",
    "CCONJ_LEMMAS = {\"dan\", \"atau\", \"lan\", \"serta\"}\n",
    "\n",
    "\n",
    "def _coordinator_lemma(conjunct_token, tokens):\n",
    "    \"\"\"The cc lemma (dan/atau/serta/lan) coordinating this conjunct, if any.\"\"\"\n",
    "    for child in tokens:\n",
    "        if child[\"head\"] == conjunct_token[\"id\"] and child[\"deprel\"] == \"cc\":\n",
    "            return child[\"lemma\"].lower()\n",
    "    return None\n",
    "\n",
    "\n",
    "def expand_subject_phrase(subject_head, tokens):\n",
    "    \"\"\"\n",
    "    AUDIT D3 (Iteration 2): like expand_phrase(), but when subject_head\n",
    "    has coordinate (conj) siblings -- \"abu tulang kepala, tangan,\n",
    "    punggung, dada, bokong, paha dan kaki\" (S1439) -- render the full\n",
    "    coordinated list instead of silently keeping only the head's own\n",
    "    phrase. get_conjuncts()'s transitive walk (AUDIT N10, Iteration 1)\n",
    "    was already available but never invoked for the SUBJECT NP -- only\n",
    "    the object side loops it, emitting one relation per conjunct member,\n",
    "    which doesn't fit subjects (the predicate/object stay the same for\n",
    "    every member, so here they're joined into one phrase instead: \"sasih\n",
    "    kaenem dan kapitu\", not two separate relations).\n",
    "    \"\"\"\n",
    "    base = expand_phrase(subject_head, tokens)\n",
    "    conjuncts = get_conjuncts(subject_head, tokens)\n",
    "    if not conjuncts:\n",
    "        return base\n",
    "\n",
    "    coordinator = None\n",
    "    parts = [base]\n",
    "    for c in conjuncts:\n",
    "        c = resolve_conjunct_head(c, tokens)\n",
    "        parts.append(expand_phrase(c, tokens))\n",
    "        cc = _coordinator_lemma(c, tokens)\n",
    "        if cc:\n",
    "            coordinator = cc\n",
    "\n",
    "    if coordinator is None:\n",
    "        coordinator = \"dan\"\n",
    "\n",
    "    if len(parts) == 2:\n",
    "        return f\"{parts[0]} {coordinator} {parts[1]}\"\n",
    "\n",
    "    return \", \".join(parts[:-1]) + f\", {coordinator} {parts[-1]}\"\n",
    "\n",
    "\n",
    "def _compound_child_conjunct_phrases(head_token, tokens):\n",
    "    \"\"\"\n",
    "    AUDIT D4 (Iteration 2, widened Iteration 3): when head_token itself\n",
    "    carries no conj (the normal get_conjuncts() path already handles that\n",
    "    case), check whether a DESCENDANT reached by walking a chain of\n",
    "    compound/flat/flat:name children does -- \"sasih kasa dan kapitu\"\n",
    "    parses with \"kapitu\" as conj of \"kasa\" (a compound child of \"sasih\"),\n",
    "    not of \"sasih\" directly; \"arang pembakaran jaja uli atau jaja gina\"\n",
    "    (S3153) is the same shape one hop deeper -- \"jaja\"(gina) is conj of\n",
    "    \"jaja\"(uli), a compound child of \"pembakaran\", itself a compound child\n",
    "    of \"arang\". Walks the whole compound chain (BFS, not just the first\n",
    "    hop) looking for the first node with a conjunct, and substitutes that\n",
    "    node's own text with each conjunct's rendered phrase inside\n",
    "    head_token's full phrase -- so the shared prefix survives instead of\n",
    "    being lost, at whatever depth the real conjunct sits.\n",
    "    \"\"\"\n",
    "    if get_conjuncts(head_token, tokens):\n",
    "        return []\n",
    "\n",
    "    base_phrase = expand_phrase(head_token, tokens)\n",
    "\n",
    "    frontier = [head_token]\n",
    "    visited = {head_token[\"id\"]}\n",
    "    while frontier:\n",
    "        current = frontier.pop(0)\n",
    "        compound_children = sorted(\n",
    "            (\n",
    "                child for child in tokens\n",
    "                if child[\"head\"] == current[\"id\"]\n",
    "                and child[\"deprel\"] in (\"compound\", \"flat\", \"flat:name\")\n",
    "                and child[\"id\"] not in visited\n",
    "            ),\n",
    "            key=lambda x: x[\"id\"],\n",
    "        )\n",
    "        for child in compound_children:\n",
    "            visited.add(child[\"id\"])\n",
    "            conjuncts = get_conjuncts(child, tokens)\n",
    "            if conjuncts:\n",
    "                phrases = []\n",
    "                for conjunct in conjuncts:\n",
    "                    conjunct = resolve_conjunct_head(conjunct, tokens)\n",
    "                    replacement = expand_phrase(conjunct, tokens)\n",
    "                    if child[\"text\"] in base_phrase:\n",
    "                        phrases.append(base_phrase.replace(child[\"text\"], replacement, 1))\n",
    "                    else:\n",
    "                        phrases.append(f\"{base_phrase} {replacement}\")\n",
    "                return phrases\n",
    "            frontier.append(child)\n",
    "\n",
    "    return []\n",
    "\n",
    "\n",
    "def _nmod_cc_conjunct_phrases(head_token, tokens):\n",
    "    \"\"\"\n",
    "    AUDIT D4 (Iteration 3): a second alternative in a locative/\n",
    "    prepositional coordination sometimes parses as an `nmod` child of the\n",
    "    first noun rather than a plain `conj` -- \"di warung atau di dapur\"\n",
    "    (S3836), \"di pura atau di merajan\" (S3845) -- because the second\n",
    "    alternative carries its OWN case marker (\"di\"), Stanza attaches it as\n",
    "    a separate PP modifying the first noun instead of coordinating it.\n",
    "    Recognize this narrow, specific shape only: an nmod child that (a) has\n",
    "    its own case-marker child (independently case-marked, not a bare\n",
    "    modifier) AND (b) has its own cc child (a coordinating conjunction\n",
    "    genuinely attached to IT, confirming it reads as a coordinate\n",
    "    alternative rather than an ordinary modifier) -- both signals\n",
    "    required, to avoid over-firing on ordinary nmod modifiers. Returns one\n",
    "    rendered phrase per such nmod-conjunct (just the child's own phrase,\n",
    "    not head_token's -- unlike the compound-chain case above there is no\n",
    "    shared prefix embedded inside a single object token to preserve).\n",
    "    \"\"\"\n",
    "    if get_conjuncts(head_token, tokens):\n",
    "        return []\n",
    "\n",
    "    phrases = []\n",
    "    for child in tokens:\n",
    "        if child[\"head\"] != head_token[\"id\"] or child[\"deprel\"] != \"nmod\":\n",
    "            continue\n",
    "        has_own_case = any(\n",
    "            c[\"head\"] == child[\"id\"] and c[\"deprel\"] == \"case\" for c in tokens\n",
    "        )\n",
    "        has_own_cc = any(\n",
    "            c[\"head\"] == child[\"id\"] and c[\"deprel\"] == \"cc\" for c in tokens\n",
    "        )\n",
    "        if has_own_case and has_own_cc:\n",
    "            phrases.append(expand_phrase(child, tokens))\n",
    "    return phrases\n",
    "\n",
    "\n",
    "def resolve_conjunct_head(token, tokens):\n",
    "    \"\"\"\n",
    "    Stanza occasionally mistags the coordinating conjunction WORD\n",
    "    itself (\"lan\"/\"dan\"/\"atau\"/\"serta\") with deprel \"conj\" --\n",
    "    instead of the noun that follows it -- so get_conjuncts()\n",
    "    picks up the bare conjunction word as if it were the conjunct\n",
    "    (e.g. object text \"lan kawitan\" for a list \"...panti, lan\n",
    "    kawitan\"). When that happens, the real content is one of the\n",
    "    conjunction word's own children (here, \"kawitan\" as its\n",
    "    compound). Unwrap to that child; if there's no such child,\n",
    "    return the token unchanged (nothing to unwrap to).\n",
    "    \"\"\"\n",
    "\n",
    "    if token[\"lemma\"].lower() not in CCONJ_LEMMAS:\n",
    "        return token\n",
    "\n",
    "    children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == token[\"id\"]\n",
    "        and child[\"deprel\"] in (\"compound\", \"flat\", \"flat:name\", \"amod\", \"nmod\")\n",
    "    ]\n",
    "\n",
    "    if not children:\n",
    "        return token\n",
    "\n",
    "    return sorted(children, key=lambda x: x[\"id\"])[0]\n",
    "\n",
    "\n",
    "def expand_object_with_clauses(token, tokens):\n",
    "    \"\"\"\n",
    "    Like expand_phrase(), but also appends any relative/complement\n",
    "    clause (acl / acl:relcl) OR appositive gloss (appos) attached\n",
    "    directly to the head -- e.g. \"sarana yang secara formal\n",
    "    religius berfungsi memotong ikatan...\" isn't truncated down to\n",
    "    the bare noun \"sarana\" (FIX #6c), and \"arti[nya], yakni upacara\n",
    "    keagamaan yang diadakan...\" isn't truncated down to bare \"arti\"\n",
    "    either (report Section 4c, object side -- appos wasn't\n",
    "    included before, only acl/acl:relcl was, and only for\n",
    "    definition-relation objects). This is now used for every\n",
    "    relation's object, not just definition relations, so a thin\n",
    "    pronoun/light-noun object like \"sesuatu yang leteh atau tidak\n",
    "    suci\" (sentence 1227) keeps its defining clause too. Renamed\n",
    "    from expand_definition_object() since it's no longer\n",
    "    definition-only.\n",
    "    \"\"\"\n",
    "\n",
    "    base_phrase = expand_phrase(token, tokens)\n",
    "\n",
    "    # AUDIT D6 (Iteration 3, S1963[4]): an nmod/obl purpose-oblique clause\n",
    "    # child returned below can be the SAME node collect_phrase_tokens()'s\n",
    "    # own nmod recursion already walked into base_phrase (e.g. \"sajen\n",
    "    # UNTUK surya\" -- \"surya\" is both base_phrase's own nmod head AND a\n",
    "    # _purpose_oblique_children() match). Gluing render_subtree_text() on\n",
    "    # top duplicates that head token literally (\"sajen untuk surya SURYA ,\n",
    "    # penebusan...\") and, since render_subtree_text() follows every\n",
    "    # deprel (unlike collect_phrase_tokens(), which never follows `conj`),\n",
    "    # also dumps that node's own coordinate siblings as one raw\n",
    "    # token-order string instead of readable text. Track which ids\n",
    "    # base_phrase already covers so we can skip re-gluing an\n",
    "    # already-included head and instead surface only its conjunct\n",
    "    # siblings -- the genuinely new content collect_phrase_tokens() never\n",
    "    # reaches, since it doesn't follow `conj`.\n",
    "    base_ids = {t[\"id\"] for t in collect_phrase_tokens(token, tokens)}\n",
    "\n",
    "    # AUDIT D1 (Iteration 2): was an inline duplicate of acl/acl:relcl/\n",
    "    # appos + purpose-oblique scanning; now routed through the shared\n",
    "    # _clause_children() so the predicate-complement descent (a\n",
    "    # \"sebagai/selaku X\" child's own defining clause) applies here too,\n",
    "    # not just in decompose_object()'s sub-relation-attempt path.\n",
    "    clause_children = _clause_children(token, tokens)\n",
    "\n",
    "    has_clause = bool(clause_children)\n",
    "\n",
    "    for clause_root in clause_children:\n",
    "        if clause_root[\"id\"] in base_ids:\n",
    "            conjuncts = get_conjuncts(clause_root, tokens)\n",
    "            if not conjuncts:\n",
    "                # Head already fully covered by base_phrase and it has no\n",
    "                # coordinate siblings -- nothing new to add, and gluing it\n",
    "                # again would just be the duplicate this fix exists to\n",
    "                # prevent.\n",
    "                continue\n",
    "            clause_text = \", \".join(\n",
    "                # AUDIT D6 (Iteration 3, cosmetic cleanup): each conjunct's own\n",
    "                # rendered subtree can carry a leading comma/space (its own\n",
    "                # preceding punct token, e.g. the \",\" before \"penebusan\" in\n",
    "                # \"surya, penebusan, pamerasan...\") -- strip it before we join\n",
    "                # with our own \", \" separator, or the two combine into \"X, , Y\".\n",
    "                render_subtree_text(c, tokens).lstrip(\" ,\") for c in conjuncts\n",
    "            )\n",
    "        else:\n",
    "            clause_text = render_subtree_text(clause_root, tokens)\n",
    "        base_phrase = f\"{base_phrase} {clause_text}\"\n",
    "\n",
    "    return base_phrase, has_clause\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 13.5d. RECURSIVE OBJECT DECOMPOSITION\n",
    "# ==========================================\n",
    "# expand_object_with_clauses() (above) GLUES every acl / acl:relcl /\n",
    "# appos subtree onto the object string -- that is why objects come out\n",
    "# as whole clauses (\"bagian pitra yadnya , yaitu pengorbanan suci yang\n",
    "# ditujukan kepada leluhur\"). This block instead keeps the object terse\n",
    "# (just \"pitra yadnya\") and turns each stripped clause into its OWN\n",
    "# relation, recursively:\n",
    "#     ngaben           BAGIAN_DARI      pitra yadnya\n",
    "#     pitra yadnya      ADALAH           pengorbanan suci\n",
    "#     pengorbanan suci  DITUJUKAN_UNTUK  leluhur\n",
    "# Consistent with the section's \"zero relations rather than a wrong one\"\n",
    "# stance: a clause is only split when the parse clearly supports it.\n",
    "\n",
    "DECOMPOSE_OBJECTS = True            # False -> legacy expand_object_with_clauses everywhere\n",
    "MAX_OBJECT_DECOMP_DEPTH = 3\n",
    "MAX_SUBRELATIONS_PER_OBJECT = 5\n",
    "\n",
    "# AUDIT S3: a bare generic category noun as the WHOLE object of a copula,\n",
    "# with a relative/reduced clause that produced no sub-relation, means the\n",
    "# defining content was silently dropped (\"swasta ADALAH upacara\" <- \"...\n",
    "# upacara yang dilakukan jika jenazah tidak ditemukan...\"). For these the\n",
    "# clause is kept on the object string (typed LITERAL) instead.\n",
    "GENERIC_CATEGORY_NOUNS = {\n",
    "    \"upacara\", \"ritual\", \"upakara\", \"prosesi\", \"tradisi\", \"kegiatan\", \"proses\",\n",
    "    \"tahap\", \"tahapan\", \"rangkaian\",\n",
    "    \"tirtha\", \"tirta\", \"air\", \"banten\", \"sesajen\", \"sajen\", \"persembahan\",\n",
    "    \"sarana\", \"prasarana\", \"alat\", \"benda\", \"bahan\", \"kain\", \"wadah\",\n",
    "    \"bangunan\", \"tempat\", \"wujud\", \"bentuk\",\n",
    "    \"pengorbanan\", \"yadnya\", \"pelaksanaan\", \"usaha\", \"cara\",\n",
    "    \"sasih\", \"hari\", \"bulan\", \"waktu\",\n",
    "    \"istilah\", \"sebutan\", \"nama\", \"kata\",\n",
    "    \"doa\", \"mantra\", \"aturan\", \"ketentuan\", \"pantangan\",\n",
    "    # AUDIT N1 (Iteration 1 additions): \"X ADALAH pengabenan/penegasan/...\"\n",
    "    # showed the identical bare-noun-loses-its-clause pattern.\n",
    "    \"pengabenan\", \"penegasan\", \"hubungan\", \"fungsi\", \"pertanda\", \"ciri\",\n",
    "    # AUDIT D1 (Iteration 2): the same pattern recurs under MEMILIKI/\n",
    "    # MEMPEROLEH/TERDIRI_DARI/BERARTI, not just ADALAH/BERPERAN_SEBAGAI --\n",
    "    # \"ngaben MEMILIKI peran ganda yang...\" (S32), \"mapegat MEMILIKI makna\n",
    "    # krusial untuk...\" (S61), \"tirtha MEMILIKI fungsi SEBAGAI symbol dari\n",
    "    # ...\" (S4074, English-spelled \"symbol\"), \"X MEMILIKI hubungan erat\n",
    "    # DENGAN itihasa\" (S4087).\n",
    "    \"peran\", \"makna\", \"arti\", \"nilai\", \"tarif\", \"simbol\", \"symbol\",\n",
    "    \"kedudukan\", \"keinginan\", \"alasan\", \"syarat\", \"kondisi\", \"tanda\",\n",
    "}\n",
    "\n",
    "# Light \"container\" nouns whose real content is a single nmod/compound\n",
    "# child -- \"bagian (dari) X\", \"jenis X\". The terse object is X, not the\n",
    "# empty container word.\n",
    "PARTITIVE_LIGHT_HEADS = {\n",
    "    \"bagian\", \"bagi\", \"jenis\", \"bentuk\", \"macam\", \"ragam\", \"tipe\",\n",
    "    \"kelompok\", \"golongan\", \"kategori\", \"kelas\", \"unsur\", \"salah\",\n",
    "}\n",
    "PARTITIVE_IDIOM_BLOCK = {\"jenis kelamin\", \"bentuk badan\", \"salah kaprah\"}\n",
    "PARTITIVE_OK_CASE = {None, \"dari\", \"atas\"}\n",
    "\n",
    "# Marks that make an acl/appos clause an identity gloss (\"X, yaitu Y\").\n",
    "APPOS_COPULA_MARKS = {\"yaitu\", \"yakni\"}\n",
    "\n",
    "# A relative / reduced clause (\"... yang V ...\") is only split into its own\n",
    "# triple when V is a recognised relational verb -- a generic \"yang meninggal\"\n",
    "# / \"yang ditinggal\" otherwise yields a plausible-looking but wrong triple.\n",
    "CLAUSE_RELATION_WHITELIST = {\n",
    "    \"ADALAH\", \"BERARTI\", \"BAGIAN_DARI\", \"TERDIRI_DARI\", \"TERBUAT_DARI\",\n",
    "    \"DIKENAL_SEBAGAI\", \"BERPERAN_SEBAGAI\", \"BERFUNGSI_SEBAGAI\", \"MELAMBANGKAN\",\n",
    "    \"DIPAKAI_UNTUK\", \"BERTUJUAN_UNTUK\", \"DITUJUKAN_UNTUK\", \"MENGHASILKAN\",\n",
    "    \"DIPERSEMBAHKAN_KEPADA\", \"DIPERLAKUKAN_SEPERTI\",\n",
    "}\n",
    "\n",
    "# When a stripped clause's anchor is a bare \"container\" noun (\"memiliki arti,\n",
    "# yaitu X\" / \"berbentuk binatang\"), re-anchor the sub-relation onto the outer\n",
    "# subject so it reads \"PitraYadnya adalah X\", not \"arti adalah X\".\n",
    "LIGHT_ANCHOR_HEADS = {\n",
    "    \"arti\", \"istilah\", \"makna\", \"maksud\", \"pengertian\", \"bentuk\", \"wujud\",\n",
    "    \"tujuan\", \"kedudukan\", \"isi\", \"kata\", \"jenis\", \"fungsi\", \"sifat\", \"ciri\", \"nama\",\n",
    "}\n",
    "SUB_OBJECT_STOPWORDS = {\n",
    "    \"ada\", \"ini\", \"itu\", \"nya\", \"yang\", \"dan\", \"atau\", \"tersebut\", \"adalah\",\n",
    "    \"yaitu\", \"yakni\", \"dll\", \"dsb\", \"dst\", \"juga\", \"pula\", \"saja\", \"yakni\",\n",
    "}\n",
    "\n",
    "\n",
    "# AUDIT N1 (Iteration 1): a purpose/goal oblique attached directly to a\n",
    "# bare generic-category head (\"sarana UNTUK menetapkan...\", \"fungsi UNTUK\n",
    "# mengucapkan...\", \"hubungan DENGAN itihasa...\") carries the defining\n",
    "# content just as much as an acl/acl:relcl clause does, but wasn't being\n",
    "# picked up as \"clause_children\" at all -- the S3 fallback below silently\n",
    "# left these objects bare (\"tirtha BERPERAN_SEBAGAI sarana\", full stop).\n",
    "_PURPOSE_OBLIQUE_CASE_MARKS = {\"untuk\", \"dari\", \"bagi\", \"terhadap\", \"kepada\", \"dengan\"}\n",
    "# AUDIT (Iteration 3, S1782): \"upacara timbang terima ... ANTARA mendiang\n",
    "# ... DENGAN keluarga ...\" -- \"antara X dengan Y\" names the two parties a\n",
    "# rite is held between; the object head's nmod child carrying \"antara\" was\n",
    "# invisible to _purpose_oblique_children() below, so the whole clause\n",
    "# (which IS the point of the sentence) was dropped. Reuses the same\n",
    "# glue-onto-object fallback as the other markers here, not a new relation\n",
    "# type -- consistent with this codebase's existing terseness/safety stance.\n",
    "_PURPOSE_OBLIQUE_CASE_MARKS = _PURPOSE_OBLIQUE_CASE_MARKS | {\"antara\"}\n",
    "_PURPOSE_ADVCL_MARKS = {\"untuk\", \"agar\", \"supaya\"}\n",
    "# AUDIT D2 (Iteration 2): a defining clause is also introduced by\n",
    "# \"bahwa\" (\"daksina ADALAH penegasan ... BAHWA yadnya sudah selesai\",\n",
    "# S1429/S2055 -- a ccomp/advcl-style complement, not a purpose clause,\n",
    "# but structurally reached the same way) or hangs off the governing\n",
    "# verb as a \"sehingga\"-consequence sibling (S4074) rather than a\n",
    "# purpose oblique -- both carry the sentence's real content just as\n",
    "# much as untuk/agar/supaya do.\n",
    "_PURPOSE_ADVCL_MARKS = {\"untuk\", \"agar\", \"supaya\", \"bahwa\", \"sehingga\"}\n",
    "\n",
    "\n",
    "def _purpose_oblique_children(token, tokens):\n",
    "    out = []\n",
    "    for child in tokens:\n",
    "        if child[\"head\"] != token[\"id\"]:\n",
    "            continue\n",
    "        # AUDIT (Iteration 3, S2055): a \"bahwa\"-clause restating the head\n",
    "        # via a copula verb (\"pertanda BAHWA mereka MERUPAKAN keturunan...\")\n",
    "        # attaches as ccomp, not advcl -- one of Iteration 2's own D2\n",
    "        # targets, still broken because only advcl was ever checked here.\n",
    "        # Same mark-based test as the advcl branch; ccomp genuinely shares\n",
    "        # the \"clause restates/defines the head\" semantics advcl already\n",
    "        # covers for bahwa/sehingga.\n",
    "        if child[\"deprel\"] in (\"advcl\", \"ccomp\"):\n",
    "            marks = {\n",
    "                t[\"lemma\"].lower() for t in tokens\n",
    "                if t[\"head\"] == child[\"id\"] and t[\"deprel\"] == \"mark\"\n",
    "            }\n",
    "            if marks & _PURPOSE_ADVCL_MARKS:\n",
    "                out.append(child)\n",
    "        elif child[\"deprel\"] in (\"nmod\", \"obl\"):\n",
    "            if get_case_marker(child, tokens) in _PURPOSE_OBLIQUE_CASE_MARKS:\n",
    "                out.append(child)\n",
    "    return out\n",
    "\n",
    "\n",
    "_PREDICATE_COMPLEMENT_CASE_MARKS = {\"sebagai\", \"selaku\"}\n",
    "\n",
    "\n",
    "def _predicate_complement_child(token, tokens):\n",
    "    \"\"\"\n",
    "    AUDIT D1 (Iteration 2): a \"sebagai/selaku X\" nmod child of a generic\n",
    "    head noun (\"fungsi SEBAGAI sarana\", S4106/S4111/S4128) is a\n",
    "    predicate-nominal complement, not a mere modifier -- it IS the\n",
    "    generic noun's real content. Returns that child when there's exactly\n",
    "    one, so its own defining clauses can be pulled in too.\n",
    "    \"\"\"\n",
    "    candidates = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == token[\"id\"]\n",
    "        and child[\"deprel\"] == \"nmod\"\n",
    "        and get_case_marker(child, tokens) in _PREDICATE_COMPLEMENT_CASE_MARKS\n",
    "    ]\n",
    "    return candidates[0] if len(candidates) == 1 else None\n",
    "\n",
    "\n",
    "def _clause_children(token, tokens):\n",
    "    base = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == token[\"id\"]\n",
    "        and child[\"deprel\"] in (\"acl\", \"acl:relcl\", \"appos\")\n",
    "    ]\n",
    "    base += _purpose_oblique_children(token, tokens)\n",
    "    # AUDIT D1 (Iteration 2): descend one hop into a \"sebagai/selaku X\"\n",
    "    # predicate-nominal complement for ITS OWN defining clause too --\n",
    "    # \"MEMILIKI fungsi SEBAGAI sarana UNTUK menetapkan...\" (S4106) only\n",
    "    # attaches the untuk-clause to \"sarana\", never to \"fungsi\" itself, so\n",
    "    # the old single-hop _clause_children(fungsi) found nothing at all.\n",
    "    complement = _predicate_complement_child(token, tokens)\n",
    "    if complement is not None:\n",
    "        base += [\n",
    "            c for c in tokens\n",
    "            if c[\"head\"] == complement[\"id\"]\n",
    "            and c[\"deprel\"] in (\"acl\", \"acl:relcl\", \"appos\")\n",
    "        ]\n",
    "        base += _purpose_oblique_children(complement, tokens)\n",
    "    return sorted(base, key=lambda x: x[\"id\"])\n",
    "\n",
    "\n",
    "def _is_partitive_light_head(token):\n",
    "    return (\n",
    "        token[\"lemma\"].lower() in PARTITIVE_LIGHT_HEADS\n",
    "        or token[\"text\"].lower() in PARTITIVE_LIGHT_HEADS\n",
    "    )\n",
    "\n",
    "\n",
    "def _descend_partitive_head(token, tokens, _guard=0):\n",
    "    \"\"\"\n",
    "    Step from a light container noun down to its single content child, so\n",
    "    \"bagian dari pitra yadnya\" yields the object \"pitra yadnya\". Only when\n",
    "    unambiguous (exactly one NOUN/PROPN nmod/compound child, plain\n",
    "    'dari'/'atas'/no case marker); otherwise the head is left untouched.\n",
    "    \"\"\"\n",
    "\n",
    "    if _guard > 3 or not _is_partitive_light_head(token):\n",
    "        return token\n",
    "\n",
    "    noun_children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == token[\"id\"]\n",
    "        and child[\"deprel\"] in (\"nmod\", \"compound\", \"flat\")\n",
    "        and child[\"upos\"] in (\"NOUN\", \"PROPN\")\n",
    "    ]\n",
    "\n",
    "    if len(noun_children) != 1:\n",
    "        return token\n",
    "\n",
    "    child = noun_children[0]\n",
    "\n",
    "    if f\"{token['lemma'].lower()} {child['lemma'].lower()}\" in PARTITIVE_IDIOM_BLOCK:\n",
    "        return token\n",
    "\n",
    "    if child[\"deprel\"] == \"nmod\" and get_case_marker(child, tokens) not in PARTITIVE_OK_CASE:\n",
    "        return token\n",
    "\n",
    "    return _descend_partitive_head(child, tokens, _guard + 1)\n",
    "\n",
    "\n",
    "def _clause_predicate_label(verb_token, object_token, tokens, flags):\n",
    "    \"\"\"\n",
    "    Raw predicate label for a stripped relative/reduced clause. Wraps\n",
    "    derive_raw_relation_label() with the one clause-context sense its\n",
    "    surface-form table doesn't carry (\"ditujukan kepada X\" -> dedication,\n",
    "    not location).\n",
    "    \"\"\"\n",
    "\n",
    "    return derive_raw_relation_label(verb_token, object_token, tokens, frozenset(flags))\n",
    "\n",
    "\n",
    "def _mk_sub_relation(subject_phrase, raw_relation, object_phrase, object_is_clausal):\n",
    "    return {\n",
    "        \"subject\": subject_phrase,\n",
    "        \"subject_label\": None,\n",
    "        \"relation\": raw_relation,\n",
    "        \"object\": object_phrase,\n",
    "        \"object_label\": None,\n",
    "        \"object_is_clausal\": object_is_clausal,\n",
    "        \"source\": \"object_decomposition\",\n",
    "        \"_synthetic\": True,\n",
    "        \"_needs_subject_lookup\": True,\n",
    "    }\n",
    "\n",
    "\n",
    "def _subrelations_from_clause(clause_root, anchor_phrase, outer_subject_phrase, tokens, depth, _visited):\n",
    "    \"\"\"\n",
    "    Turn one acl / acl:relcl / appos clause into its own relation(s),\n",
    "    anchored on the terse object phrase, recursing into what hangs off it.\n",
    "    \"\"\"\n",
    "\n",
    "    out = []\n",
    "    deprel = clause_root[\"deprel\"]\n",
    "    marks = {\n",
    "        t[\"lemma\"].lower() for t in tokens\n",
    "        if t[\"head\"] == clause_root[\"id\"] and t[\"deprel\"] in (\"mark\", \"cc\", \"case\")\n",
    "    }\n",
    "\n",
    "    aw = anchor_phrase.lower().split()\n",
    "    if len(aw) == 1 and aw[0] in LIGHT_ANCHOR_HEADS and outer_subject_phrase:\n",
    "        anchor_phrase = outer_subject_phrase\n",
    "\n",
    "    anchor_key = anchor_phrase.lower().strip()\n",
    "\n",
    "    def _emit(raw, obj_phrase, obj_clausal, nested):\n",
    "        if obj_phrase and obj_phrase.lower().strip() not in (\"\", anchor_key):\n",
    "            out.append(_mk_sub_relation(anchor_phrase, raw, obj_phrase, obj_clausal))\n",
    "            out.extend(nested)\n",
    "\n",
    "    # 1. appositive identity gloss -- \"pitra yadnya, yaitu pengorbanan suci\"\n",
    "    if deprel == \"appos\" or (marks & APPOS_COPULA_MARKS):\n",
    "        op, _oh, oc, nested = decompose_object(\n",
    "            clause_root, tokens, anchor_phrase, depth + 1, _visited\n",
    "        )\n",
    "        _emit(\"ADALAH\", op, oc, nested)\n",
    "        return out\n",
    "\n",
    "    # 2. relative / reduced clause with a verbal predicate\n",
    "    if deprel in (\"acl\", \"acl:relcl\") and clause_root[\"upos\"] == \"VERB\":\n",
    "        if is_negated(clause_root, tokens):\n",
    "            return out\n",
    "        obj_cands = find_object_tokens(clause_root, tokens)\n",
    "        for obj_tok, obj_flags in obj_cands[:MAX_SUBRELATIONS_PER_OBJECT]:\n",
    "            if _object_is_negated(obj_tok, tokens):   # AUDIT S1\n",
    "                continue\n",
    "            raw = _clause_predicate_label(clause_root, obj_tok, tokens, obj_flags)\n",
    "            if raw not in CLAUSE_RELATION_WHITELIST:\n",
    "                continue\n",
    "            for ot in [obj_tok] + get_conjuncts(obj_tok, tokens):\n",
    "                ot = resolve_conjunct_head(ot, tokens)\n",
    "                op, _oh, oc, nested = decompose_object(\n",
    "                    ot, tokens, anchor_phrase, depth + 1, _visited\n",
    "                )\n",
    "                _emit(raw, op, oc, nested)\n",
    "        return out\n",
    "\n",
    "    # 3. noun-headed appos/acl carrying its own copula -> identity\n",
    "    if clause_root[\"upos\"] in (\"NOUN\", \"PROPN\") and (\n",
    "        get_copula_child(clause_root, tokens) or is_definition_predicate(clause_root)\n",
    "    ):\n",
    "        op, _oh, oc, nested = decompose_object(\n",
    "            clause_root, tokens, anchor_phrase, depth + 1, _visited\n",
    "        )\n",
    "        _emit(\"ADALAH\", op, oc, nested)\n",
    "        return out\n",
    "\n",
    "    return out\n",
    "\n",
    "\n",
    "def decompose_object(head_token, tokens, outer_subject_phrase, depth=0, _visited=None):\n",
    "    \"\"\"\n",
    "    Terse primary object phrase + recursively decomposed sub-relations for\n",
    "    every acl/acl:relcl/appos clause expand_object_with_clauses() would\n",
    "    otherwise have appended to the object string.\n",
    "\n",
    "    Returns (primary_phrase, primary_head_token, residual_is_clausal,\n",
    "    sub_relations). At MAX_OBJECT_DECOMP_DEPTH it falls back to the old\n",
    "    lossless append so nothing is silently dropped.\n",
    "    \"\"\"\n",
    "\n",
    "    if _visited is None:\n",
    "        _visited = set()\n",
    "\n",
    "    if head_token[\"id\"] in _visited:\n",
    "        return expand_phrase(head_token, tokens), head_token, False, []\n",
    "\n",
    "    _visited.add(head_token[\"id\"])\n",
    "\n",
    "    if depth >= MAX_OBJECT_DECOMP_DEPTH:\n",
    "        appended, has_clause = expand_object_with_clauses(head_token, tokens)\n",
    "        return _strip_stray_ring_head(appended), head_token, has_clause, []\n",
    "\n",
    "    content_head = _descend_partitive_head(head_token, tokens)\n",
    "    primary_phrase = _strip_stray_ring_head(expand_phrase(content_head, tokens))\n",
    "\n",
    "    clause_children = _clause_children(head_token, tokens)\n",
    "    if content_head[\"id\"] != head_token[\"id\"]:\n",
    "        seen_ids = {c[\"id\"] for c in clause_children}\n",
    "        for c in _clause_children(content_head, tokens):\n",
    "            if c[\"id\"] not in seen_ids:\n",
    "                clause_children.append(c)\n",
    "        clause_children.sort(key=lambda x: x[\"id\"])\n",
    "\n",
    "    sub_relations = []\n",
    "    for clause_root in clause_children:\n",
    "        if len(sub_relations) >= MAX_SUBRELATIONS_PER_OBJECT:\n",
    "            break\n",
    "        if is_negated(clause_root, tokens):\n",
    "            continue\n",
    "        sub_relations.extend(\n",
    "            _subrelations_from_clause(\n",
    "                clause_root, primary_phrase, outer_subject_phrase, tokens, depth, _visited\n",
    "            )\n",
    "        )\n",
    "\n",
    "    sub_relations = [\n",
    "        r for r in sub_relations\n",
    "        if r[\"object\"].strip()\n",
    "        and r[\"object\"].strip().lower() not in SUB_OBJECT_STOPWORDS\n",
    "        and re.search(r\"[a-z]{3}\", r[\"object\"].lower())\n",
    "        and r[\"subject\"].strip().lower() != r[\"object\"].strip().lower()\n",
    "    ][:MAX_SUBRELATIONS_PER_OBJECT]\n",
    "\n",
    "    # AUDIT S3/N1: bare generic category noun + a clause that yielded nothing\n",
    "    # -> keep the clause on the object rather than lose it. Iteration 0\n",
    "    # gated this on the WHOLE primary_phrase string being a single-word\n",
    "    # exact match, which missed a quantified/modified head (\"satu tahap\",\n",
    "    # \"upacara keagamaan\", \"beberapa jenis\" all failed the check even\n",
    "    # though their HEAD noun is the generic one). Check the resolved head\n",
    "    # token's lemma instead (Iteration 1).\n",
    "    # AUDIT D1 (Iteration 2, harness fixup): several GENERIC_CATEGORY_NOUNS\n",
    "    # entries are pe-/pen-/ke-...-an DERIVED nouns (\"penegasan\", \"kedudukan\")\n",
    "    # whose Stanza LEMMA strips back to the root (\"tegas\", \"duduk\") -- the\n",
    "    # lemma-only check could never match them. Check the surface text too.\n",
    "    if (\n",
    "        not sub_relations\n",
    "        and clause_children\n",
    "        and (\n",
    "            content_head[\"lemma\"].lower() in GENERIC_CATEGORY_NOUNS\n",
    "            or content_head[\"text\"].lower() in GENERIC_CATEGORY_NOUNS\n",
    "        )\n",
    "    ):\n",
    "        appended, _hc = expand_object_with_clauses(content_head, tokens)\n",
    "        appended = _strip_stray_ring_head(appended)\n",
    "        if appended.strip().lower() != primary_phrase.strip().lower():\n",
    "            return appended, content_head, True, []\n",
    "\n",
    "    return primary_phrase, content_head, False, sub_relations\n",
    "\n",
    "\n",
    "def resolve_object(obj_tok, tokens, subject_phrase):\n",
    "    \"\"\"\n",
    "    Shared object resolver for all three relation extractors. Returns\n",
    "    (object_phrase, object_is_clausal, sub_relations).\n",
    "    \"\"\"\n",
    "\n",
    "    if not DECOMPOSE_OBJECTS:\n",
    "        phrase, clausal = expand_object_with_clauses(obj_tok, tokens)\n",
    "        return _strip_stray_ring_head(phrase), clausal, []\n",
    "\n",
    "    phrase, _head, clausal, subs = decompose_object(\n",
    "        obj_tok, tokens, subject_phrase, depth=0\n",
    "    )\n",
    "    return phrase, clausal, subs\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 13.5c. SUBJECT-ATTACHED CLASSIFYING CLAUSE\n",
    "#        -> SEPARATE RELATION\n",
    "# ==========================================\n",
    "# FIX #22 (report Section 4c, subject side): a relative/\n",
    "# appositive clause attached to the SUBJECT sometimes carries its\n",
    "# own independently-extractable fact instead of just describing\n",
    "# the subject -- \"atiwa-tiwa YANG TERGOLONG DALAM ngaben svasta\n",
    "# adalah raçadana\" (sentence 272), \"sekar ura YANG TERDIRI DARI\n",
    "# beras kuning...\" (sentence 220), \"mapegat (BERARTI\n",
    "# 'memutuskan')\" (sentence 62). expand_phrase() never walks into\n",
    "# acl/acl:relcl/appos on purpose -- most such clauses are just\n",
    "# descriptive (\"yang sangat rigid\"), and folding a big composition\n",
    "# list into the subject STRING would make it unreadable. So this\n",
    "# is a narrow, separate pass: only trigger when the clause's own\n",
    "# predicate is one of a small set of recognized classifying/\n",
    "# defining/composing verbs, and emit it as its OWN relation\n",
    "# sharing the outer subject, instead of appending it to the\n",
    "# subject text.\n",
    "\n",
    "SUBJECT_CLAUSE_CLASSIFICATION_LEMMAS = {\"golong\"}\n",
    "\n",
    "\n",
    "def find_subject_clause_relations(subject_phrase, subject_label, subject_head, tokens):\n",
    "\n",
    "    extra_relations = []\n",
    "\n",
    "    # AUDIT D1/D2 (Iteration 3, S2124): \"swadharma beliau UNTUK mamari-\n",
    "    # suddha (menyucikan) dunia ini, merupakan fungsi pokok\" -- the purpose\n",
    "    # clause sits on the SUBJECT head, not the object. The object-side\n",
    "    # equivalent (_purpose_oblique_children, used throughout 13.5d) has no\n",
    "    # subject-side counterpart, so this was silently dropped, leaving a\n",
    "    # content-free \"X ADALAH fungsi pokok\". Scoped narrowly to \"untuk\"\n",
    "    # (purpose) only, not the full _PURPOSE_OBLIQUE_CASE_MARKS set -- this\n",
    "    # is new code on the subject side, not a widening of an already-proven\n",
    "    # mechanism like 3c/3d, so stay conservative.\n",
    "    for purpose_child in _purpose_oblique_children(subject_head, tokens):\n",
    "        if get_case_marker(purpose_child, tokens) != \"untuk\":\n",
    "            continue\n",
    "        if is_negated(purpose_child, tokens):\n",
    "            continue\n",
    "        purpose_child = resolve_conjunct_head(purpose_child, tokens)\n",
    "        purpose_phrase, _purpose_clausal = expand_object_with_clauses(purpose_child, tokens)\n",
    "        purpose_phrase = _strip_stray_ring_head(purpose_phrase)\n",
    "        if (\n",
    "            purpose_phrase.strip()\n",
    "            and subject_phrase.lower().strip() != purpose_phrase.lower().strip()\n",
    "        ):\n",
    "            extra_relations.append({\n",
    "                \"subject\": subject_phrase,\n",
    "                \"subject_label\": subject_label,\n",
    "                \"relation\": \"BERTUJUAN_UNTUK\",\n",
    "                \"object\": purpose_phrase,\n",
    "                \"object_label\": None,\n",
    "                \"object_is_clausal\": _purpose_clausal,\n",
    "                \"source\": \"dependency_rule\",\n",
    "            })\n",
    "\n",
    "    clause_children = [\n",
    "        child for child in tokens\n",
    "        if child[\"head\"] == subject_head[\"id\"]\n",
    "        and child[\"deprel\"] in (\"acl\", \"acl:relcl\", \"appos\")\n",
    "    ]\n",
    "\n",
    "    for clause_root in sorted(clause_children, key=lambda x: x[\"id\"]):\n",
    "\n",
    "        if is_negated(clause_root, tokens):\n",
    "            continue\n",
    "\n",
    "        surface = clause_root[\"text\"].lower()\n",
    "        lemma = clause_root[\"lemma\"].lower()\n",
    "\n",
    "        object_candidates = None\n",
    "        raw_label = None\n",
    "\n",
    "        if lemma in SUBJECT_CLAUSE_CLASSIFICATION_LEMMAS:\n",
    "            raw_label = \"BAGIAN_DARI\"\n",
    "            object_candidates = find_object_tokens(clause_root, tokens)\n",
    "        elif surface.startswith(\"termasuk\"):\n",
    "            raw_label = \"BAGIAN_DARI\"\n",
    "            object_candidates = find_object_tokens(clause_root, tokens)\n",
    "        elif surface.startswith(\"terdiri\"):\n",
    "            raw_label = \"TERDIRI_DARI\"\n",
    "            object_candidates = find_object_tokens(clause_root, tokens)\n",
    "        elif lemma == \"isi\" or surface.startswith(\"berisi\") or surface.startswith(\"diisi\"):\n",
    "            # AUDIT D8 (Iteration 2): \"kawangen YANG BERISI 9 biji uang\n",
    "            # kepeng dan bunga tunjung putih\" -- the contents clause on\n",
    "            # the subject itself, not previously recognized here.\n",
    "            raw_label = \"BERISI\"\n",
    "            object_candidates = find_object_tokens(clause_root, tokens)\n",
    "        elif surface in _SHAPE_MEANING_NONCOPULA:\n",
    "            # AUDIT D9 (Iteration 2): \"patulangan YANG BERBENTUK naga\n",
    "            # kahang dan gajah mina ...\" -- is_definition_predicate()\n",
    "            # deliberately excludes these surface forms (AUDIT S4) so\n",
    "            # they route through the ordinary verb-label cascade instead\n",
    "            # of ADALAH, but that meant no subject-clause branch here\n",
    "            # recognized them either, and the whole clause was dropped.\n",
    "            candidates = find_object_tokens(clause_root, tokens)\n",
    "            if candidates:\n",
    "                raw_label = derive_raw_relation_label(\n",
    "                    clause_root, candidates[0][0], tokens, candidates[0][1]\n",
    "                )\n",
    "                object_candidates = candidates\n",
    "        elif lemma == \"tingkat\" or surface.startswith(\"bertingkat\"):\n",
    "            # AUDIT D9 (Iteration 3, Stage 5): \"bade YANG BERTINGKAT 11\" /\n",
    "            # \"bade BERTINGKAT sembilan\" -- the tier-count qualifier on the\n",
    "            # subject was silently dropped (no branch above recognizes\n",
    "            # \"tingkat\"), collapsing distinct bade/patulangan variants into\n",
    "            # contradictory near-duplicate triples (S2000-S2002). Surface it\n",
    "            # as its own fact rather than losing it.\n",
    "            nummod = next(\n",
    "                (c for c in tokens\n",
    "                 if c[\"head\"] == clause_root[\"id\"] and c[\"deprel\"] == \"nummod\"),\n",
    "                None,\n",
    "            )\n",
    "            if nummod is not None:\n",
    "                raw_label = \"MEMILIKI_TINGKAT\"\n",
    "                object_candidates = [(nummod, set())]\n",
    "        elif lemma == \"arti\" and find_direct_child(clause_root, tokens, \"obj\") is not None:\n",
    "            # FIX (sentence 62 report): \"berarti\" is a transitive gloss\n",
    "            # verb with its own \"obj\" child (the real gloss word, e.g.\n",
    "            # \"memutuskan\") -- unlike a bare copula, clause_root itself\n",
    "            # is NOT the complement here, so walk to its object like\n",
    "            # termasuk/terdiri above instead of defaulting to clause_root.\n",
    "            raw_label = \"ADALAH\"\n",
    "            object_candidates = find_object_tokens(clause_root, tokens)\n",
    "        elif is_definition_predicate(clause_root) or get_copula_child(clause_root, tokens):\n",
    "            raw_label = \"ADALAH\"\n",
    "            object_candidates = [(clause_root, set())]\n",
    "\n",
    "        if not object_candidates:\n",
    "            continue\n",
    "\n",
    "        for object_token, _flags in object_candidates:\n",
    "\n",
    "            all_objs = [object_token] + get_conjuncts(object_token, tokens)\n",
    "\n",
    "            for obj_tok in all_objs:\n",
    "\n",
    "                obj_tok = resolve_conjunct_head(obj_tok, tokens)\n",
    "\n",
    "                object_phrase, object_has_clause, sub_relations = resolve_object(\n",
    "                    obj_tok, tokens, subject_phrase\n",
    "                )\n",
    "\n",
    "                if subject_phrase.lower().strip() == object_phrase.lower().strip():\n",
    "                    continue\n",
    "\n",
    "                extra_relations.append({\n",
    "                    \"subject\": subject_phrase,\n",
    "                    \"subject_label\": subject_label,\n",
    "                    \"relation\": raw_label,\n",
    "                    \"object\": object_phrase,\n",
    "                    \"object_label\": None,\n",
    "                    \"object_is_clausal\": object_has_clause,   # FIX #26\n",
    "                    \"source\": \"dependency_rule\",\n",
    "                })\n",
    "\n",
    "                extra_relations.extend(sub_relations)\n",
    "\n",
    "    return extra_relations\n",
    "# 13.6. DEFINITION RELATION (FIXED)\n",
    "# ==========================================\n",
    "\n",
    "DEFINITION_VERBS = {\n",
    "    \"adalah\",\n",
    "    \"merupakan\",\n",
    "    \"ialah\",\n",
    "    \"jadi\",\n",
    "    \"rupa\",\n",
    "    \"arti\",\n",
    "    \"makna\",\n",
    "    \"bentuk\",\n",
    "    \"nama\",\n",
    "}\n",
    "\n",
    "# FIX #8d: \"berada\" removed. It used to be treated as a copula on\n",
    "# par with \"adalah\", so extract_definition_relations() below\n",
    "# unconditionally labeled every \"X berada di/atas/dalam Y\"\n",
    "# (locative) sentence with the identity relation \"adalah\" instead\n",
    "# of the correct locative \"berada di\" -- e.g. \"sawa berada di atas\n",
    "# galar\" (the corpse is ON galar) came out as \"sawa adalah galar\"\n",
    "# (the corpse IS galar). Bare \"berada\" is now just a normal VERB,\n",
    "# handled by extract_subject_verb_relations() + the \"berada\"\n",
    "# special case there (see derive_raw_relation_label()).\n",
    "DEFINITION_SURFACE_FORMS = set()\n",
    "\n",
    "# AUDIT S4: \"berbentuk X\" (shaped like), \"berarti / bermakna X\" (means),\n",
    "# \"bernama X\" (named), \"berwujud X\" are inflected verbs whose Stanza lemma\n",
    "# collides with the copula-noun list (\"bentuk\"/\"arti\"/\"makna\"/\"nama\"/\"rupa\").\n",
    "# They are NOT copula definitions -- route them to the verb extractor so they\n",
    "# yield BERBENTUK / BERARTI / DIKENAL_SEBAGAI / BERWUJUD, not \"X ADALAH\n",
    "# berbentuk\". Denylist by exact surface form so real copulas that ALSO\n",
    "# lemmatise to \"rupa\" (\"merupakan\") are untouched.\n",
    "_SHAPE_MEANING_NONCOPULA = {\n",
    "    \"berbentuk\", \"berwujud\", \"berupa\", \"berarti\", \"bermakna\", \"bernama\",\n",
    "    \"berbadankan\", \"menyerupai\", \"berbentukkan\",\n",
    "}\n",
    "\n",
    "\n",
    "def is_definition_predicate(token):\n",
    "    t = token[\"text\"].lower()\n",
    "    if t in _SHAPE_MEANING_NONCOPULA:\n",
    "        return False\n",
    "    return (\n",
    "        token[\"lemma\"] in DEFINITION_VERBS\n",
    "        or t in DEFINITION_SURFACE_FORMS\n",
    "    )\n",
    "\n",
    "\n",
    "def get_copula_child(head_token, tokens):\n",
    "    \"\"\"\n",
    "    Cek apakah head_token (biasanya sebuah NOUN,\n",
    "    misal \"boneka\" pada \"naga banda adalah boneka...\")\n",
    "    punya anak dengan deprel \"cop\" yang lemma-nya\n",
    "    termasuk DEFINITION_VERBS (misal \"adalah\").\n",
    "\n",
    "    Ini menangani kalimat kopula bahasa Indonesia,\n",
    "    di mana secara gramatikal head dari subject\n",
    "    BUKAN kata kerja \"adalah\" itu sendiri, melainkan\n",
    "    noun/kata benda yang menjadi predikatnya\n",
    "    -- dan \"adalah\" hanya menempel sebagai anak\n",
    "    (deprel \"cop\") dari noun tersebut.\n",
    "\n",
    "    Return True kalau head_token memang predikat\n",
    "    kopula yang valid.\n",
    "    \"\"\"\n",
    "\n",
    "    for child in tokens:\n",
    "\n",
    "        if child[\"head\"] == head_token[\"id\"] and child[\"deprel\"] == \"cop\":\n",
    "\n",
    "            if child[\"lemma\"] in DEFINITION_VERBS:\n",
    "\n",
    "                return True\n",
    "\n",
    "    return False\n",
    "\n",
    "\n",
    "def extract_definition_relations(\n",
    "    dependency_results,\n",
    "    df_ner\n",
    "):\n",
    "\n",
    "    relations = []\n",
    "\n",
    "    for result in dependency_results:\n",
    "\n",
    "        sentence_id = result[\"sentence_id\"]\n",
    "        tokens = result[\"tokens\"]\n",
    "\n",
    "        entities = get_sentence_entities(\n",
    "            sentence_id,\n",
    "            df_ner\n",
    "        )\n",
    "\n",
    "        for entity in entities:\n",
    "\n",
    "            # ----------------------------------\n",
    "            # 1. Cari head entity\n",
    "            # ----------------------------------\n",
    "\n",
    "            subject_head = get_entity_head(\n",
    "                entity[\"entity\"],\n",
    "                tokens\n",
    "            )\n",
    "\n",
    "            if subject_head is None:\n",
    "                continue\n",
    "\n",
    "            # ----------------------------------\n",
    "            # Entity harus menjadi subject.\n",
    "            # FIX #3: terima juga \"nsubj:pass\"\n",
    "            # (lihat penjelasan di\n",
    "            # extract_subject_verb_relations).\n",
    "            # ----------------------------------\n",
    "            if subject_head[\"deprel\"] not in (\"nsubj\", \"nsubj:pass\"):\n",
    "                continue\n",
    "\n",
    "            # FIX #7: expand the subject along the dependency tree\n",
    "            # instead of trusting the raw NER-matched entity text.\n",
    "            # AUDIT D3 (Iteration 2): also join any coordinate (conj)\n",
    "            # subject members into the phrase -- see expand_subject_phrase().\n",
    "            subject_phrase = expand_subject_phrase(subject_head, tokens)\n",
    "\n",
    "            # ----------------------------------\n",
    "            # 2. Cari predikat definisi\n",
    "            #\n",
    "            # Case A (lama): head langsung berupa\n",
    "            # verb \"adalah\"/\"merupakan\"/dll.\n",
    "            #\n",
    "            # Case B (BARU): head berupa NOUN, dan\n",
    "            # noun itu punya child \"cop\" yang\n",
    "            # lemma-nya termasuk DEFINITION_VERBS\n",
    "            # (contoh: \"naga banda adalah boneka...\",\n",
    "            # head dari \"naga banda\" adalah \"boneka\",\n",
    "            # dan \"boneka\" punya child cop \"adalah\")\n",
    "            # ----------------------------------\n",
    "\n",
    "            predicate_token = get_token_by_id(\n",
    "                tokens,\n",
    "                subject_head[\"head\"]\n",
    "            )\n",
    "\n",
    "            if predicate_token is None:\n",
    "                continue\n",
    "\n",
    "            is_definition = False\n",
    "            object_start_token = None\n",
    "\n",
    "            if is_definition_predicate(predicate_token):\n",
    "                # Case A: head-nya sendiri adalah verb \"adalah\"\n",
    "                is_definition = True\n",
    "                object_start_token = predicate_token\n",
    "\n",
    "            elif get_copula_child(predicate_token, tokens):\n",
    "                # Case B: head-nya noun, tapi punya cop child\n",
    "                # -> predicate_token ITU SENDIRI adalah object\n",
    "                # (bukan kata setelahnya).\n",
    "                is_definition = True\n",
    "                object_start_token = predicate_token\n",
    "\n",
    "            if not is_definition:\n",
    "                continue\n",
    "\n",
    "            # ----------------------------------\n",
    "            # FIX #2 / #8c: SKIP RELASI YANG DINEGASI (predikat\n",
    "            # atau subject -- cleft negation).\n",
    "            # ----------------------------------\n",
    "            if is_negated(predicate_token, tokens) or is_negated(subject_head, tokens):\n",
    "                continue\n",
    "\n",
    "            # ----------------------------------\n",
    "            # FIX #6: PREDIKAT MENGUASAI KLAUSA,\n",
    "            # BUKAN NOUN PHRASE DATAR\n",
    "            #\n",
    "            # \"berarti\"/\"adalah\"/dll kadang punya\n",
    "            # complement berupa KLAUSA, bukan NP datar --\n",
    "            # mis. \"swastagni berarti mengusahakan untuk\n",
    "            # mencapai bahagia...\" (xcomp), atau \"nyekeh\n",
    "            # berarti jenazah dibaringkan di rumah adat...\"\n",
    "            # (obj + xcomp yang sebenarnya small clause).\n",
    "            # ----------------------------------\n",
    "\n",
    "            if is_definition_predicate(predicate_token):\n",
    "\n",
    "                predicate_xcomp = find_verbal_complement_child(\n",
    "                    predicate_token, tokens, \"xcomp\"\n",
    "                )\n",
    "                predicate_ccomp = find_verbal_complement_child(\n",
    "                    predicate_token, tokens, \"ccomp\"\n",
    "                )\n",
    "\n",
    "                if predicate_xcomp is not None or predicate_ccomp is not None:\n",
    "\n",
    "                    complement_root = (\n",
    "                        predicate_xcomp\n",
    "                        if predicate_xcomp is not None\n",
    "                        else predicate_ccomp\n",
    "                    )\n",
    "\n",
    "                    predicate_direct_obj = find_direct_child(\n",
    "                        predicate_token, tokens, \"obj\"\n",
    "                    )\n",
    "\n",
    "                    clause_parts = []\n",
    "\n",
    "                    if predicate_direct_obj is not None:\n",
    "                        clause_parts.append(\n",
    "                            render_subtree_text(predicate_direct_obj, tokens)\n",
    "                        )\n",
    "\n",
    "                    clause_parts.append(\n",
    "                        render_subtree_text(complement_root, tokens)\n",
    "                    )\n",
    "\n",
    "                    clausal_object_phrase = \" \".join(clause_parts)\n",
    "\n",
    "                    if subject_phrase.lower().strip() != clausal_object_phrase.lower().strip():\n",
    "\n",
    "                        relations.append({\n",
    "                            \"sentence_id\": sentence_id,\n",
    "                            \"subject\": subject_phrase,\n",
    "                            \"subject_label\": entity[\"label\"],\n",
    "                            \"relation\": \"adalah\",\n",
    "                            \"object\": clausal_object_phrase,\n",
    "                            \"object_label\": None,\n",
    "                            \"source\": \"dependency_rule\",\n",
    "                            \"object_is_clausal\": True,\n",
    "                        })\n",
    "\n",
    "                    continue  # entity ini sudah selesai ditangani\n",
    "\n",
    "            # ----------------------------------\n",
    "            # 3. Tentukan object\n",
    "            # ----------------------------------\n",
    "\n",
    "            if is_definition_predicate(predicate_token):\n",
    "\n",
    "                # FIX #6b: cek dulu apakah predikat punya\n",
    "                # child \"obj\" langsung -- baru kalau tidak\n",
    "                # ada, fallback ke scan forward yang lama.\n",
    "                direct_obj = find_direct_child(\n",
    "                    predicate_token, tokens, \"obj\"\n",
    "                )\n",
    "\n",
    "                if direct_obj is not None:\n",
    "\n",
    "                    object_token = direct_obj\n",
    "\n",
    "                else:\n",
    "\n",
    "                    # Case A fallback: cari noun/propn pertama\n",
    "                    # SETELAH kata \"adalah\"\n",
    "                    candidates = []\n",
    "\n",
    "                    for token in tokens:\n",
    "\n",
    "                        if token[\"id\"] <= predicate_token[\"id\"]:\n",
    "                            continue\n",
    "\n",
    "                        if token[\"upos\"] in [\n",
    "                            \"PUNCT\", \"ADP\", \"CCONJ\", \"SCONJ\"\n",
    "                        ]:\n",
    "                            continue\n",
    "\n",
    "                        if token[\"upos\"] not in [\"NOUN\", \"PROPN\"]:\n",
    "                            continue\n",
    "\n",
    "                        if token[\"text\"].lower() in CATAPHORIC_FILLER_SURFACE_FORMS:\n",
    "                            # FIX #8f/#9a: discourse filler\n",
    "                            # (\"berikut\"), not a real entity.\n",
    "                            continue\n",
    "\n",
    "                        candidates.append(token)\n",
    "\n",
    "                    if not candidates:\n",
    "                        continue\n",
    "\n",
    "                    object_token = candidates[0]\n",
    "\n",
    "            else:\n",
    "\n",
    "                # Case B: predicate_token (noun) ITU SENDIRI\n",
    "                # adalah object-nya, tinggal expand phrase-nya\n",
    "                object_token = predicate_token\n",
    "\n",
    "            # ----------------------------------\n",
    "            # 4. Kumpulkan semua object:\n",
    "            #    object utama + conjuncts-nya\n",
    "            #    (untuk daftar seperti\n",
    "            #    \"kasa, karo, dan katiga\")\n",
    "            #\n",
    "            # FIX #4d (report Section 4d, sentence 345): a\n",
    "            # coordinate list sometimes attaches to the VERB\n",
    "            # (conj), not to object_token -- pull those in too.\n",
    "            # ----------------------------------\n",
    "\n",
    "            all_object_tokens = (\n",
    "                [object_token]\n",
    "                + get_conjuncts(object_token, tokens)\n",
    "                + [\n",
    "                    c for c in get_conjuncts(predicate_token, tokens)\n",
    "                    if c[\"upos\"] in (\"NOUN\", \"PROPN\")\n",
    "                    and c[\"id\"] != object_token[\"id\"]\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            # ----------------------------------\n",
    "            # 5. Expand + simpan SATU relation\n",
    "            #    per item dalam daftar\n",
    "            # ----------------------------------\n",
    "\n",
    "            for obj_tok in all_object_tokens:\n",
    "\n",
    "                obj_tok = resolve_conjunct_head(obj_tok, tokens)\n",
    "\n",
    "                if _object_is_negated(obj_tok, tokens):   # AUDIT S1\n",
    "                    continue\n",
    "\n",
    "                # FIX #6c: expand_object_with_clauses() (bukan\n",
    "                # expand_phrase() biasa) supaya relative/\n",
    "                # complement clause DAN appositive gloss yang\n",
    "                # menempel di object head ikut kebawa, bukan\n",
    "                # hilang jadi noun kosong.\n",
    "                object_phrase, object_has_clause, sub_relations = resolve_object(\n",
    "                    obj_tok,\n",
    "                    tokens,\n",
    "                    subject_phrase\n",
    "                )\n",
    "\n",
    "                # AUDIT D2 (Iteration 2): a defining purpose/consequence\n",
    "                # clause sometimes hangs off the copula VERB\n",
    "                # (predicate_token) as a sibling of the object rather\n",
    "                # than off the object noun -- see the N1e comment in\n",
    "                # _emit_relations_for_verb() for the mirror case on the\n",
    "                # non-copula path.\n",
    "                if (\n",
    "                    not sub_relations\n",
    "                    and (\n",
    "                        obj_tok[\"lemma\"].lower() in GENERIC_CATEGORY_NOUNS\n",
    "                        or obj_tok[\"text\"].lower() in GENERIC_CATEGORY_NOUNS\n",
    "                    )\n",
    "                ):\n",
    "                    verb_purpose = [\n",
    "                        c for c in _purpose_oblique_children(predicate_token, tokens)\n",
    "                        + [t for t in tokens\n",
    "                           if t[\"head\"] == predicate_token[\"id\"] and t[\"deprel\"] == \"xcomp\"]\n",
    "                        if c[\"id\"] != obj_tok[\"id\"]\n",
    "                    ]\n",
    "                    if verb_purpose:\n",
    "                        extra = \" \".join(\n",
    "                            render_subtree_text(c, tokens)\n",
    "                            for c in sorted(verb_purpose, key=lambda x: x[\"id\"])\n",
    "                        )\n",
    "                        if extra.strip() and extra.strip().lower() not in object_phrase.lower():\n",
    "                            object_phrase = f\"{object_phrase} {extra}\"\n",
    "                            object_has_clause = True\n",
    "\n",
    "                if object_phrase.strip().lower() in LIGHT_ANCHOR_HEADS and sub_relations:\n",
    "                    for sub_relation in sub_relations:\n",
    "                        sub_relation[\"sentence_id\"] = sentence_id\n",
    "                        relations.append(sub_relation)\n",
    "                    continue\n",
    "\n",
    "                # ----------------------------------\n",
    "                # FIX #5: SKIP SELF-LOOP\n",
    "                # ----------------------------------\n",
    "                if subject_phrase.lower().strip() == object_phrase.lower().strip():\n",
    "                    continue\n",
    "\n",
    "                relations.append({\n",
    "\n",
    "                    \"sentence_id\":\n",
    "                        sentence_id,\n",
    "\n",
    "                    \"subject\":\n",
    "                        subject_phrase,\n",
    "\n",
    "                    \"subject_label\":\n",
    "                        entity[\"label\"],\n",
    "\n",
    "                    \"relation\":\n",
    "                        \"adalah\",\n",
    "\n",
    "                    \"object\":\n",
    "                        object_phrase,\n",
    "\n",
    "                    \"object_label\":\n",
    "                        None,\n",
    "\n",
    "                    \"source\":\n",
    "                        \"dependency_rule\",\n",
    "\n",
    "                    \"object_is_clausal\":\n",
    "                        object_has_clause\n",
    "\n",
    "                })\n",
    "\n",
    "                for sub_relation in sub_relations:\n",
    "                    sub_relation[\"sentence_id\"] = sentence_id\n",
    "                    relations.append(sub_relation)\n",
