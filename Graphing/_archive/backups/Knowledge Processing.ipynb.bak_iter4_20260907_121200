    "# ==========================================\n",
    "# 10. HYBRID DICTIONARY-BASED NER\n",
    "# ==========================================\n",
    "\n",
    "# ==========================================\n",
    "# 10.1. LOAD GENERAL NER GAZETTEER\n",
    "# ==========================================\n",
    "\n",
    "from Sastrawi.StopWordRemover.StopWordRemoverFactory import StopWordRemoverFactory\n",
    "from collections import Counter\n",
    "\n",
    "_stopword_factory = StopWordRemoverFactory()\n",
    "INDO_STOPWORDS = set(_stopword_factory.get_stop_words())\n",
    "\n",
    "# Add extra junk words you've spotted in your results file\n",
    "# (words that shouldn't be entities but keep sneaking in)\n",
    "EXTRA_STOPWORDS = {\n",
    "    'kematian', 'lima', 'setiap', 'setiap hari',\n",
    "    'air mata', 'lan', 'masing', 'pras', 'karo'\n",
    "}\n",
    "\n",
    "STOPWORDS = INDO_STOPWORDS | EXTRA_STOPWORDS\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# Known-junk gazetteer entries: words that show up in\n",
    "# 20k_mdee_gazz.txt with a nonsense label (e.g. \"lipstick\"\n",
    "# tagged as an Organisation) and should never be treated\n",
    "# as an entity, regardless of what label the file gives them.\n",
    "# Add to this list as you find more.\n",
    "#\n",
    "# \"gandhi\" is here for a different reason than the rest: it's\n",
    "# not junk in general, it's a genuine name collision. The corpus\n",
    "# uses \"Gandhi\" as a capitalized mantra epithet (\"Om Sang Hyang\n",
    "# Gandhi amurwyani...\"), which passes the capitalization filter\n",
    "# below same as any real proper noun would -- there's no local\n",
    "# signal that distinguishes it from the person. Blocklisting is\n",
    "# the only fix available at the dictionary-matching level.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "GAZETTEER_BLOCKLIST = {\n",
    "    'lipstick',\n",
    "    'ikang',\n",
    "    'pengantar',\n",
    "    'pra',\n",
    "    'eka', 'adi', 'dwi', 'satya', 'devi', 'ii',\n",
    "    'made', 'tambahan', 'sampun', 'kesatuan',\n",
    "    'penurunan', 'sagara',\n",
    "    'gandhi',\n",
    "}\n",
    "\n",
    "\n",
    "def load_general_ner_dictionary(file_path, stopwords=None, blocklist=None):\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # 20k_mdee_gazz.txt is a full annotated corpus: the same\n",
    "    # word can appear many times across many sentences, each\n",
    "    # time with whatever label was correct IN THAT SENTENCE.\n",
    "    # We can't keep per-sentence context here, so instead of\n",
    "    # keeping the FIRST label we ever see for a word (which\n",
    "    # is arbitrary and file-order-dependent), we count every\n",
    "    # label seen for that word and keep the one that shows\n",
    "    # up most often across the whole file.\n",
    "    # ----------------------------------------------------\n",
    "\n",
    "    label_counts = {}\n",
    "    current_entity = []\n",
    "    current_label = None\n",
    "\n",
    "    def record_entity():\n",
    "        if current_entity and current_label:\n",
    "            entity = \" \".join(current_entity).lower()\n",
    "\n",
    "            if stopwords and entity in stopwords:\n",
    "                return\n",
    "\n",
    "            if blocklist and entity in blocklist:\n",
    "                return\n",
    "\n",
    "            if entity not in label_counts:\n",
    "                label_counts[entity] = Counter()\n",
    "\n",
    "            label_counts[entity][current_label] += 1\n",
    "\n",
    "    with open(file_path, \"r\", encoding=\"utf-8\") as file:\n",
    "        for line in file:\n",
    "            line = line.strip()\n",
    "\n",
    "            if not line:\n",
    "                record_entity()\n",
    "                current_entity = []\n",
    "                current_label = None\n",
    "                continue\n",
    "\n",
    "            parts = line.split()\n",
    "            if len(parts) < 2:\n",
    "                continue\n",
    "\n",
    "            token = parts[0]\n",
    "            label = parts[-1]\n",
    "\n",
    "            if label == \"O\":\n",
    "                record_entity()\n",
    "                current_entity = []\n",
    "                current_label = None\n",
    "                continue\n",
    "\n",
    "            if current_label is not None and label != current_label:\n",
    "                record_entity()\n",
    "                current_entity = []\n",
    "\n",
    "            current_entity.append(token)\n",
    "            current_label = label\n",
    "\n",
    "        record_entity()\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # Collapse each word's label counts down to a single\n",
    "    # winner: the most frequent label. Ties go to whichever\n",
    "    # label Counter.most_common() returns first, which is\n",
    "    # stable but arbitrary for exact ties -- if that matters\n",
    "    # for a specific word, override it manually afterward.\n",
    "    # ----------------------------------------------------\n",
    "\n",
    "    dictionary = {\n",
    "        entity: counts.most_common(1)[0][0]\n",
    "        for entity, counts in label_counts.items()\n",
    "    }\n",
    "\n",
    "    return dictionary"
   ]
