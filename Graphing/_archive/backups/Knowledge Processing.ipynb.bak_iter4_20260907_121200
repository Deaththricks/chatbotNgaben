    "# ==========================================\n",
    "# 4. NORMALIZATION (ENTITY-LEVEL, NOT TEXT-LEVEL)\n",
    "# ==========================================\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# IMPORTANT: this dictionary maps spelling/alias variants to a\n",
    "# canonical term (e.g. \"mamukur\"/\"nyekah\"/\"atma wedana\" all ->\n",
    "# \"Ngerorasin\"). It used to be applied as a blanket find/replace\n",
    "# over the WHOLE corpus text before sentence segmentation. That\n",
    "# corrupted the source text itself: e.g. \"Panyekahan/Mamukur\n",
    "# (atma wedana)\" -- where \"(atma wedana)\" is a gloss explaining\n",
    "# what \"Mamukur\" is also called -- became \"ngerorasin (ngerorasin)\"\n",
    "# after BOTH aliases got independently rewritten to the same\n",
    "# canonical form. That destroyed the alias information (exactly\n",
    "# what you'd want to use to MERGE graph nodes) and broke every\n",
    "# downstream sentence/dependency/NER offset back to the original\n",
    "# document.\n",
    "#\n",
    "# Fix: never rewrite the sentence text. Keep a flat lookup instead,\n",
    "# and apply it only to an ALREADY-EXTRACTED entity string (e.g. a\n",
    "# NER hit, or a relation subject/object) to get its canonical form.\n",
    "# The raw surface form the entity was found as stays intact for\n",
    "# traceability; the canonical form is attached alongside it as a\n",
    "# separate field, used for merging matching entities in the graph.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "def build_normalization_lookup(dictionary):\n",
    "\n",
    "    lookup = {}\n",
    "\n",
    "    for category_name, sub_dictionary in dictionary.items():\n",
    "        for old_term, new_term in sub_dictionary.items():\n",
    "            lookup[old_term.lower().strip()] = new_term\n",
    "\n",
    "    return lookup\n",
    "\n",
    "\n",
    "NORMALIZATION_LOOKUP = build_normalization_lookup(\n",
    "    normalization_dictionary\n",
    ")\n",
    "\n",
    "\n",
    "def canonicalize_entity(entity_text):\n",
    "    \"\"\"\n",
    "    Look up the canonical form of an already-extracted entity\n",
    "    string. Falls back to the entity's own text unchanged when it\n",
    "    isn't a known alias -- callers can compare the result to the\n",
    "    input to tell whether a real mapping applied.\n",
    "    \"\"\"\n",
    "\n",
    "    key = entity_text.lower().strip()\n",
    "\n",
    "    return NORMALIZATION_LOOKUP.get(key, entity_text)\n",
    "\n",
    "\n",
    "print(\"\\n=== NORMALIZATION LOOKUP (entity-level) ===\")\n",
    "print(f\"{len(NORMALIZATION_LOOKUP)} known alias -> canonical mappings\")"
