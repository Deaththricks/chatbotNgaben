    "# ==========================================\n",
    "# 8. DUPLICATE REMOVAL\n",
    "# ==========================================\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# Short heading/label lines (e.g. \"Sava Vedana\" used as a\n",
    "# sub-heading) legitimately recur verbatim in different\n",
    "# sections of the corpus -- the same term can head more than\n",
    "# one classification scheme (e.g. it's both one of 5 \"tingkatan\n",
    "# ngaben\" AND, later, one of 3 \"ngaben sesuai keadaan jenazah\").\n",
    "# Each occurrence needs to survive as its own sentence so later\n",
    "# stages (coreference resolving \"ngaben ini\" back to the\n",
    "# nearest preceding heading, etc.) have something to link to.\n",
    "# Deduping globally by exact text silently dropped the SECOND\n",
    "# occurrence as if it were a duplicate, severing that link and\n",
    "# leaving the following \"ngaben ini merupakan...\" sentence with\n",
    "# no real antecedent.\n",
    "#\n",
    "# A genuine duplicate SENTENCE (a full clause repeated\n",
    "# verbatim) is very unlikely to be this short, so only\n",
    "# sentences above the threshold go through dedup -- heading-\n",
    "# length sentences always survive, even if repeated.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "HEADING_LIKE_MAX_TOKENS = 5\n",
    "\n",
    "\n",
    "def remove_duplicate_sentences(\n",
    "    sentences,\n",
    "    tokenized_sentences,\n",
    "    original_sentences\n",
    "):\n",
    "    seen = set()\n",
    "    unique_sentences = []\n",
    "    unique_tokens = []\n",
    "    unique_originals = []\n",
    "\n",
    "    for sentence, tokens, original in zip(\n",
    "        sentences,\n",
    "        tokenized_sentences,\n",
    "        original_sentences\n",
    "    ):\n",
    "        normalized_sentence = sentence.strip()\n",
    "\n",
    "        is_heading_like = len(tokens) <= HEADING_LIKE_MAX_TOKENS\n",
    "\n",
    "        if not is_heading_like:\n",
    "\n",
    "            if normalized_sentence in seen:\n",
    "                continue\n",
    "\n",
    "            seen.add(normalized_sentence)\n",
    "\n",
    "        unique_sentences.append(sentence)\n",
    "        unique_tokens.append(tokens)\n",
    "        unique_originals.append(original)\n",
    "\n",
    "    return unique_sentences, unique_tokens, unique_originals\n",
    "\n",
    "\n",
    "unique_sentences, unique_tokenized_sentences, unique_original_sentences = (\n",
    "    remove_duplicate_sentences(\n",
    "        casefolded_sentences,\n",
    "        tokenized_sentences,\n",
    "        rule_based_sentences\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\n=== AFTER DUPLICATE REMOVAL ===\")\n",
    "for i, sentence in enumerate(unique_sentences, start=1):\n",
    "    print(f\"S{i}: {sentence}\")"
