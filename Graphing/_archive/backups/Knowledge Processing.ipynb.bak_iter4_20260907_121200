    "def pos_tag_sentences(sentences, nlp):\n",
    "\n",
    "    results = []\n",
    "\n",
    "    # PERF: one batched call instead of len(sentences) individual nlp() calls.\n",
    "    # Stanza's tokenize/pos processors are per-sentence with masked padding, so\n",
    "    # batching changes no per-token prediction; each string stays its own\n",
    "    # document. Verified byte-for-byte by audit_tooling/perf_2/verify_stanza_batch.py.\n",
    "    for doc in nlp.bulk_process(list(sentences)):\n",
    "\n",
    "        sentence_result = []\n",
    "\n",
    "        for sent in doc.sentences:\n",
    "\n",
    "            for word in sent.words:\n",
    "\n",
    "                sentence_result.append({\n",
    "                    \"text\": word.text,\n",
    "                    \"upos\": word.upos,\n",
    "                    \"xpos\": word.xpos\n",
    "                })\n",
    "\n",
    "        results.append(sentence_result)\n",
    "\n",
    "    return results\n",
    "\n",
    "pos_results = pos_tag_sentences(\n",
    "    unique_sentences,\n",
    "    nlp\n",
    ")\n",
    "\n",
    "print(\"\\n=== POS TAGGING ===\")\n",
    "\n",
    "for i, sentence_result in enumerate(\n",
    "    pos_results,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    print(f\"\\nS{i}\")\n",
    "\n",
    "    for token in sentence_result:\n",
    "\n",
    "        print(\n",
    "            f\"{token['text']:20} \"\n",
    "            f\"UPOS={token['upos']:6} \"\n",
    "            f\"XPOS={token['xpos']}\"\n",
    "        )"
   ]
