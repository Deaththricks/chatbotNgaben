    "# ==========================================\n",
    "# 5. CANDIDATE SENTENCE BOUNDARY\n",
    "# ==========================================\n",
    "\n",
    "def generate_boundary_candidates(text):\n",
    "\n",
    "    candidates = []\n",
    "\n",
    "    # Pisahkan berdasarkan baris\n",
    "    lines = text.split('\\n')\n",
    "\n",
    "    for line in lines:\n",
    "\n",
    "        line = line.strip()\n",
    "\n",
    "        if not line:\n",
    "            continue\n",
    "\n",
    "        # Hapus bullet\n",
    "        line = re.sub(\n",
    "            r'^[*-]\\s*',\n",
    "            '',\n",
    "            line\n",
    "        )\n",
    "\n",
    "        # Cari tanda baca yang berpotensi\n",
    "        # menjadi batas kalimat\n",
    "        for match in re.finditer(\n",
    "            r'[.!?]',\n",
    "            line\n",
    "        ):\n",
    "\n",
    "            position = match.start()\n",
    "\n",
    "            # Teks sebelum tanda baca\n",
    "            left = line[:position + 1].strip()\n",
    "\n",
    "            # Teks setelah tanda baca\n",
    "            right = line[position + 1:].strip()\n",
    "\n",
    "            # Kalau tidak ada teks setelah tanda baca,\n",
    "            # tidak perlu dijadikan kandidat\n",
    "            if not right:\n",
    "                continue\n",
    "\n",
    "            # Konteks di sekitar kandidat\n",
    "            context = (\n",
    "                left[-100:]\n",
    "                + \" \"\n",
    "                + right[:100]\n",
    "            )\n",
    "\n",
    "            candidates.append({\n",
    "                \"context\": context,\n",
    "                \"left\": left,\n",
    "                \"right\": right,\n",
    "                \"position\": position\n",
    "            })\n",
    "\n",
    "    return candidates"
   ]
