    "# 13.9. TYPE THE RELATION OBJECTS\n",
    "# ==========================================\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# Right now every relation's object_label is None,\n",
    "# because the object phrase (e.g. \"merajan\") was never\n",
    "# checked against the entity dictionaries. This looks\n",
    "# it up the same way NER does, so objects that ARE\n",
    "# known ritual terms get properly labeled instead of\n",
    "# floating as untyped text.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "COMBINED_ENTITY_DICTIONARY = {\n",
    "    **general_ner_dictionary,\n",
    "    **cultural_dictionary,   # cultural wins on overlap, same as your NER merge\n",
    "}\n",
    "\n",
    "# PERF: lookup_entity_label's buried-word fallback used to re-sort this whole\n",
    "# ~12k-entry dict and rebuild + recompile ~12k word-boundary pattern STRINGS on\n",
    "# every call (once per relation, twice for synthetic sub-relations) -- the exact\n",
    "# anti-pattern the dictionary_ner comment (section 10.4) warns about. Build the\n",
    "# longest-key-first list of (entity, label, compiled_pattern) ONCE here. Stable\n",
    "# sort of a dict that is constant from here on => identical iteration order =>\n",
    "# identical first-match/longest-first result; compiled.search(s) is identical to\n",
    "# re.search(pattern_str, s) with no flags. Purely a speedup (verified byte-for-byte\n",
    "# by audit_tooling/perf_2 / verify_lookup_entity_label.py).\n",
    "_ENTITY_LABEL_LOOKUP = [\n",
    "    (entity, label, re.compile(r'(?<!\\w)' + re.escape(entity) + r'(?!\\w)'))\n",
    "    for entity, label in sorted(\n",
    "        COMBINED_ENTITY_DICTIONARY.items(),\n",
    "        key=lambda x: len(x[0]),\n",
    "        reverse=True\n",
    "    )\n",
    "]\n",
    "\n",
    "\n",
    "def lookup_entity_label(phrase, dictionary, exact_only=False):\n",
    "\n",
    "    phrase_lower = phrase.lower().strip()\n",
    "\n",
    "    if phrase_lower in dictionary:\n",
    "        return dictionary[phrase_lower]\n",
    "\n",
    "    # Synthetic (object-decomposition) subjects / objects are already terse\n",
    "    # content phrases -- trust only an exact whole-phrase dictionary hit for\n",
    "    # them, never the buried-substring fallback (\"pengorbanan suci\" must not\n",
    "    # borrow RITUAL from the bare word \"suci\").\n",
    "    if exact_only:\n",
    "        return None\n",
    "\n",
    "    # FIX #27: the buried-word fallback below borrows a label from ANY\n",
    "    # dictionary key that appears somewhere inside the phrase. For a\n",
    "    # relative-clause / long descriptive object (\"kawangen yang perlu\n",
    "    # dibuat antara lain\", \"simbol perpisahan antara yang meninggal...\")\n",
    "    # that word is not the object's identity -- it was the root cause of\n",
    "    # clause objects being typed ENTITY with a wrong Place/RITUAL label.\n",
    "    # Skip the fallback for anything that reads as a description.\n",
    "    if len(phrase_lower.split()) > 5 or re.search(r'(?<!\\w)(yang|yaitu|yakni)(?!\\w)', phrase_lower):\n",
    "        return None\n",
    "\n",
    "    # Fallback: a dictionary entry appearing as a whole word inside the\n",
    "    # object text, e.g. \"sekah kangsen di merajan\" -> \"merajan\".\n",
    "    # Iterates the module-level precompiled list (built from\n",
    "    # COMBINED_ENTITY_DICTIONARY, which is what both call sites pass) in the\n",
    "    # identical longest-key-first order the old inline sort produced.\n",
    "    for entity, label, pattern in _ENTITY_LABEL_LOOKUP:\n",
    "        match = pattern.search(phrase_lower)\n",
    "        if not match:\n",
    "            continue\n",
    "        # FIX #27: Place / Person gazetteer keys are common lowercase\n",
    "        # words (petani, kerajaan, kecamatan) -- require capitalisation in\n",
    "        # the source phrase, mirroring the NER stage's\n",
    "        # require_capital_for_labels={'Place', 'Person'}.\n",
    "        if label in ('Place', 'Person') and not phrase[match.start():match.end()][:1].isupper():\n",
    "            continue\n",
    "        return label\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "for relation in relations:\n",
    "    relation[\"object_label\"] = lookup_entity_label(\n",
    "        relation[\"object\"],\n",
    "        COMBINED_ENTITY_DICTIONARY,\n",
    "        exact_only=relation.get(\"_synthetic\", False),\n",
    "    )\n",
    "\n",
    "# Synthetic sub-relations from recursive object decomposition carry\n",
    "# subject_label=None + a _needs_subject_lookup flag -- re-type their\n",
    "# subject the same way (exact hit only), then drop the transient flags\n",
    "# so they never reach the saved output.\n",
    "for relation in relations:\n",
    "    if relation.pop(\"_needs_subject_lookup\", False):\n",
    "        relation[\"subject_label\"] = lookup_entity_label(\n",
    "            relation[\"subject\"],\n",
    "            COMBINED_ENTITY_DICTIONARY,\n",
    "            exact_only=True,\n",
    "        )\n",
    "    relation.pop(\"_synthetic\", None)\n",
    "\n",
    "# ==========================================\n",
    "# 13.9e. CLASSIFY OBJECT AS ENTITY OR LITERAL\n",
    "# ==========================================\n",
    "\n",
    "# For knowledge-graph ingestion: an ENTITY becomes a graph node, a\n",
    "# LITERAL becomes a text property on the subject node. A definition's\n",
    "# object that's a full rendered clause (object_is_clausal=True, e.g.\n",
    "# \"jenazah dibaringkan di rumah adat dalam jangka waktu...\") must\n",
    "# never become a node -- that's exactly the long-form-entity mistake\n",
    "# a KG schema needs to avoid. A dictionary-recognized object is a\n",
    "# real domain concept (ENTITY).\n",
    "#\n",
    "# FIX #1c (report Section 1c): everything else now defaults to\n",
    "# LITERAL, full stop -- the old fallback (\"unrecognized + <=6 words\n",
    "# -> ENTITY\") was wrong far more often than right: ratios (\"3:2:2\"),\n",
    "# plain measurements (\"panjang 1.600 depa\"), and generic descriptive\n",
    "# noun phrases (\"balai posisi kepala berhulu utara\", \"dua kata\",\n",
    "# \"pemberhentian keanggotaan desa adat\") all got typed ENTITY just\n",
    "# because they were short and happened not to be in the dictionary\n",
    "# yet -- none of them is a graph-worthy concept. A dictionary match\n",
    "# is a far more reliable ENTITY signal than word count ever was, so\n",
    "# the length threshold is dropped entirely rather than kept as a\n",
    "# secondary check.\n",
    "\n",
    "def classify_object_kind(relation):\n",
    "\n",
    "    if relation.get(\"object_is_clausal\"):\n",
    "        return \"LITERAL\"\n",
    "\n",
    "    if relation.get(\"object_label\") is not None:\n",
    "        return \"ENTITY\"\n",
    "\n",
    "    return \"LITERAL\"\n",
    "\n",
    "\n",
    "for relation in relations:\n",
    "    relation[\"object_kind\"] = classify_object_kind(relation)\n",
    "\n",
    "# ==========================================\n",
    "# 13.9b. ADD SOURCE TEXT FOR CROSS-CHECKING\n",
    "# ==========================================\n",
    "\n",
    "# unique_original_sentences is the raw, pre-normalization\n",
    "# version of each sentence (before lowercasing/cleaning),\n",
    "# aligned to sentence_id -- exactly what you'd search for\n",
    "# in the original merged .txt file to verify a relation.\n",
    "\n",
    "original_sentence_lookup = {\n",
    "    sid: original\n",
    "    for sid, original in enumerate(\n",
    "        unique_original_sentences,\n",
    "        start=1\n",
    "    )\n",
    "}\n",
    "\n",
    "for relation in relations:\n",
    "    relation[\"source_text\"] = original_sentence_lookup.get(\n",
    "        relation[\"sentence_id\"],\n",
    "        None\n",
    "    )\n",
    "\n",
    "# ==========================================\n",
    "# 13.10. MERGE DUPLICATE RELATION NAMES INTO A\n",
    "#        CONTROLLED PREDICATE TAXONOMY\n",
    "# ==========================================\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# The raw predicate label was derive_raw_relation_label()'s output\n",
    "# (13.3c) -- whatever Indonesian verb sense actually governed the\n",
    "# sentence, after surface-text disambiguation. Across this corpus\n",
    "# this produced well over a hundred distinct raw labels, many used\n",
    "# only once, because it's really just recording which verb/sense\n",
    "# was used, not a controlled schema. A graph with that many near-\n",
    "# singleton edge types can't be queried consistently (there's no\n",
    "# single edge to traverse for \"location\" or \"part-of\").\n",
    "#\n",
    "# This groups the raw labels into a small, fixed set of Indonesian\n",
    "# relation CATEGORIES (per the revision2 report) -- \"relation\" is\n",
    "# no longer a reworded paraphrase of the verb, it's a controlled\n",
    "# classification tag written in plain, everyday Indonesian, e.g.\n",
    "# ADALAH, BAGIAN_DARI, MEMILIKI, BERADA_DI, DIPAKAI_UNTUK,\n",
    "# DITUJUKAN_UNTUK, MELAMBANGKAN, DIKENAI, DIPERSEMBAHKAN_KEPADA.\n",
    "#\n",
    "# Labels not yet in this table fall through unchanged (as their\n",
    "# derived raw label) rather than crashing -- extend the table as\n",
    "# more turn up on future corpus updates.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "RELATION_TAXONOMY = {\n",
    "    # The cascade in 13.3c now emits FINAL natural predicates directly. This\n",
    "    # table only merges a few near-synonyms produced by different branches.\n",
    "    # (Everything else falls through 13.10's .get(raw, raw.upper()) unchanged.)\n",
    "    \"DIGUNAKAN_UNTUK\":   \"DIPAKAI_UNTUK\",\n",
    "    \"DITUJUKAN_KEPADA\":  \"DITUJUKAN_UNTUK\",\n",
    "    \"DIMOHONKAN_KEPADA\": \"DIMOHON_DARI\",\n",
    "    \"DIPUJA_DI\":         \"DIPUJA\",\n",
    "    \"DIIRINGI\":          \"DISERTAI\",\n",
    "    \"DIPEROLEH\":         \"MEMPEROLEH\",\n",
    "    \"DIHASILKAN\":        \"MENGHASILKAN\",\n",
    "}\n",
    "\n",
    "for relation in relations:\n",
    "    raw = relation[\"relation\"]\n",
    "    # bucketed labels come from the table (already all-caps); anything\n",
    "    # not in the table is an un-grouped raw predicate -- upper-case it\n",
    "    # too so EVERY relation label in the output is uniformly all-caps.\n",
    "    relation[\"relation\"] = RELATION_TAXONOMY.get(raw, raw.upper())\n",
    "\n",
    "# AUDIT (Iteration 3): \"LAINNYA\" is voiced_surface_label()'s own last-resort\n",
    "# marker for \"this verb carries no relation sense on its own\" (13.3d) -- it\n",
    "# was shipping as a literal, useless relation label in the output (S1523,\n",
    "# S1629, S1850, S2269, S2340, S2810, S3295, S3330, S3651, S3742...). Same\n",
    "# philosophy as VERB_STUB_OBJECTS below: drop rather than guess at a better\n",
    "# label with no reliable signal.\n",
    "relations = [relation for relation in relations if relation[\"relation\"] != \"LAINNYA\"]\n",
    "\n",
    "# ==========================================\n",
    "# 13.10c. DROP TRIPLES WITH A BARE FUNCTION-WORD OBJECT\n",
    "# ==========================================\n",
    "\n",
    "FUNCTION_WORD_OBJECTS = SUB_OBJECT_STOPWORDS | {\n",
    "    \"tadi\", \"situ\", \"sini\", \"sana\", \"demikian\", \"semua\", \"mesti\", \"hal\", \"cara\",\n",
    "    \"nanti\", \"kaki\", \"kepala\", \"arti\", \"makna\", \"istilah\", \"maksud\", \"sesuatu\",\n",
    "    \"semacam\", \"begitu\", \"sendiri\", \"berikut\", \"misal\", \"misalnya\", \"keadaan\",\n",
    "    \"posisi\", \"kenyataan\", \"sesuatunya\",\n",
    "    \"secukupnya\", \"khusuknya\", \"seperlunya\", \"seadanya\", \"sepenuhnya\",\n",
    "    \"semestinya\", \"selengkapnya\", \"sewajarnya\", \"sebaik-baiknya\", \"seikhlasnya\",\n",
    "    \"senantiasa\", \"sedemikian\",\n",
    "    \"atas\", \"bawah\", \"dalam\", \"luar\", \"depan\", \"belakang\", \"tengah\", \"samping\",\n",
    "    \"luanan\", \"teben\", \"hulu\", \"hilir\", \"kiri\", \"kanan\", \"muka\",\n",
    "}\n",
    "# AUDIT (Iteration 3, S3758): this filter is meant to catch bare-fragment\n",
    "# objects from AUTO-extraction (\"X DILETAKKAN_DI atas\") -- it was also\n",
    "# silently dropping deliberately-curated manual_override rows whose object\n",
    "# happens to collide with one of these words for real (e.g. \"logam campuran\n",
    "# BERADA_DI tengah\" -- \"tengah\" is in this list). Manual overrides are\n",
    "# hand-verified, not raw fragments -- exempt them.\n",
    "relations = [\n",
    "    relation for relation in relations\n",
    "    if relation.get(\"source\") == \"manual_override\"\n",
    "    or relation[\"object\"].strip().lower() not in FUNCTION_WORD_OBJECTS\n",
    "]\n",
    "\n",
    "# AUDIT S4 (backstop): an object that is itself a bare (often inflected) verb\n",
    "# or a copula stub says nothing -- \"X ADALAH berbentuk / menjadi / merupakan\".\n",
    "VERB_STUB_OBJECTS = {\n",
    "    \"berbentuk\", \"berwujud\", \"berupa\", \"menjadi\", \"merupakan\", \"adalah\",\n",
    "    \"ialah\", \"bertujuan\", \"berfungsi\", \"berarti\", \"bermakna\", \"terbuat\",\n",
    "    \"terjadi\", \"hilang\", \"sirna\", \"musnah\", \"mantrai\", \"dimantrai\",\n",
    "    \"berbadankan\", \"berlangsung\", \"dilakukan\", \"dilaksanakan\", \"digunakan\",\n",
    "}\n",
    "relations = [\n",
    "    relation for relation in relations\n",
    "    if relation[\"object\"].strip().lower() not in VERB_STUB_OBJECTS\n",
    "]\n",
    "\n",
    "# AUDIT S13: \"menurut para ahli / tata cara / ketentuan\" is source/manner\n",
    "# attribution, not a relation.\n",
    "_MENURUT_ATTRIBUTION_OBJECTS = {\n",
    "    \"ahli\", \"para ahli\", \"pendapat\", \"tata cara\", \"cara\", \"ketentuan\",\n",
    "    \"aturan\", \"semestinya\", \"mestinya\", \"kebiasaan\", \"tata\",\n",
    "}\n",
    "relations = [\n",
    "    relation for relation in relations\n",
    "    if not (relation[\"relation\"] == \"MENURUT\"\n",
    "            and relation[\"object\"].strip().lower() in _MENURUT_ATTRIBUTION_OBJECTS)\n",
    "]\n",
    "\n",
    "# AUDIT S13 (Iteration 1, widened): the exact-match list above only fires\n",
    "# when the LABEL already came out \"MENURUT\" -- but the same source/\n",
    "# citation adjunct (\"dalam lontar X\", \"sebagaimana disinggung/diuraikan/\n",
    "# tertulis dalam...\", \"di mata umat hindu\") gets glued onto an object under\n",
    "# all sorts of OTHER labels (DIKENAL_SEBAGAI, TERTULIS, DISINGGUNG_DI,\n",
    "# DIURAIKAN, DINILAI_DI, MEMILIKI...) depending on which verb the parser\n",
    "# happened to land on. Match on the OBJECT CONTENT instead of the relation\n",
    "# label -- \"zero relations rather than a wrong/meaningless one\".\n",
    "_ATTRIBUTION_OBJECT_PATTERN = re.compile(\n",
    "    r\"\\b(menurut|sebagaimana|dalam\\s+(?:\\w+\\s+)?lontar|pada lontar\"\n",
    "    r\"|lontar (yama|petunjuk)|uraian terdahulu|lembaran terdahulu\"\n",
    "    r\"|mata (umat|orang))\\b\",\n",
    "    re.IGNORECASE,\n",
    ")\n",
    "relations = [\n",
    "    relation for relation in relations\n",
    "    if not _ATTRIBUTION_OBJECT_PATTERN.search(relation[\"object\"])\n",
    "]\n",
    "\n",
    "# AUDIT D10 (Iteration 2): a bare, unqualified \"lontar\" object is always\n",
    "# a truncated citation reference in this corpus (the surrounding \"dalam\n",
    "# lontar X\" context gets lost during decomposition, leaving just the\n",
    "# word itself) -- never real content about the subject.\n",
    "relations = [\n",
    "    relation for relation in relations\n",
    "    if relation[\"object\"].strip().lower() != \"lontar\"\n",
    "]\n",
    "\n",
    "# AUDIT S9: object_decomposition self-restatements -- \"X MELAMBANGKAN lambang\",\n",
    "# \"X MELAMBANGKAN simbol\", \"X ADALAH hal/sesuatu\".\n",
    "_SELF_RESTATE = {\n",
    "    \"MELAMBANGKAN\": SYMBOL_NOUNS,\n",
    "    \"ADALAH\": {\"hal\", \"sesuatu\", \"sesuatunya\", \"bagian\"},\n",
    "    \"BERPERAN_SEBAGAI\": SYMBOL_NOUNS,\n",
    "}\n",
    "relations = [\n",
    "    relation for relation in relations\n",
    "    if not (relation[\"relation\"] in _SELF_RESTATE\n",
    "            and relation[\"object\"].strip().lower() in _SELF_RESTATE[relation[\"relation\"]])\n",
    "]\n",
    "\n",
    "# AUDIT D12 (Iteration 3, Stage 7): dedup helper defined earlier (before the\n",
    "# RUN EXTRACTION cut, so it's directly unit-testable) -- applied here to\n",
    "# every already-extracted relation's final subject/object text.\n",
    "for relation in relations:\n",
    "    relation[\"subject\"] = _dedupe_repeated_phrase_fragment(relation[\"subject\"])\n",
    "    relation[\"object\"] = _dedupe_repeated_phrase_fragment(relation[\"object\"])\n",
    "\n",
    "# AUDIT D14 (Iteration 2): subject and object resolving to the same\n",
    "# referent (spelled two ways) carries no information -- \"kwangen jeriji\n",
    "# DITARUH kawangen jeriji\" (S3733). The exact-match self-loop guards at\n",
    "# each extraction call site (FIX #5 etc.) don't catch spelling variants;\n",
    "# this final pass does, for the handful this corpus uses interchangeably.\n",
    "_SELF_LOOP_SPELLING_VARIANTS = {\"kwangen\": \"kawangen\"}\n",
    "\n",
    "\n",
    "def _normalize_for_self_loop(text):\n",
    "    words = re.sub(r\"[^a-z0-9\\s]\", \"\", text.lower()).split()\n",
    "    words = [_SELF_LOOP_SPELLING_VARIANTS.get(w, w) for w in words]\n",
    "    return \" \".join(words)\n",
    "\n",
    "\n",
    "relations = [\n",
    "    relation for relation in relations\n",
    "    if _normalize_for_self_loop(relation[\"subject\"])\n",
    "    != _normalize_for_self_loop(relation[\"object\"])\n",
    "]\n",
    "\n",
    "# ==========================================\n",
    "# 13.10b. REMOVE DUPLICATE RELATIONS\n",
    "# ==========================================\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# Two relations are duplicates if they say the exact\n",
    "# same thing: same sentence, same subject, same\n",
    "# (post-taxonomy) relation type, same object. Object/\n",
    "# subject labels aren't part of the key because they're\n",
    "# derived from the subject/object text, so they're\n",
    "# already identical whenever the rest is. Keep only the\n",
    "# first occurrence, drop the rest.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "seen_relations = set()\n",
    "deduped_relations = []\n",
    "\n",
    "for relation in relations:\n",
    "\n",
    "    key = (\n",
    "        relation[\"sentence_id\"],\n",
    "        relation[\"subject\"].lower().strip(),\n",
    "        relation[\"relation\"],\n",
    "        relation[\"object\"].lower().strip(),\n",
    "    )\n",
    "\n",
    "    if key in seen_relations:\n",
    "        continue\n",
    "\n",
    "    seen_relations.add(key)\n",
    "    deduped_relations.append(relation)\n",
    "\n",
    "relations = deduped_relations\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 13.11. DISPLAY (WITH OBJECT LABELS)\n",
    "# ==========================================\n",
    "\n",
    "print(\"\\n=== RELATION EXTRACTION (TYPED) ===\")\n",
    "\n",
    "for relation in sorted(relations, key=lambda r: r[\"sentence_id\"]):\n",
    "\n",
    "    print(\n",
    "        f\"S{relation['sentence_id']} | \"\n",
    "        f\"{relation['subject']} ({relation['subject_label']}) \"\n",
    "        f\"-> {relation['relation']} \"\n",
    "        f\"-> {relation['object']} ({relation['object_label']})\"\n",
    "    )\n"
   ]
  },
