    "# ----------------------------------------------------\n",
    "# LEMMA CORRECTIONS: Stanza's Indonesian lemmatizer\n",
    "# occasionally mangles a word (e.g. it lemmatizes\n",
    "# \"merepresentasikan\" to \"represtasi\" instead of\n",
    "# \"representasi\", or keeps the imperative suffix \"-lah\" on\n",
    "# \"diberilah\" instead of stemming it to \"beri\"). Patch\n",
    "# known-bad lemmas here, right after parsing, so every\n",
    "# downstream step (relation extraction, negation checks,\n",
    "# etc.) sees the corrected form. Extend this dict if more\n",
    "# bad lemmas turn up.\n",
    "#\n",
    "# \"blokir/disengker\" (from source text \"diblokir/disengker\",\n",
    "# tokenized as ONE token because it has no surrounding\n",
    "# spaces) is a malformed slash-joined lemma -- correcting it\n",
    "# to \"blokir\" lets RELATION_TAXONOMY (relation extraction,\n",
    "# section 13) canonicalize it like any other verb instead of\n",
    "# emitting a relation label with a stray \"/\" in it.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "LEMMA_CORRECTIONS = {\n",
    "    \"represtasi\": \"representasi\",\n",
    "    \"berilah\": \"beri\",\n",
    "    \"blokir/disengker\": \"blokir\",\n",
    "}\n",
