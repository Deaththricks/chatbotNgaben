    "# ==========================================\n",
    "# 11.2. FIND ANTECEDENT CANDIDATES\n",
    "# ==========================================\n",
    "\n",
    "def find_antecedent_candidates(\n",
    "    mention,\n",
    "    df_ner\n",
    "):\n",
    "\n",
    "    sentence_id = mention[\"sentence_id\"]\n",
    "\n",
    "    # ======================================\n",
    "    # Ambil entity dari kalimat sebelumnya\n",
    "    # ======================================\n",
    "\n",
    "    previous_sentence_id = sentence_id - 1\n",
    "\n",
    "    candidates = df_ner[\n",
    "        df_ner[\"sentence_id\"]\n",
    "        == previous_sentence_id\n",
    "    ].copy()\n",
    "\n",
    "    # Jika tidak ada entity pada kalimat\n",
    "    # sebelumnya, baru cari 2 kalimat sebelumnya\n",
    "    if candidates.empty:\n",
    "\n",
    "        previous_sentence_id = sentence_id - 2\n",
    "\n",
    "        candidates = df_ner[\n",
    "            df_ner[\"sentence_id\"]\n",
    "            == previous_sentence_id\n",
    "        ].copy()\n",
    "\n",
    "    # Jika masih kosong, ambil entity\n",
    "    # dari beberapa kalimat sebelumnya\n",
    "    if candidates.empty:\n",
    "\n",
    "        candidates = df_ner[\n",
    "            df_ner[\"sentence_id\"]\n",
    "            < sentence_id\n",
    "        ].copy()\n",
    "\n",
    "        candidates = candidates.tail(5)\n",
    "\n",
    "    return candidates\n",
    "\n",
    "# ==========================================\n",
    "# 11.3. DISPLAY CANDIDATES\n",
    "# ==========================================\n",
    "\n",
    "print(\"\\n=== COREFERENCE CANDIDATES ===\")\n",
    "\n",
    "for mention in coreference_mentions:\n",
    "\n",
    "    print(\n",
    "        f\"\\nMention: \"\n",
    "        f\"{mention['mention']}\"\n",
    "        f\" (S{mention['sentence_id']})\"\n",
    "    )\n",
    "\n",
    "    candidates = find_antecedent_candidates(\n",
    "        mention,\n",
    "        df_ner\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        candidates[\n",
    "            [\n",
    "                \"sentence_id\",\n",
    "                \"entity\",\n",
    "                \"label\",\n",
    "                \"source\"\n",
    "            ]\n",
    "        ].to_string(index=False)\n",
    "    )"
