    "# ==========================================\n",
    "# 11. COREFERENCE RESOLUTION\n",
    "# ==========================================\n",
    "\n",
    "COREFERENCE_PATTERNS = [\n",
    "    \"ini\",\n",
    "    \"itu\",\n",
    "    \"tersebut\",\n",
    "    \"hal ini\",\n",
    "    \"hal tersebut\",\n",
    "    \"upacara ini\",\n",
    "    \"upacara tersebut\",\n",
    "    \"ritual ini\",\n",
    "    \"ritual tersebut\"\n",
    "]\n",
    "\n",
    "\n",
    "def find_coreference_mentions(sentences):\n",
    "\n",
    "    mentions = []\n",
    "\n",
    "    for sentence_id, sentence in enumerate(\n",
    "        sentences,\n",
    "        start=1\n",
    "    ):\n",
    "\n",
    "        sentence_lower = sentence.lower()\n",
    "\n",
    "        for pattern in COREFERENCE_PATTERNS:\n",
    "\n",
    "            matches = re.finditer(\n",
    "                r'(?<!\\w)'\n",
    "                + re.escape(pattern)\n",
    "                + r'(?!\\w)',\n",
    "                sentence_lower\n",
    "            )\n",
    "\n",
    "            for match in matches:\n",
    "\n",
    "                mentions.append({\n",
    "\n",
    "                    \"sentence_id\":\n",
    "                        sentence_id,\n",
    "\n",
    "                    \"mention\":\n",
    "                        match.group(),\n",
    "\n",
    "                    \"start\":\n",
    "                        match.start(),\n",
    "\n",
    "                    \"end\":\n",
    "                        match.end(),\n",
    "\n",
    "                    \"sentence\":\n",
    "                        sentence\n",
    "\n",
    "                })\n",
    "\n",
    "    return mentions\n",
    "\n",
    "coreference_mentions = find_coreference_mentions(\n",
    "    unique_sentences\n",
    ")\n",
    "\n",
    "print(\"\\n=== COREFERENCE MENTIONS ===\")\n",
    "\n",
    "for mention in coreference_mentions:\n",
    "\n",
    "    print(\n",
    "        f\"S{mention['sentence_id']}: \"\n",
    "        f\"{mention['mention']}\"\n",
    "    )"
   ]
