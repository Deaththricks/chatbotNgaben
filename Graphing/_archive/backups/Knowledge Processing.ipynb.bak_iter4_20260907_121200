    "# ==========================================\n",
    "# 10.6. MERGE GENERAL + CULTURAL NER\n",
    "# ==========================================\n",
    "\n",
    "def merge_ner_results(\n",
    "    general_results,\n",
    "    cultural_results\n",
    "):\n",
    "\n",
    "    hybrid_results = []\n",
    "\n",
    "    for general_result, cultural_result in zip(\n",
    "        general_results,\n",
    "        cultural_results\n",
    "    ):\n",
    "\n",
    "        # Ambil entity cultural terlebih dahulu\n",
    "        cultural_entities = (\n",
    "            cultural_result[\"entities\"]\n",
    "        )\n",
    "\n",
    "        general_entities = (\n",
    "            general_result[\"entities\"]\n",
    "        )\n",
    "\n",
    "        selected_entities = []\n",
    "\n",
    "        # ----------------------------------\n",
    "        # 1. Masukkan CULTURAL entity\n",
    "        # ----------------------------------\n",
    "\n",
    "        for entity in cultural_entities:\n",
    "\n",
    "            entity[\"source\"] = \"cultural\"\n",
    "\n",
    "            selected_entities.append(\n",
    "                entity\n",
    "            )\n",
    "\n",
    "        # ----------------------------------\n",
    "        # 2. Masukkan GENERAL entity\n",
    "        #    jika tidak overlap\n",
    "        # ----------------------------------\n",
    "\n",
    "        for general_entity in general_entities:\n",
    "\n",
    "            overlap = False\n",
    "\n",
    "            for cultural_entity in cultural_entities:\n",
    "\n",
    "                # cek apakah posisi entity\n",
    "                # saling bertabrakan\n",
    "\n",
    "                if (\n",
    "                    general_entity[\"start\"]\n",
    "                    < cultural_entity[\"end\"]\n",
    "                    and\n",
    "                    general_entity[\"end\"]\n",
    "                    > cultural_entity[\"start\"]\n",
    "                ):\n",
    "\n",
    "                    overlap = True\n",
    "                    break\n",
    "\n",
    "            # General entity hanya\n",
    "            # dimasukkan jika tidak overlap\n",
    "            if not overlap:\n",
    "\n",
    "                general_entity[\"source\"] = \"general\"\n",
    "\n",
    "                selected_entities.append(\n",
    "                    general_entity\n",
    "                )\n",
    "\n",
    "        # ----------------------------------\n",
    "        # 3. Urutkan berdasarkan posisi\n",
    "        # ----------------------------------\n",
    "\n",
    "        selected_entities = sorted(\n",
    "            selected_entities,\n",
    "            key=lambda x: x[\"start\"]\n",
    "        )\n",
    "\n",
    "        hybrid_results.append({\n",
    "\n",
    "            \"sentence_id\":\n",
    "                general_result[\"sentence_id\"],\n",
    "\n",
    "            \"sentence\":\n",
    "                general_result[\"sentence\"],\n",
    "\n",
    "            \"entities\":\n",
    "                selected_entities\n",
    "\n",
    "        })\n",
    "\n",
    "    return hybrid_results"
