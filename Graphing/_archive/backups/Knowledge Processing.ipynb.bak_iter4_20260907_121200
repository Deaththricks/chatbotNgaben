    "# 12. DEPENDENCY PARSING\n",
    "# ==========================================\n",
    "\n",
    "import stanza\n",
    "\n",
    "# Model Bahasa Indonesia sudah didownload,\n",
    "# jadi tidak perlu stanza.download() lagi\n",
    "\n",
    "nlp = stanza.Pipeline(\n",
    "    lang=\"id\",\n",
    "    processors=\"tokenize,mwt,pos,lemma,depparse\",\n",
    "    use_gpu=False\n",
    ")\n",
    "\n",
    "\n",
    "def dependency_parsing(\n",
    "    sentences,\n",
    "    nlp\n",
    "):\n",
    "\n",
    "    results = []\n",
    "\n",
    "    # PERF: one batched nlp() call instead of len(sentences) individual calls.\n",
    "    # Stanza's processors are per-sentence with masked padding so batching\n",
    "    # changes no per-token prediction, and each string stays its own document so\n",
    "    # the per-document sentence splitting below (the Sxx.2 sub-sentence case) is\n",
    "    # unchanged. Verified byte-for-byte by audit_tooling/perf_2/verify_stanza_batch.py.\n",
    "    for sentence_id, doc in enumerate(\n",
    "        nlp.bulk_process(list(sentences)),\n",
    "        start=1\n",
    "    ):\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Stanza does its own internal sentence detection. Almost\n",
    "        # always doc.sentences has exactly one entry, since our\n",
    "        # segmentation already split the text into single\n",
    "        # sentences -- but if a residual multi-clause input slips\n",
    "        # through, Stanza will find more than one. The old code\n",
    "        # flattened every sub-sentence's tokens into one list under\n",
    "        # a single sentence_id without renumbering, which silently\n",
    "        # produced duplicate token ids/head references and broken\n",
    "        # (multi-root) trees. Now each Stanza-detected sub-sentence\n",
    "        # is kept as its own result entry instead, so ids/heads\n",
    "        # stay internally consistent and every \"sentence\" in the\n",
    "        # output is a single real tree.\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        for sub_index, sent in enumerate(doc.sentences):\n",
    "\n",
    "            tokens = []\n",
    "\n",
    "            for word in sent.words:\n",
    "\n",
    "                tokens.append({\n",
    "\n",
    "                    \"id\": word.id,\n",
    "\n",
    "                    \"text\": word.text,\n",
    "\n",
    "                    \"lemma\": word.lemma,\n",
    "\n",
    "                    \"upos\": word.upos,\n",
    "\n",
    "                    \"head\": word.head,\n",
    "\n",
    "                    \"deprel\": word.deprel\n",
    "\n",
    "                })\n",
    "\n",
    "            result_sentence_id = (\n",
    "                sentence_id if sub_index == 0\n",
    "                else f\"{sentence_id}.{sub_index + 1}\"\n",
    "            )\n",
    "\n",
    "            results.append({\n",
    "\n",
    "                \"sentence_id\":\n",
    "                    result_sentence_id,\n",
    "\n",
    "                \"sentence\":\n",
    "                    sent.text,\n",
    "\n",
    "                \"tokens\":\n",
    "                    tokens\n",
    "\n",
    "            })\n",
    "\n",
    "    return results"
   ]
