    "# ----------------------------------------------------\n",
    "# FRONT/BACK-MATTER STRIPPING\n",
    "#\n",
    "# Data/ngaben-merge-cleaned.txt is a merge of several source\n",
    "# books. At the boundary between two merged books, the merge\n",
    "# keeps that book's own front matter -- a title, then a block\n",
    "# delimited by \"________________\" separator lines containing\n",
    "# a heading like \"KATA PENGANTAR\" (foreword), the author's\n",
    "# acknowledgments (naming a dean, an editor, a spouse, children\n",
    "# and grandchildren by name), and a closing signature/date. None\n",
    "# of that is ritual content. Left in, it pollutes NER with bogus\n",
    "# Person/Place hits pulled from people's names and institution\n",
    "# names (e.g. \"I Made\", \"Anak Agung Herry\", \"Indonesia Denpasar\").\n",
    "#\n",
    "# The merge convention is: a block bounded by \"________________\"\n",
    "# separator lines, whose first heading line is a front/back-matter\n",
    "# marker (foreword, acknowledgments, table of contents, bibliography,\n",
    "# author bio, ...). Only blocks matching BOTH the separator\n",
    "# convention AND a known marker heading are removed, so this stays\n",
    "# safe if more books are merged into the corpus later -- it won't\n",
    "# touch ordinary ritual content, which never uses this convention.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "FRONT_BACK_MATTER_HEADINGS = {\n",
    "    \"kata pengantar\",\n",
    "    \"prakata\",\n",
    "    \"sambutan\",\n",
    "    \"ucapan terima kasih\",\n",
    "    \"daftar isi\",\n",
    "    \"daftar pustaka\",\n",
    "    \"riwayat hidup\",\n",
    "    \"tentang penulis\",\n",
    "    \"biodata penulis\",\n",
    "}\n",
    "\n",
    "\n",
    "def strip_front_back_matter(text):\n",
    "\n",
    "    blocks = re.split(r'\\n_{5,}\\n', text)\n",
    "\n",
    "    if len(blocks) == 1:\n",
    "        return text\n",
    "\n",
    "    kept_blocks = []\n",
    "\n",
    "    for block in blocks:\n",
    "\n",
    "        first_line = \"\"\n",
    "\n",
    "        for line in block.split('\\n'):\n",
    "            line = line.strip()\n",
    "            if line:\n",
    "                first_line = line.lower()\n",
    "                break\n",
    "\n",
    "        if first_line in FRONT_BACK_MATTER_HEADINGS:\n",
    "            continue\n",
    "\n",
    "        kept_blocks.append(block)\n",
    "\n",
    "    return '\\n\\n'.join(kept_blocks)\n",
    "\n",
    "\n",
    "def clean_text(text):\n",
    "\n",
    "    # 0. Buang blok front/back-matter (kata pengantar, ucapan\n",
    "    #    terima kasih, dll) dari buku-buku yang di-merge\n",
    "    text = strip_front_back_matter(text)\n",
    "\n",
    "    # 1. Normalisasi Unicode\n",
    "    text = unicodedata.normalize(\"NFC\", text)\n",
    "\n",
    "    # 2. Hapus BOM\n",
    "    text = text.replace(\"﻿\", \"\")\n",
    "\n",
    "    # 3. Hapus URL\n",
    "    text = re.sub(\n",
    "        r'https?://\\S+|www\\.\\S+',\n",
    "        '',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    # 4. Hapus email\n",
    "    text = re.sub(\n",
    "        r'\\S+@\\S+',\n",
    "        '',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    # 5. Normalisasi line break\n",
    "    text = re.sub(\n",
    "        r'\\r\\n?',\n",
    "        '\\n',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    # 6. Normalisasi spasi dan tab\n",
    "    # newline tetap dipertahankan\n",
    "    text = re.sub(\n",
    "        r'[ \\t]+',\n",
    "        ' ',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    # 7. Membersihkan spasi setiap baris\n",
    "    lines = []\n",
    "\n",
    "    for line in text.split('\\n'):\n",
    "\n",
    "        line = line.strip()\n",
    "\n",
    "        if line:\n",
    "            lines.append(line)\n",
    "\n",
    "    # 8. Gabungkan kembali dengan newline\n",
    "    text = '\\n'.join(lines)\n",
    "\n",
    "    return text.strip()\n",
    "\n",
    "\n",
    "cleaned_text = clean_text(text)\n",
    "\n",
    "\n",
    "print(\"\\n=== CLEANED TEXT ===\")\n",
    "print(cleaned_text)"
   ]
