    "# ==========================================\n",
    "# 6. CASE FOLDING\n",
    "# ==========================================\n",
    "\n",
    "def case_folding(sentences):\n",
    "\n",
    "    folded_sentences = []\n",
    "\n",
    "    for sentence in sentences:\n",
    "\n",
    "        sentence = sentence.lower()\n",
    "\n",
    "        folded_sentences.append(sentence)\n",
    "\n",
    "    return folded_sentences\n",
    "\n",
    "\n",
    "casefolded_sentences = case_folding(\n",
    "    rule_based_sentences\n",
