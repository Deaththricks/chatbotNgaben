    "# ==========================================\n",
    "# 5. SENTENCE SEGMENTATION\n",
    "# ==========================================\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# ABBREVIATION GUARD\n",
    "#\n",
    "# The old splitter broke on ANY \"[.!?]\" followed by whitespace,\n",
    "# with no exceptions -- so it would have shattered \"Prof. Dr.\n",
    "# Tjokorda Rai Sudarta\" into three fragments the moment it\n",
    "# actually reached that text (see the numbered-heading bug below\n",
    "# for why it never used to reach it). Protect known Indonesian\n",
    "# titles/abbreviations by temporarily hiding their internal\n",
    "# periods (with a placeholder that can't occur naturally in the\n",
    "# text) before splitting, then restoring them after.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "ABBREVIATIONS = [\n",
    "    \"prof.\", \"dr.\", \"drs.\", \"dra.\", \"ir.\", \"hj.\",\n",
    "    \"m.hum.\", \"m.si.\", \"m.ag.\", \"s.pd.\", \"s.ag.\",\n",
    "    \"s.e.\", \"s.s.\", \"s.sos.\", \"a.md.\", \"skg.\",\n",
    "]\n",
    "\n",
    "_ABBREV_PLACEHOLDER = \"\\x00\"\n",
    "\n",
    "\n",
    "def protect_abbreviation_periods(line):\n",
    "\n",
    "    for abbr in ABBREVIATIONS:\n",
    "\n",
    "        pattern = re.compile(re.escape(abbr), re.IGNORECASE)\n",
    "\n",
    "        line = pattern.sub(\n",
    "            lambda m: m.group().replace(\".\", _ABBREV_PLACEHOLDER),\n",
    "            line\n",
    "        )\n",
    "\n",
    "    return line\n",
    "\n",
    "\n",
    "def restore_abbreviation_periods(text):\n",
    "\n",
    "    return text.replace(_ABBREV_PLACEHOLDER, \".\")\n",
    "\n",
    "\n",
    "def split_into_sentences(line):\n",
    "    \"\"\"\n",
    "    Shared punctuation-based splitter, used both for ordinary\n",
    "    lines and for the content of numbered list items (see below).\n",
    "    \"\"\"\n",
    "\n",
    "    line = re.sub(\n",
    "        r'([.!?])([A-Za-zÀ-ÿ])',\n",
    "        r'\\1 \\2',\n",
    "        line\n",
    "    )\n",
    "\n",
    "    line = protect_abbreviation_periods(line)\n",
    "\n",
    "    parts = re.split(\n",
    "        r'(?<=[.!?])\\s+',\n",
    "        line\n",
    "    )\n",
    "\n",
    "    return [\n",
    "        restore_abbreviation_periods(part).strip()\n",
    "        for part in parts\n",
    "        if part.strip()\n",
    "    ]\n",
    "\n",
    "\n",
    "def rule_based_segmentation(text):\n",
    "\n",
    "    sentences = []\n",
    "\n",
    "    lines = text.split('\\n')\n",
    "\n",
    "    for line in lines:\n",
    "\n",
    "        line = line.strip()\n",
    "\n",
    "        if not line:\n",
    "            continue\n",
    "\n",
    "        # Hapus bullet\n",
    "        line = re.sub(\n",
    "            r'^[*-]\\s*',\n",
    "            '',\n",
    "            line\n",
    "        )\n",
    "\n",
    "        # Abaikan nomor heading\n",
    "        if re.fullmatch(r'\\d+\\.', line):\n",
    "            continue\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Numbered item (\"1. Judul\", \"2. Pertanyaan? Jawaban.\").\n",
    "        # FIX: only the \"N. \" prefix is stripped here. The old\n",
    "        # code appended the ENTIRE rest of the line as a single\n",
    "        # sentence and skipped straight to the next line -- fine\n",
    "        # for a short heading like \"12. Pertanyaan yang Sering\n",
    "        # Muncul (FAQ)\", but this same numbering is used all over\n",
    "        # the corpus for FAQ entries and procedural list steps\n",
    "        # that themselves contain several full sentences (e.g.\n",
    "        # \"1. Mengapa tidak boleh ada air mata saat Ngaben? Air\n",
    "        # mata dipercaya dapat menghambat...\"). Swallowing those\n",
    "        # whole merged multiple real sentences into one, which is\n",
    "        # why ~100 \"sentences\" in this corpus produced dependency\n",
    "        # parses with 2+ disconnected root tokens. Numbered\n",
    "        # content now goes through the same splitter as everything\n",
    "        # else.\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        heading = re.match(\n",
    "            r'^\\d+\\.\\s*(.+)$',\n",
    "            line\n",
    "        )\n",
    "\n",
    "        if heading:\n",
    "            line = heading.group(1).strip()\n",
    "\n",
    "        for part in split_into_sentences(line):\n",
    "            sentences.append(part)\n",
    "\n",
    "    return sentences\n",
    "\n",
    "rule_based_sentences = rule_based_segmentation(\n",
    "    cleaned_text\n",
    ")\n",
    "\n",
    "print(\"\\n=== RULE-BASED SEGMENTATION ===\")\n",
    "\n",
    "for i, sentence in enumerate(\n",
    "    rule_based_sentences,\n",
    "    start=1\n",
    "):\n",
    "    print(f\"S{i}: {sentence}\")"
   ]
