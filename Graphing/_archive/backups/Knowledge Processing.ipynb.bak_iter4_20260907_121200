    "REJECT_POS = {'DET', 'PRON', 'ADP', 'CCONJ', 'SCONJ', 'AUX', 'NUM', 'PART'}\n",
    "\n",
    "def build_pos_lookup(pos_results):\n",
    "    lookup = []\n",
    "    for sentence_result in pos_results:\n",
    "        word_to_pos = {}\n",
    "        for token in sentence_result:\n",
    "            word_to_pos[token['text'].lower()] = token['upos']\n",
    "        lookup.append(word_to_pos)\n",
    "    return lookup\n",
    "\n",
    "\n",
    "def build_midsentence_capitalized_words(original_sentences):\n",
    "    \"\"\"\n",
    "    A word being capitalized only proves it's a proper noun if\n",
    "    that capitalization survives OUTSIDE sentence-initial position\n",
    "    (where every word is capitalized regardless, just by writing\n",
    "    convention). Collect every word seen capitalized at a\n",
    "    non-initial position anywhere in the corpus, once, so the\n",
    "    per-mention capitalization check below can tell \"Bali\" (almost\n",
    "    always capitalized mid-sentence -> a real proper noun) apart\n",
    "    from \"Sasaran\"/\"Mata air\" (capitalized ONLY because they\n",
    "    happened to start a sentence after a \"?\" -- ordinary common\n",
    "    nouns, not entities).\n",
    "    \"\"\"\n",
    "\n",
    "    confirmed = set()\n",
    "\n",
    "    for sentence in original_sentences:\n",
    "\n",
    "        words = sentence.split()\n",
    "\n",
    "        for position, word in enumerate(words):\n",
    "\n",
    "            if position == 0:\n",
    "                continue\n",
    "\n",
    "            stripped = word.strip('.,;:!?()\"\\'')\n",
    "\n",
    "            if stripped[:1].isupper():\n",
    "                confirmed.add(stripped.lower())\n",
    "\n",
    "    return confirmed\n",
    "\n",
    "\n",
    "def dictionary_ner(\n",
    "    sentences,\n",
    "    dictionary,\n",
    "    pos_lookup=None,\n",
    "    original_sentences=None,\n",
    "    require_capital_for_labels=None,  # e.g. {'Place', 'Person'}\n",
    "    confirmed_proper_words=None\n",
    "):\n",
    "    results = []\n",
    "\n",
    "    sorted_dictionary = sorted(\n",
    "        dictionary.items(),\n",
    "        key=lambda x: len(x[0]),\n",
    "        reverse=True\n",
    "    )\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # PERF FIX: compile each entity's word-bounded pattern\n",
    "    # ONCE here, instead of rebuilding the pattern STRING and\n",
    "    # recompiling it inside the per-sentence loop below. The\n",
    "    # old code ran\n",
    "    #     re.finditer(r'(?<!\\w)' + re.escape(entity) + r'(?!\\w)',\n",
    "    #                 sentence, flags=re.IGNORECASE)\n",
    "    # for every (sentence x dictionary entry) pair -- ~51M\n",
    "    # calls for the 11.7k-entry general gazetteer x ~4.36k\n",
    "    # sentences. Because a fresh pattern string was built each\n",
    "    # call, Python's 512-entry compile cache never helped and\n",
    "    # nearly every call recompiled from scratch (~50 min for\n",
    "    # the general-NER pass alone). Precompiling drops that to\n",
    "    # a few minutes. Matches are byte-for-byte identical --\n",
    "    # this is purely a speedup, no behaviour change.\n",
    "    # ----------------------------------------------------\n",
    "    compiled_dictionary = [\n",
    "        (\n",
    "            re.compile(\n",
    "                r'(?<!\\w)' + re.escape(entity) + r'(?!\\w)',\n",
    "                flags=re.IGNORECASE\n",
    "            ),\n",
    "            label\n",
    "        )\n",
    "        for entity, label in sorted_dictionary\n",
    "    ]\n",
    "\n",
    "    for sentence_id, sentence in enumerate(sentences, start=1):\n",
    "        entities = []\n",
    "        sentence_pos = pos_lookup[sentence_id - 1] if pos_lookup else {}\n",
    "        original = original_sentences[sentence_id - 1] if original_sentences else None\n",
    "\n",
    "        for compiled_pattern, label in compiled_dictionary:\n",
    "\n",
    "            matches = compiled_pattern.finditer(sentence)\n",
    "\n",
    "            for match in matches:\n",
    "                matched_text = match.group()\n",
    "\n",
    "                # --- CHECK 1: POS filter ---\n",
    "                first_word = matched_text.split()[0].lower()\n",
    "                pos_tag = sentence_pos.get(first_word)\n",
    "                if pos_tag in REJECT_POS:\n",
    "                    continue\n",
    "\n",
    "                # --- CHECK 2: Capitalization filter ---\n",
    "                # FIX: used to only apply to single-word matches,\n",
    "                # so two-word general-gazetteer entries (e.g.\n",
    "                # \"kelapa gading\", \"indonesia denpasar\") skipped\n",
    "                # this check entirely regardless of case. Now\n",
    "                # applies to every word in the span. It also no\n",
    "                # longer trusts sentence-initial capitalization by\n",
    "                # itself -- see build_midsentence_capitalized_words\n",
    "                # above -- unless the word is independently\n",
    "                # confirmed capitalized elsewhere in the corpus.\n",
    "                if (\n",
    "                    require_capital_for_labels\n",
    "                    and label in require_capital_for_labels\n",
    "                    and original\n",
    "                ):\n",
    "                    original_span = original[match.start():match.end()]\n",
    "                    span_words = original_span.split()\n",
    "\n",
    "                    all_capitalized = bool(span_words) and all(\n",
    "                        w[:1].isupper() for w in span_words\n",
    "                    )\n",
    "\n",
    "                    if not all_capitalized:\n",
    "                        continue\n",
    "\n",
    "                    sentence_initial = (match.start() == 0)\n",
    "\n",
    "                    if sentence_initial and confirmed_proper_words is not None:\n",
    "                        words_confirmed = all(\n",
    "                            w.strip('.,;:!?()\"\\'').lower() in confirmed_proper_words\n",
    "                            for w in span_words\n",
    "                        )\n",
    "                        if not words_confirmed:\n",
    "                            continue\n",
    "\n",
    "                entities.append({\n",
    "                    \"sentence_id\": sentence_id,\n",
    "                    \"entity\": matched_text,\n",
    "                    \"label\": label,\n",
    "                    \"start\": match.start(),\n",
    "                    \"end\": match.end(),\n",
    "                    \"source\": \"dictionary\"\n",
    "                })\n",
    "\n",
    "        # ----------------------------------\n",
    "        # DEDUP: same entity text + label\n",
    "        # appearing more than once in the\n",
    "        # same sentence (e.g. \"tirtha\"\n",
    "        # mentioned twice) — keep only the\n",
    "        # FIRST occurrence, drop the rest.\n",
    "        # ----------------------------------\n",
    "\n",
    "        seen = set()\n",
    "        deduped_entities = []\n",
    "\n",
    "        for entity in entities:\n",
    "\n",
    "            key = (\n",
    "                entity[\"entity\"].lower(),\n",
    "                entity[\"label\"]\n",
    "            )\n",
    "\n",
    "            if key in seen:\n",
    "                continue\n",
    "\n",
    "            seen.add(key)\n",
    "            deduped_entities.append(entity)\n",
    "\n",
    "        # ----------------------------------\n",
    "        # OVERLAP RESOLUTION: prefer the longest match.\n",
    "        # If a shorter match's span is fully covered by a\n",
    "        # longer match (e.g. \"pitra\" and \"yadnya\" both\n",
    "        # sitting inside \"pitra yadnya\"), only the longer\n",
    "        # match survives -- the phrase is detected as ONE\n",
    "        # entity, not three. A standalone \"pitra\" or\n",
    "        # \"yadnya\" elsewhere in the sentence, not\n",
    "        # overlapping \"pitra yadnya\", is unaffected and\n",
    "        # still gets detected normally.\n",
    "        # ----------------------------------\n",
    "\n",
    "        deduped_entities = sorted(\n",
    "            deduped_entities,\n",
    "            key=lambda e: e[\"end\"] - e[\"start\"],\n",
    "            reverse=True\n",
    "        )\n",
    "\n",
    "        kept_entities = []\n",
    "\n",
    "        for entity in deduped_entities:\n",
    "\n",
    "            overlaps_kept = False\n",
    "\n",
    "            for kept in kept_entities:\n",
    "\n",
    "                if (\n",
    "                    entity[\"start\"] < kept[\"end\"]\n",
    "                    and entity[\"end\"] > kept[\"start\"]\n",
    "                ):\n",
    "                    overlaps_kept = True\n",
    "                    break\n",
    "\n",
    "            if not overlaps_kept:\n",
    "                kept_entities.append(entity)\n",
    "\n",
    "        deduped_entities = sorted(\n",
    "            kept_entities,\n",
    "            key=lambda e: e[\"start\"]\n",
    "        )\n",
    "\n",
    "        results.append({\n",
    "            \"sentence_id\": sentence_id,\n",
    "            \"sentence\": sentence,\n",
    "            \"entities\": deduped_entities\n",
    "        })\n",
    "\n",
    "    return results"
