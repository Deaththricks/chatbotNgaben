    "# ==========================================\n",
    "# 11.4. COREFERENCE RESOLUTION (TYPE-AWARE FIX #5,\n",
    "#       SUBJECT-AWARE FIX #6)\n",
    "# ==========================================\n",
    "\n",
    "# Mention yang menyebut jenis entity (\"upacara ini\",\n",
    "# \"ritual tersebut\") sebaiknya di-link ke antecedent yang\n",
    "# TYPE-nya cocok, bukan sekadar entity terakhir yang muncul.\n",
    "# Tanpa ini, \"upacara ini\" bisa nyasar ke konsep filosofis\n",
    "# hanya karena itu kata benda terakhir di kalimat sebelumnya.\n",
    "MENTION_TYPE_HINTS = {\n",
    "    \"upacara ini\":      {\"RITUAL_KEMATIAN\", \"TAHAPAN_UPACARA\"},\n",
    "    \"upacara tersebut\": {\"RITUAL_KEMATIAN\", \"TAHAPAN_UPACARA\"},\n",
    "    \"ritual ini\":       {\"RITUAL_KEMATIAN\", \"TAHAPAN_UPACARA\"},\n",
    "    \"ritual tersebut\":  {\"RITUAL_KEMATIAN\", \"TAHAPAN_UPACARA\"},\n",
    "}\n",
    "\n",
    "# ----------------------------------------------------\n",
    "# FIX #6: SUBJECT-AWARE FALLBACK FOR BARE PRONOUNS\n",
    "#\n",
    "# Bare \"ini\"/\"itu\"/\"tersebut\" (no type hint, ~95% of all\n",
    "# mentions) used to just take candidates.iloc[-1] -- the most\n",
    "# recently MENTIONED entity, regardless of what role it played\n",
    "# in its own sentence. E.g. \"Praktik ini tersebar di seluruh\n",
    "# wilayah Bali...\" resolved to antecedent \"atma\", because \"atma\"\n",
    "# happened to be the last entity named in the previous sentence\n",
    "# (\"...filosofi pelepasan jiwa (atma) dari ikatan duniawi\"),\n",
    "# even though that sentence's actual subject -- and the obvious\n",
    "# real antecedent of \"praktik ini\" -- was \"Ngaben\".\n",
    "#\n",
    "# Indonesian bare demonstratives typically refer back to the\n",
    "# prior clause's SUBJECT/topic, not merely its most recently\n",
    "# named noun. dependency_results (now computed earlier in the\n",
    "# notebook, before this cell) lets us check: was this candidate\n",
    "# entity the grammatical subject (nsubj/nsubj:pass) of its own\n",
    "# sentence? Prefer the most recent subject-tagged candidate;\n",
    "# fall back to plain recency only when none of the candidates\n",
    "# were a subject anywhere.\n",
    "# ----------------------------------------------------\n",
    "\n",
    "DEPENDENCY_TOKENS_BY_SENTENCE = {\n",
    "    result[\"sentence_id\"]: result[\"tokens\"]\n",
    "    for result in dependency_results\n",
    "}\n",
    "\n",
    "SUBJECT_DEPRELS = {\"nsubj\", \"nsubj:pass\"}\n",
    "\n",
    "\n",
    "def candidate_is_subject(candidate):\n",
    "\n",
    "    tokens = DEPENDENCY_TOKENS_BY_SENTENCE.get(\n",
    "        candidate[\"sentence_id\"]\n",
    "    )\n",
    "\n",
    "    if not tokens:\n",
    "        return False\n",
    "\n",
    "    deprel = get_entity_deprel(candidate[\"entity\"], tokens)\n",
    "\n",
    "    return deprel in SUBJECT_DEPRELS\n",
    "\n",
    "\n",
    "def resolve_coreference(mentions, df_ner):\n",
    "\n",
    "    resolved = []\n",
    "\n",
    "    for mention in mentions:\n",
    "\n",
    "        mention_text = mention[\"mention\"].lower()\n",
    "        sentence_id = mention[\"sentence_id\"]\n",
    "\n",
    "        candidates = find_antecedent_candidates(mention, df_ner)\n",
    "\n",
    "        antecedent = None\n",
    "        antecedent_label = None\n",
    "        reference_type = \"UNRESOLVED\"\n",
    "        confidence = \"low\"\n",
    "\n",
    "        # ============ DISCOURSE REFERENCE ============\n",
    "        if mention_text in [\n",
    "            \"hal ini\",\n",
    "            \"hal tersebut\",\n",
    "            \"laporan ini\",\n",
    "            \"laporan tersebut\"\n",
    "        ]:\n",
    "            reference_type = \"DISCOURSE_REFERENCE\"\n",
    "\n",
    "        # ============ ENTITY REFERENCE ============\n",
    "        else:\n",
    "\n",
    "            if not candidates.empty:\n",
    "\n",
    "                # FIX #5: kalau mention-nya bertipe (upacara/ritual),\n",
    "                # pilih kandidat TERBARU yang label-nya cocok dulu.\n",
    "                expected_labels = MENTION_TYPE_HINTS.get(mention_text)\n",
    "                candidate = None\n",
    "\n",
    "                if expected_labels is not None:\n",
    "                    compatible = candidates[\n",
    "                        candidates[\"label\"].isin(expected_labels)\n",
    "                    ]\n",
    "                    if not compatible.empty:\n",
    "                        candidate = compatible.iloc[-1]\n",
    "\n",
    "                if candidate is None:\n",
    "\n",
    "                    # FIX #6: prefer the most recent candidate that\n",
    "                    # was its own sentence's grammatical subject.\n",
    "                    subject_candidate_indices = [\n",
    "                        idx for idx in candidates.index\n",
    "                        if candidate_is_subject(candidates.loc[idx])\n",
    "                    ]\n",
    "\n",
    "                    if subject_candidate_indices:\n",
    "                        candidate = candidates.loc[\n",
    "                            subject_candidate_indices[-1]\n",
    "                        ]\n",
    "                    else:\n",
    "                        # Fallback lama: kandidat paling terakhir\n",
    "                        # (recency), dipakai kalau tak satu pun\n",
    "                        # kandidat pernah jadi subject.\n",
    "                        candidate = candidates.iloc[-1]\n",
    "\n",
    "                antecedent = candidate[\"entity\"]\n",
    "                antecedent_label = candidate[\"label\"]\n",
    "                reference_type = \"ENTITY_REFERENCE\"\n",
    "\n",
    "                distance = sentence_id - candidate[\"sentence_id\"]\n",
    "                num_candidates = candidates[\"entity\"].nunique()\n",
    "\n",
    "                if distance <= 1 and num_candidates == 1:\n",
    "                    confidence = \"high\"\n",
    "                elif distance <= 2:\n",
    "                    confidence = \"medium\"\n",
    "                else:\n",
    "                    confidence = \"low\"\n",
    "\n",
    "        # ============ SIMPAN HASIL ============\n",
    "        resolved.append({\n",
    "            \"sentence_id\": sentence_id,\n",
    "            \"mention\": mention[\"mention\"],\n",
    "            \"antecedent\": antecedent,\n",
    "            \"antecedent_label\": antecedent_label,\n",
    "            \"antecedent_canonical\": (\n",
    "                canonicalize_entity(antecedent) if antecedent else None\n",
    "            ),\n",
    "            \"reference_type\": reference_type,\n",
    "            \"confidence\": confidence,\n",
    "            \"method\": \"rule_based\"\n",
    "        })\n",
    "\n",
    "    return resolved\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 11.5. RUN COREFERENCE RESOLUTION\n",
    "# ==========================================\n",
    "\n",
    "coreference_results = resolve_coreference(\n",
    "    coreference_mentions,\n",
    "    df_ner\n",
    ")\n",
    "\n",
    "print(\"\\n=== COREFERENCE RESOLUTION ===\")\n",
    "\n",
    "for result in coreference_results:\n",
    "\n",
    "    print(\n",
    "        f\"S{result['sentence_id']} | \"\n",
    "        f\"{result['mention']} -> \"\n",
    "        f\"{result['antecedent']} | \"\n",
    "        f\"{result['reference_type']} | \"\n",
    "        f\"confidence={result['confidence']}\"\n",
    "    )"
   ]
