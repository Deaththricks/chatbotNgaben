    "# ==========================================\n",
    "# 12.1. ENTITY / TOKEN HELPERS\n",
    "# ==========================================\n",
    "# Moved up from relation extraction: coreference resolution\n",
    "# (below) also needs to find which token(s) an entity mention\n",
    "# corresponds to and what its dependency role is, to prefer a\n",
    "# grammatical-subject antecedent over a merely-nearby one.\n",
    "\n",
    "def get_token_by_id(tokens, token_id):\n",
    "\n",
    "    for token in tokens:\n",
    "\n",
    "        if token[\"id\"] == token_id:\n",
    "            return token\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def find_entity_tokens(\n",
    "    entity_text,\n",
    "    tokens\n",
    "):\n",
    "\n",
    "    entity_words = (\n",
    "        entity_text\n",
    "        .lower()\n",
    "        .split()\n",
    "    )\n",
    "\n",
    "    token_words = [\n",
    "        token[\"text\"].lower()\n",
    "        for token in tokens\n",
    "    ]\n",
    "\n",
    "    for i in range(\n",
    "        len(token_words) - len(entity_words) + 1\n",
    "    ):\n",
    "\n",
    "        if token_words[\n",
    "            i:i + len(entity_words)\n",
    "        ] == entity_words:\n",
    "\n",
    "            return tokens[\n",
    "                i:i + len(entity_words)\n",
    "            ]\n",
    "\n",
    "    return []\n",
    "\n",
    "\n",
    "def get_entity_head(\n",
    "    entity_text,\n",
    "    tokens\n",
    "):\n",
    "\n",
    "    entity_tokens = find_entity_tokens(\n",
    "        entity_text,\n",
    "        tokens\n",
    "    )\n",
    "\n",
    "    if not entity_tokens:\n",
    "        return None\n",
    "\n",
    "    entity_ids = [\n",
    "        token[\"id\"]\n",
    "        for token in entity_tokens\n",
    "    ]\n",
    "\n",
    "    # Token yang head-nya berada\n",
    "    # di luar entity adalah head entity\n",
    "    for token in entity_tokens:\n",
    "\n",
    "        if token[\"head\"] not in entity_ids:\n",
    "\n",
    "            return token\n",
    "\n",
    "    return entity_tokens[0]\n",
    "\n",
    "\n",
    "def get_entity_deprel(entity_text, tokens):\n",
    "    \"\"\"\n",
    "    Convenience used by coreference: what's this entity mention's\n",
    "    own dependency role in its sentence (e.g. \"nsubj\")? None if\n",
    "    the entity text can't be matched to tokens.\n",
    "    \"\"\"\n",
    "\n",
    "    head = get_entity_head(entity_text, tokens)\n",
    "\n",
    "    return head[\"deprel\"] if head else None"
   ]
