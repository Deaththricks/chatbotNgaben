   "source": [
    "# ==========================================\n",
    "# 14. SAVE NER, DEPENDENCY PARSING,\n",
    "#     RELATION EXTRACTION & COREFERENCE\n",
    "#     RESOLUTION (EACH IN ITS OWN SUBFOLDER,\n",
    "#     EACH IN ITS STANDARD FORMAT + A HUMAN-\n",
    "#     READABLE .txt, EACH WRITTEN ATOMICALLY)\n",
    "# ==========================================\n",
    "\n",
    "import os\n",
    "import json\n",
    "\n",
    "base_results_folder = BASE_RESULTS_FOLDER\n",
    "\n",
    "def make_output_path(process_name, extension='txt'):\n",
    "    \"\"\"\n",
    "    Creates Results/{process_name}_results_ngaben/\n",
    "    and returns the path to\n",
    "    {process_name}_results_ngaben.{extension} inside it.\n",
    "    \"\"\"\n",
    "\n",
    "    folder = os.path.join(\n",
    "        base_results_folder,\n",
    "        f'{process_name}_results_ngaben'\n",
    "    )\n",
    "\n",
    "    os.makedirs(folder, exist_ok=True)\n",
    "\n",
    "    return os.path.join(\n",
    "        folder,\n",
    "        f'{process_name}_results_ngaben.{extension}'\n",
    "    )\n",
    "\n",
    "\n",
    "def require_nonempty(data, name):\n",
    "    \"\"\"\n",
    "    A previous run left dependency_results_ngaben.conllu at 0\n",
    "    bytes: `open(path, 'w')` truncates the file immediately, and\n",
    "    the cell that ran at the time apparently had an empty\n",
    "    dependency_results in memory (most likely a stale kernel\n",
    "    state after a partial re-run), so the loop below wrote\n",
    "    nothing and the file was left empty -- silently overwriting\n",
    "    whatever good output was there before. Fail loudly instead of\n",
    "    doing that again.\n",
    "    \"\"\"\n",
    "\n",
    "    if not data:\n",
    "        raise ValueError(\n",
    "            f\"Refusing to write {name}: the in-memory result set is \"\n",
    "            f\"empty. This usually means the kernel state is stale \"\n",
    "            f\"(a cell wasn't re-run after a restart). Restart & Run \"\n",
    "            f\"All before saving.\"\n",
    "        )\n",
    "\n",
    "\n",
    "def atomic_write(path, write_fn):\n",
    "    \"\"\"\n",
    "    Write to a temp file first, then rename it into place. If\n",
    "    write_fn raises partway through, the real output file is left\n",
    "    untouched instead of ending up half-written or empty.\n",
    "    \"\"\"\n",
    "\n",
    "    tmp_path = path + '.tmp'\n",
    "\n",
    "    with open(tmp_path, 'w', encoding='utf-8') as f:\n",
    "        write_fn(f)\n",
    "\n",
    "    os.replace(tmp_path, path)\n",
    "\n",
    "\n",
    "require_nonempty(dependency_results, 'dependency parsing')\n",
    "require_nonempty(relations, 'relation extraction')\n",
    "require_nonempty(coreference_results, 'coreference resolution')\n",
    "\n",
    "# ----------------------------------\n",
    "# 14.2. DEPENDENCY PARSING (CoNLL-U)\n",
    "# ----------------------------------\n",
    "\n",
    "output_path_dep = make_output_path('dependency', 'conllu')\n",
    "\n",
    "\n",
    "def write_dependency_conllu(f):\n",
    "    for result in dependency_results:\n",
    "        f.write(f\"# sent_id = S{result['sentence_id']}\\n\")\n",
    "        f.write(f\"# text = {result['sentence']}\\n\")\n",
    "\n",
    "        for token in result['tokens']:\n",
    "            columns = [\n",
    "                str(token['id']),      # ID\n",
    "                token['text'],         # FORM\n",
    "                token['lemma'],        # LEMMA\n",
    "                token['upos'],         # UPOS\n",
    "                \"_\",                   # XPOS\n",
    "                \"_\",                   # FEATS\n",
    "                str(token['head']),    # HEAD\n",
    "                token['deprel'],       # DEPREL\n",
    "                \"_\",                   # DEPS\n",
    "                \"_\",                   # MISC\n",
    "            ]\n",
    "            f.write(\"\\t\".join(columns) + \"\\n\")\n",
    "\n",
    "        f.write(\"\\n\")\n",
    "\n",
    "\n",
    "atomic_write(output_path_dep, write_dependency_conllu)\n",
    "print(f\"Dependency parsing results saved to {output_path_dep}\")\n",
    "\n",
    "# ----------------------------------\n",
    "# 14.2b. DEPENDENCY PARSING (human-readable TXT)\n",
    "# ----------------------------------\n",
    "\n",
    "output_path_dep_txt = make_output_path('dependency', 'txt')\n",
    "\n",
    "\n",
    "def write_dependency_txt(f):\n",
    "    for result in dependency_results:\n",
    "\n",
    "        f.write(\n",
    "            f\"S{result['sentence_id']}: \"\n",
    "            f\"{result['sentence']}\\n\"\n",
    "        )\n",
    "\n",
    "        for token in result['tokens']:\n",
    "\n",
    "            f.write(\n",
    "                f\"  {token['id']:>2} \"\n",
    "                f\"{token['text']:20} \"\n",
    "                f\"lemma={token['lemma']:20} \"\n",
    "                f\"head={token['head']:>2} \"\n",
    "                f\"dep={token['deprel']}\\n\"\n",
    "            )\n",
    "\n",
    "        f.write('\\n')\n",
    "\n",
    "\n",
    "atomic_write(output_path_dep_txt, write_dependency_txt)\n",
    "print(f\"Dependency parsing results (txt) saved to {output_path_dep_txt}\")\n",
    "\n",
    "# ----------------------------------\n",
    "# 14.3. RELATION EXTRACTION (single pretty-printed JSON\n",
    "#       array -- one FLAT JSON object per relation,\n",
    "#       2-space indent. Field layout matches\n",
    "#       extracted_relations_bayuh_oton_3bulan.json /\n",
    "#       hasil_relasi_MERGED_FINAL_v2.json: sentence_id +\n",
    "#       context_sentence text repeated on every relation\n",
    "#       record instead of relations nested under their\n",
    "#       sentence.)\n",
    "# ----------------------------------\n",
    "\n",
    "# NOTE: this writes a real JSON array ([ {...}, {...} ]),\n",
    "# not JSONL -- load it with json.load(). A previous version\n",
    "# wrote blank-line-separated pretty records into a .jsonl\n",
    "# file; it now writes one .json array to match the reference\n",
    "# files above.\n",
    "\n",
    "output_path_rel = make_output_path('relation', 'json')\n",
    "\n",
    "sentence_lookup = {\n",
    "    result['sentence_id']: result['sentence']\n",
    "    for result in dependency_results\n",
    "}\n",
    "\n",
    "# FIX (report Section 1a): sentence_id is an int (or, for a\n",
    "# Stanza-split sub-sentence, a \"N.2\"-style string -- see section\n",
    "# 12's dependency_parsing()) -- sorting by str(x) put them in\n",
    "# LEXICOGRAPHIC order (\"1\", \"10\", \"100\", \"1017\", ... before \"2\",\n",
    "# \"20\", ...), not smallest-to-biggest. Sort numerically on the\n",
    "# integer part, falling back after it for the rare \"N.2\" sub-\n",
    "# sentence id so those still land right after their parent N.\n",
    "def _sentence_id_sort_key(sid):\n",
    "    text = str(sid)\n",
    "    if '.' in text:\n",
    "        major, minor = text.split('.', 1)\n",
    "        return (int(major), int(minor))\n",
    "    return (int(text), 0)\n",
    "\n",
    "\n",
    "sorted_relations = sorted(\n",
    "    relations, key=lambda r: _sentence_id_sort_key(r['sentence_id'])\n",
    ")\n",
    "\n",
    "\n",
    "def write_relation_json(f):\n",
    "    records = [\n",
    "        {\n",
    "            \"sentence_id\": rel['sentence_id'],\n",
    "            \"context_sentence\": sentence_lookup.get(rel['sentence_id'], \"\"),\n",
    "            \"subject\": rel['subject'],\n",
    "            \"subject_label\": rel['subject_label'],\n",
    "            \"relation\": rel['relation'],\n",
    "            \"object\": rel['object'],\n",
    "            \"object_label\": rel['object_label'],\n",
    "            \"object_type\": rel.get('object_kind'),\n",
    "            \"source\": rel['source'],\n",
    "        }\n",
    "        for rel in sorted_relations\n",
    "    ]\n",
    "    json.dump(records, f, ensure_ascii=False, indent=2)\n",
    "    f.write('\\n')\n",
    "\n",
    "\n",
    "atomic_write(output_path_rel, write_relation_json)\n",
    "print(f\"Relation extraction results saved to {output_path_rel}\")\n",
    "\n",
    "# ----------------------------------\n",
    "# 14.3b. RELATION EXTRACTION (human-readable TXT, still\n",
    "#        grouped visually by sentence for readability)\n",
    "# ----------------------------------\n",
    "\n",
    "output_path_rel_txt = make_output_path('relation', 'txt')\n",
    "\n",
    "\n",
    "def write_relation_txt(f):\n",
    "    current_sid = None\n",
    "    for rel in sorted_relations:\n",
    "        sid = rel['sentence_id']\n",
    "\n",
    "        if sid != current_sid:\n",
    "            if current_sid is not None:\n",
    "                f.write(\"\\n\")\n",
    "            f.write(f\"[Sentence {sid}]\\n\")\n",
    "            f.write(f\"Text: {sentence_lookup.get(sid, '')}\\n\")\n",
    "            f.write(\"Relations:\\n\")\n",
    "            current_sid = sid\n",
    "\n",
    "        subj = rel['subject']\n",
    "        obj = rel['object']\n",
    "\n",
    "        obj_label = f\" ({rel['object_label']})\" if rel['object_label'] else \"\"\n",
    "\n",
    "        f.write(\n",
    "            f\"  - {subj} ({rel['subject_label']}) \"\n",
    "            f\"--[{rel['relation'].lower()}]--> \"\n",
    "            f\"{obj}{obj_label}\\n\"\n",
    "        )\n",
    "\n",
    "    f.write(\"\\n\")\n",
    "\n",
    "\n",
    "atomic_write(output_path_rel_txt, write_relation_txt)\n",
    "print(f\"Relation extraction results (txt) saved to {output_path_rel_txt}\")\n",
    "\n",
    "# ----------------------------------\n",
    "# 14.3c. RELATION EXTRACTION (Markdown -- one table per\n",
    "#        sentence with the source context quoted above it,\n",
    "#        for reading / sharing / pasting into a report)\n",
    "# ----------------------------------\n",
    "\n",
    "output_path_rel_md = make_output_path('relation', 'md')\n",
    "\n",
    "\n",
    "def _md_cell(text):\n",
    "    \"\"\"Flatten a value so it can't break a Markdown table row.\"\"\"\n",
    "    return str(text).replace('|', r'\\|').replace('\\n', ' ').strip()\n",
    "\n",
    "\n",
    "def write_relation_md(f):\n",
    "    n_sent = len({rel['sentence_id'] for rel in sorted_relations})\n",
    "    f.write(\"# Ngaben Relation Extraction\\n\\n\")\n",
    "    f.write(f\"_{len(sorted_relations)} relations across {n_sent} sentences._\\n\\n\")\n",
    "\n",
    "    current_sid = None\n",
    "    for rel in sorted_relations:\n",
    "        sid = rel['sentence_id']\n",
    "\n",
    "        if sid != current_sid:\n",
    "            f.write(f\"\\n## S{sid}\\n\\n\")\n",
    "            ctx = sentence_lookup.get(sid, '')\n",
    "            if ctx:\n",
    "                f.write(f\"> {_md_cell(ctx)}\\n\\n\")\n",
    "            f.write(\"| subject | relation | object | source |\\n\")\n",
    "            f.write(\"|---|---|---|---|\\n\")\n",
    "            current_sid = sid\n",
    "\n",
    "        subj = _md_cell(rel['subject'])\n",
    "        if rel['subject_label']:\n",
    "            subj += f\" _({rel['subject_label']})_\"\n",
    "\n",
    "        obj = _md_cell(rel['object'])\n",
    "        if rel['object_label']:\n",
    "            obj += f\" _({rel['object_label']})_\"\n",
    "\n",
    "        f.write(f\"| {subj} | `{rel['relation']}` | {obj} | {rel['source']} |\\n\")\n",
    "\n",
    "    f.write(\"\\n\")\n",
    "\n",
    "\n",
    "atomic_write(output_path_rel_md, write_relation_md)\n",
    "print(f\"Relation extraction results (md) saved to {output_path_rel_md}\")\n",
    "\n",
    "# ----------------------------------\n",
    "# 14.4. COREFERENCE RESOLUTION (JSON Lines, pretty-\n",
    "#       printed -- same style as relation extraction\n",
    "#       above, one record per block)\n",
    "# ----------------------------------\n",
    "\n",
    "output_path_coref = make_output_path('coreference', 'jsonl')\n",
    "\n",
    "\n",
    "def write_coreference_jsonl(f):\n",
    "    for result in coreference_results:\n",
    "        record = {\n",
    "            \"sentence_id\": result['sentence_id'],\n",
    "            \"text\": sentence_lookup.get(result['sentence_id'], \"\"),\n",
    "            \"mention\": result['mention'],\n",
    "            \"antecedent\": result['antecedent'],\n",
    "            \"antecedent_canonical\": result['antecedent_canonical'],\n",
    "            \"antecedent_label\": result['antecedent_label'],\n",
    "            \"reference_type\": result['reference_type'],\n",
    "            \"confidence\": result['confidence'],\n",
    "            \"method\": result['method'],\n",
    "        }\n",
    "        f.write(json.dumps(record, ensure_ascii=False, indent=2))\n",
    "        f.write('\\n\\n')\n",
    "\n",
    "\n",
    "atomic_write(output_path_coref, write_coreference_jsonl)\n",
    "print(f\"Coreference resolution results saved to {output_path_coref}\")\n",
    "\n",
    "# ----------------------------------\n",
    "# 14.4b. COREFERENCE RESOLUTION (human-readable TXT)\n",
    "# ----------------------------------\n",
    "\n",
    "output_path_coref_txt = make_output_path('coreference', 'txt')\n",
    "\n",
    "\n",
    "def write_coreference_txt(f):\n",
    "    for result in coreference_results:\n",
    "        f.write(f\"S{result['sentence_id']}: \"\n",
    "                f\"{sentence_lookup.get(result['sentence_id'], '')}\\n\")\n",
    "\n",
    "        antecedent = result['antecedent'] or \"(none)\"\n",
    "        if result['antecedent_canonical'] and result['antecedent_canonical'] != result['antecedent']:\n",
    "            antecedent += f\" (canonical: {result['antecedent_canonical']})\"\n",
    "\n",
    "        label = f\" [{result['antecedent_label']}]\" if result['antecedent_label'] else \"\"\n",
    "\n",
    "        f.write(\n",
    "            f\"  \\\"{result['mention']}\\\" -> {antecedent}{label} | \"\n",
    "            f\"{result['reference_type']} | \"\n",
    "            f\"confidence={result['confidence']} | \"\n",
    "            f\"method={result['method']}\\n\\n\"\n",
    "        )\n",
    "\n",
    "\n",
    "atomic_write(output_path_coref_txt, write_coreference_txt)\n",
    "print(f\"Coreference resolution results (txt) saved to {output_path_coref_txt}\")"
   ]
  }
