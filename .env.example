# Copy this file to .env and fill in real values. .env is gitignored.

# Neo4j — used by Graphing/neo4/load_ngaben_to_neo4j.py AND the chatbot action server
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: the input JSON for the loader's old `--source raw` view only (the default,
# `--source kb`, always reads Graphing/kb/output/)
# JSON_PATH=relation_results_ngaben.normalized.json

# Chatbot (Chatbot/bot) --------------------------------------------------------
# Where the KB assets live, relative to Chatbot/bot/ (entities.json, etc.)
KB_DIR=../../Graphing/kb

# The action server calls a local Ollama server running the "qwen2.5" model for
# both coreference resolution and answer synthesis (see actions.py) -- this is a
# hard runtime dependency now, not optional. Install Ollama, run `ollama pull
# qwen2.5`, and make sure `ollama serve` (or the Ollama app) is running before
# starting the action server. No .env var needed -- langchain-ollama defaults to
# http://localhost:11434.
# Optional tuning (defaults shown): the model's context window, and how long a call may
# go without a streamed chunk before it counts as failed (then the bot answers from
# definitions and skips Ollama for 60 s).
# LLM_NUM_CTX=12288
# LLM_TIMEOUT=120
