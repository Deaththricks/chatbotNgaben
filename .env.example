# Copy this file to .env and fill in real values. .env is gitignored.

# Neo4j (used by Graphing/Neo4/load_ngaben_to_neo4j.py)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: override the input JSON path for the loader
# JSON_PATH=relation_results_ngaben.normalized.json
