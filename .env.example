# Copy this file to .env and fill in real values. .env is gitignored.

# Neo4j — used by Graphing/Neo4/load_ngaben_to_neo4j.py AND the chatbot action server
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: override the input JSON path for the loader (default mode only)
# JSON_PATH=relation_results_ngaben.normalized.json

# Chatbot (Chatbot/bot) --------------------------------------------------------
# Where the KB assets live, relative to Chatbot/bot/ (entities.json, etc.)
KB_DIR=../../Graphing/kb

# Groq API key for the LLM rephrasing layer (Stage 6). Leave empty to run the
# bot with deterministic templated responses only.
GROQ_API_KEY=
