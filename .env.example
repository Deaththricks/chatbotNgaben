# Copy this file to .env and fill in real values. .env is gitignored.

# Neo4j — used by Graphing/neo4/load_ngaben_to_neo4j.py AND the chatbot action server
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: the input JSON for the loader's old `--source raw` view only (the default,
# `--source kb`, always reads Graphing/kb/output/)
# JSON_PATH=relation_results_ngaben.normalized.json

# Chatbot (Chatbot/bot) --------------------------------------------------------
# Where the KB assets live, relative to Chatbot/bot/ (entities.json, etc.)
KB_DIR=../../Graphing/kb

# The action server answers complex questions with Qwen on Groq (simple ones come from
# templates, with no call). Create a key at https://console.groq.com (API Keys). Without it the
# bot still answers: templates as usual, the rest from the stored definitions only.
GROQ_API_KEY=
# Optional tuning (defaults shown): the prompt size cap in tokens (Groq bills per token and its
# developer plan allowed 8K tokens per minute for this model, 2026-10-13), and how long one call
# may take before it counts as failed (then the bot answers from definitions and skips the LLM
# for 60 s).
# LLM_MAX_PROMPT_TOKENS=6000
# LLM_TIMEOUT=120
# The chat model (the senior's choice, 2026-10-13; kept after the LLM comparison, 2026-10-26). After
# changing it, run the regression suite (Chatbot/bot/regression, Tier B) before trusting the answers.
# LLM_MODEL=qwen/qwen3.8-27b
# Batch runs only (Chatbot/bot/batch_ask.py): several Groq keys, comma-separated. When one reaches its
# daily limit or is rejected, the run asks that question again with the next. The live bot uses only
# GROQ_API_KEY.
# GROQ_API_KEYS=key1,key2,key3

# Kept for the record, read by no code since 2026-10-26: the keys of the 2026-10-20..23 LLM comparison
# (Chatbot/bot/batch_runs/llm-comparison), a Google AI Studio key for Gemma (https://aistudio.google.com,
# "Get API key") and a Cloudflare Workers AI token with the account id for Llama (Cloudflare dashboard,
# AI > Workers AI, "Use REST API").
# GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2              (optional: more keys, each from its own Google project)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCOUNTS=id1:token1,id2:token2   (optional: more Cloudflare accounts, <account id>:<token>)
